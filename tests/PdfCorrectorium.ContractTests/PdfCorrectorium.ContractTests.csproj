<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfCorrectorium.Core\PdfCorrectorium.Core.csproj" />
    <ProjectReference Include="..\..\src\PdfCorrectorium.ProjectFormat\PdfCorrectorium.ProjectFormat.csproj" />
    <ProjectReference Include="..\..\src\PdfCorrectorium.Infrastructure\PdfCorrectorium.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    This project is a dependency-free contract runner rather than an adapter-based
    unit-test assembly. Make the standard `dotnet test` entry point execute it so
    CI cannot report success after discovering zero tests.
  -->
  <Target Name="RunContractChecksForDotNetTest" AfterTargets="VSTest">
    <Exec Command="dotnet &quot;$(TargetPath)&quot;" />
  </Target>

</Project>
