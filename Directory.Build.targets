<Project>
  <!-- Runs for solution builds, IDE builds and publish, not just the portable script. -->
  <Target Name="ValidateRepositoryVersion" BeforeTargets="GenerateAssemblyInfo;CoreCompile">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)Directory.Build.props" Query="/Project/PropertyGroup/ApplicationVersionPrefix/text()">
      <Output TaskParameter="Result" PropertyName="_RecordedApplicationVersionPrefix" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)Directory.Build.props" Query="/Project/PropertyGroup/DevelopmentRevision/text()">
      <Output TaskParameter="Result" PropertyName="_RecordedDevelopmentRevision" />
    </XmlPeek>
    <Error Condition="'$(ApplicationVersionPrefix)' != '$(_RecordedApplicationVersionPrefix)' Or '$(DevelopmentRevision)' != '$(_RecordedDevelopmentRevision)'"
           Text="Version inputs must be updated in Directory.Build.props, not overridden per project or command line." />
    <PropertyGroup>
      <_ExpectedApplicationVersion>$(ApplicationVersionPrefix)-dev.$(DevelopmentRevision)</_ExpectedApplicationVersion>
      <_ExpectedNumericVersion>$(ApplicationVersionPrefix).$(DevelopmentRevision)</_ExpectedNumericVersion>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ApplicationVersionPrefix)', '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'))"
           Text="ApplicationVersionPrefix must contain three numeric components in Directory.Build.props." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DevelopmentRevision)', '^[1-9][0-9]{0,4}$'))"
           Text="DevelopmentRevision must be an integer from 1 to 65534 in Directory.Build.props." />
    <Error Condition="'$(DevelopmentRevision)' &gt; '65534'"
           Text="DevelopmentRevision exceeds the Windows assembly-version limit (65534)." />
    <Error Condition="'$(Version)' != '$(_ExpectedApplicationVersion)' Or '$(AssemblyVersion)' != '$(_ExpectedNumericVersion)' Or '$(FileVersion)' != '$(_ExpectedNumericVersion)'"
           Text="Version, AssemblyVersion and FileVersion must derive from Directory.Build.props; do not override them per project or command line." />
    <!-- The SDK can append the source commit after '+'. The release label must still match. -->
    <Error Condition="'$(InformationalVersion)' != '$(_ExpectedApplicationVersion)' And !$([System.String]::Copy('$(InformationalVersion)').StartsWith('$(_ExpectedApplicationVersion)+'))"
           Text="InformationalVersion does not match the repository development revision." />
  </Target>
</Project>
