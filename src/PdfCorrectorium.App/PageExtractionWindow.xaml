<Window x:Class="PdfCorrectorium.App.PageExtractionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ページを抽出" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="現在の編集内容を反映したPDFから、指定ページだけを別ファイルへ保存します。"
                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Label Content="ページ候補(_P)" Target="{Binding ElementName=PresetBox}"/>
            <ComboBox x:Name="PresetBox" Grid.Column="1" SelectionChanged="PresetBox_OnSelectionChanged"
                      AutomationProperties.AccessKey="Alt+P">
                <ComboBoxItem Content="すべてのページ" Tag="All"/>
                <ComboBoxItem Content="現在のページ" Tag="Current"/>
                <ComboBoxItem Content="選択中のページ" Tag="Selected"/>
                <ComboBoxItem Content="奇数ページ" Tag="Odd"/>
                <ComboBoxItem Content="偶数ページ" Tag="Even"/>
                <ComboBoxItem Content="指定範囲" Tag="Custom"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="ページ範囲(_R)" Target="{Binding ElementName=RangeBox}"/>
                <TextBlock Text="例: 1-5, 8, 12-14" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,-4,0,0"/>
            </StackPanel>
            <TextBox x:Name="RangeBox" Grid.Column="1" AutomationProperties.AccessKey="Alt+R"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="キャンセル" IsCancel="True" MinWidth="104"/>
            <Button Content="保存先へ進む(_N)" IsDefault="True" MinWidth="120" Margin="8,0,0,0" Click="Apply_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
