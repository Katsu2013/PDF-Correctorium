<Window x:Class="PdfCorrectorium.App.OcrLexiconWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:icons="clr-namespace:PdfCorrectorium.App.Resources" xmlns:services="clr-namespace:PdfCorrectorium.App.Services"
 Title="資料のOCR辞書" Width="880" Height="600" MinWidth="620" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock x:Name="ValidationText" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
   <StackPanel x:Name="DialogFooter" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="キャンセル" IsCancel="True" MinWidth="90"/>
    <Button x:Name="SaveDictionaryButton" Content="保存(_S)" IsDefault="True" Click="Save_OnClick" MinWidth="90" Margin="8,0,0,0"/>
   </StackPanel>
  </StackPanel>
  <TextBlock DockPanel.Dock="Top" Text="この資料だけに保存します。頻出語は正解語ではありません。自動適用は許可した同じ文字数の明示ルールだけです。" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <TabControl>
   <TabItem Header="正解語(_K)"><DockPanel Margin="8">
    <TextBlock DockPanel.Dock="Top" Text="1行に1語（英数字の用語・登録した日本語語句、2～64文字）" Margin="0,0,0,6"/>
    <TextBox x:Name="KnownTermsEditor" AcceptsReturn="True" FontSize="16" MaxLength="514000" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="正解語"/>
   </DockPanel></TabItem>
   <TabItem Header="訂正ルール(_R)"><DockPanel Margin="8">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
     <Button Content="追加(_A)" icons:ActionIcon.Key="AddOcrRegion" Click="AddRule_OnClick" Margin="0,0,6,0"/>
     <Button Content="削除(_D)" icons:ActionIcon.Key="Delete" Click="DeleteRule_OnClick"/>
    </WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="自動を許可しても、無視語・固定中・文字数の相違・競合・循環のあるルールは自動適用しません。再OCR以外で勝手に置換することはありません。" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" services:ListDetails.EnableColumnMenu="True">
     <DataGrid.Columns>
      <DataGridCheckBoxColumn Header="有効" Binding="{Binding Enabled}" Width="60"/>
      <DataGridTextColumn Header="誤り" Binding="{Binding Source}" Width="*"/>
      <DataGridTextColumn Header="正解" Binding="{Binding Target}" Width="*"/>
      <DataGridCheckBoxColumn Header="自動を許可" Binding="{Binding AllowAutomatic}" Width="110"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="無視語(_I)"><DockPanel Margin="8">
    <TextBlock DockPanel.Dock="Top" Text="1行に1語。これらの語は訂正候補・自動適用から除外します。" Margin="0,0,0,6"/>
    <TextBox x:Name="IgnoredTermsEditor" AcceptsReturn="True" FontSize="16" MaxLength="514000" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="無視語"/>
   </DockPanel></TabItem>
   <TabItem Header="頻出語（参照）(_F)"><DockPanel Margin="8">
    <TextBlock x:Name="FrequencyStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <DataGrid x:Name="FrequencyGrid" AutoGenerateColumns="False" IsReadOnly="True" services:ListDetails.EnableColumnMenu="True">
     <DataGrid.Columns><DataGridTextColumn Header="語" Binding="{Binding Word}" Width="*"/>
      <DataGridTextColumn Header="出現数" Binding="{Binding Count}" Width="100"/></DataGrid.Columns>
    </DataGrid>
   </DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
