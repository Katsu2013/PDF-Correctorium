<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <TargetPlatformDisplayName>Windows</TargetPlatformDisplayName>
    <TargetPlatformSdkPath>$(MSBuildProgramFiles32)\Windows Kits\10\</TargetPlatformSdkPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- AvalonDock's Japanese UI resources are sufficient; other languages fall back
         to the package's neutral resources instead of creating 16 satellite folders. -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PdfCorrectorium</AssemblyName>
    <RootNamespace>PdfCorrectorium.App</RootNamespace>
    <Product>PDF Correctorium</Product>
    <Title>PDF Correctorium</Title>
    <ApplicationIcon>Resources\Branding\PdfCorrectorium.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The official qpdf archive already carries the licensed MSVC runtime.
         ONNX/Skia/PDFium also need these beside their root native binaries on a
         clean Windows installation. Keep the original tool-local copies too. -->
    <Content Include="..\..\tools\qpdf\bin\msvcp*.dll;..\..\tools\qpdf\bin\vcruntime*.dll;..\..\tools\qpdf\bin\concrt*.dll"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\DotNet\**\*"
             Link="licenses\DotNet\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\PdfCorrectorium.Core\PdfCorrectorium.Core.csproj" />
    <ProjectReference Include="..\PdfCorrectorium.ProjectFormat\PdfCorrectorium.ProjectFormat.csproj" />
    <ProjectReference Include="..\PdfCorrectorium.Infrastructure\PdfCorrectorium.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8125" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <!-- Recognition only: no default Latin detector/classifier/model copies. -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" ExcludeAssets="build;buildTransitive;contentFiles" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\licenses\WindowsSDK\**\*" Link="licenses\WindowsSDK\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Windows 11 の WM_POINTER 入力経路を起動時から有効にし、スリープ復帰や
      ペン／タッチ機器の再検出時に旧式 PenIMC.dll へ戻らないようにします。
    -->
    <RuntimeHostConfigurationOption
      Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport"
      Value="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The application icon is embedded for the executable and all WPF windows. -->
    <Resource Include="Resources\Branding\PdfCorrectorium.ico" />
    <Resource Include="Resources\Branding\PdfCorrectorium-*.png" />
    <Resource Include="Resources\Branding\FileTypes\*.png" />
    <Resource Include="Resources\Branding\Variants\*.png" />
    <Resource Include="Resources\Branding\Modes\*.png" />
    <!-- File-type icons are copied beside the portable application for file association and installer use. -->
    <Content Include="Resources\Branding\FileTypes\*.ico"
             Link="Icons\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <None Update="portable.marker" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\RapidOCR\*" Link="components\rapidocr\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\RapidOCR\**\*" Link="licenses\RapidOCR\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\AvalonDock\LICENSE"
             Link="licenses\AvalonDock\LICENSE"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\PDFium\**\*" Link="licenses\PDFium\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\MaterialSymbols\LICENSE"
             Link="licenses\MaterialSymbols\LICENSE"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\MaterialSymbols\NOTICE.md"
             Link="licenses\MaterialSymbols\NOTICE.md"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\NotoSansJP.ttf"
             Link="components\fonts\NotoSansJP.ttf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\OFL.txt"
             Link="licenses\NotoSansJP\OFL.txt"
             CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\qpdf\bin\**\*"
          Link="components\qpdf\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\tools\qpdf\bin\qpdf.exe')" />
    <None Include="..\..\tools\qpdf\licenses\**\*"
          Link="licenses\qpdf\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\tools\qpdf\licenses')" />
  </ItemGroup>

  <!-- The portable build pins the .NET runtime globally. The Windows projection is
       a separate framework pack and must retain its own independently pinned version. -->
  <Target Name="PinWindowsSdkProjectionVersion" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <FrameworkReference Include="Microsoft.Windows.SDK.NET.Ref" RuntimeFrameworkVersion="$(WindowsSdkPackageVersion)"
                          IsImplicitlyDefined="true" Pack="false" PrivateAssets="All" />
    </ItemGroup>
  </Target>

  <Target Name="FilterOcrNativeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_UnusedOcrNative Include="@(RuntimeTargetsCopyLocalItems)"
        Condition="('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime' Or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('SkiaSharp.'))) And (!$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.DestinationSubPath)').StartsWith('runtimes\win-x64\')) Or '%(RuntimeTargetsCopyLocalItems.Extension)' != '.dll')" />
      <RuntimeTargetsCopyLocalItems Remove="@(_UnusedOcrNative)" />
    </ItemGroup>
  </Target>

  <Target Name="PrepareVersionedApplicationManifest"
          BeforeTargets="_SetEmbeddedWin32ManifestProperties;_SetExternalWin32ManifestProperties"
          DependsOnTargets="ValidateRepositoryVersion">
    <PropertyGroup>
      <ApplicationManifest>$(IntermediateOutputPath)versioned.app.manifest</ApplicationManifest>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/app.manifest" DestinationFiles="$(ApplicationManifest)" />
    <XmlPoke XmlInputPath="$(ApplicationManifest)"
             Query="/*[local-name()='assembly']/*[local-name()='assemblyIdentity']/@version"
             Value="$(FileVersion)" />
    <ItemGroup><FileWrites Include="$(ApplicationManifest)" /></ItemGroup>
  </Target>
</Project>
