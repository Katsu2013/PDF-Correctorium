<Window x:Class="PdfCorrectorium.App.ProjectCommentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="コメントとタグ" Width="760" Height="560" MinWidth="650" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="現在の選択対象に付けるコメントを編集します。タグ名はカンマ区切りで指定できます。" TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="新規(_N)" Click="New_OnClick" MinWidth="88" />
                    <Button Content="削除(_D)" Click="Delete_OnClick" MinWidth="88" Margin="6,0,0,0" />
                </StackPanel>
                <Label Content="この対象のコメント(_C)" Target="{Binding ElementName=CommentList}" Padding="0,0,0,4" />
                <ListBox x:Name="CommentList" SelectionChanged="CommentList_OnSelectionChanged" AutomationProperties.AccessKey="Alt+C">
                    <ListBox.ItemTemplate>
                        <DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Body}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UpdatedAtUtc}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Label Content="コメント本文(_B)" Target="{Binding ElementName=BodyBox}" Padding="0,0,0,4" />
                <TextBox x:Name="BodyBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Editor_OnChanged" AutomationProperties.AccessKey="Alt+B" />
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Label Content="重要度(_I)" Target="{Binding ElementName=ImportanceBox}" />
                    <ComboBox x:Name="ImportanceBox" Grid.Column="1" SelectionChanged="Editor_OnChanged" AutomationProperties.AccessKey="Alt+I">
                        <ComboBoxItem Content="なし" Tag="None"/><ComboBoxItem Content="低" Tag="Low"/><ComboBoxItem Content="標準" Tag="Normal"/><ComboBoxItem Content="高" Tag="High"/><ComboBoxItem Content="最重要" Tag="Critical"/>
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Label Content="タグ(_T)" Target="{Binding ElementName=TagsBox}" />
                    <TextBox x:Name="TagsBox" Grid.Column="1" ToolTip="例: 要確認, 固有名詞" TextChanged="Editor_OnChanged" AutomationProperties.AccessKey="Alt+T" />
                </Grid>
                <CheckBox x:Name="ResolvedBox" Grid.Row="4" Content="解決済みにする(_R)" Margin="124,10,0,0" Checked="Editor_OnChanged" Unchecked="Editor_OnChanged" />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" IsCancel="True" MinWidth="104" />
            <Button Content="適用(_A)" IsDefault="True" MinWidth="104" Margin="8,0,0,0" Click="Apply_OnClick" />
        </StackPanel>
    </Grid>
</Window>
