<Window x:Class="PdfCorrectorium.App.InternalLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ページリンク" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="選択中の文字領域をクリックしたときの移動先を設定します。出力PDFにも内部リンクとして保存されます。"
                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Label Content="移動先ページ(_P)" Target="{Binding ElementName=PageNumberBox}" />
            <TextBox x:Name="PageNumberBox" Grid.Column="1" Text="{Binding DestinationPageNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AccessKey="Alt+P" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,7,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="表示倍率(_Z)" Target="{Binding ElementName=ZoomBox}" />
                <TextBlock Text="空欄は現在値を維持" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,-5,0,0" />
            </StackPanel>
            <TextBox x:Name="ZoomBox" Grid.Column="1" Text="{Binding ZoomText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AccessKey="Alt+Z" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,7,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Label Content="説明(_D)" Target="{Binding ElementName=DescriptionBox}" />
            <TextBox x:Name="DescriptionBox" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AccessKey="Alt+D" />
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" IsCancel="True" MinWidth="104" />
            <Button Content="適用(_A)" IsDefault="True" MinWidth="104" Margin="8,0,0,0" Click="Apply_OnClick" />
        </StackPanel>
    </Grid>
</Window>
