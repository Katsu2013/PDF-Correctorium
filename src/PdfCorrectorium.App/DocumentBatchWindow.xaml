<Window xmlns:icons="clr-namespace:PdfCorrectorium.App.Resources" x:Class="PdfCorrectorium.App.DocumentBatchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1100" Height="760" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 KeyboardNavigation.TabNavigation="Cycle">
 <DockPanel Margin="14" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <StackPanel DockPanel.Dock="Top" x:Name="Inputs">
   <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Label Content="対象ページ(_P)" Target="{Binding ElementName=PagesBox}" VerticalAlignment="Center"/>
    <TextBox x:Name="PagesBox" Grid.Column="1" ToolTip="例：1-3, 8, 10-12（PDFのページ番号）" TextChanged="Input_OnChanged"/>
<Button icons:ActionIcon.Key="Search" x:Name="SearchButton" Grid.Column="2" Content="候補を作成(_C)" Click="Search_OnClick" Margin="8,0,0,0"/>
   </Grid>
   <StackPanel x:Name="LinkInputs" Orientation="Horizontal" Margin="0,8,0,0">
    <Label Content="PDFページ番号 − 印刷ページ番号(_O)" Target="{Binding ElementName=OffsetBox}"/>
    <TextBox x:Name="OffsetBox" Width="90" Text="0" TextChanged="Input_OnChanged" ToolTip="印刷の1ページがPDFの5ページなら、4を指定します。"/>
   </StackPanel>
   <StackPanel x:Name="TextInputs" Orientation="Horizontal" Margin="0,8,0,0">
    <Label Content="検索する文字列(_T)" Target="{Binding ElementName=SearchTextBox}"/>
    <TextBox x:Name="SearchTextBox" Width="300" TextChanged="Input_OnChanged"/>
    <CheckBox x:Name="MatchCase" Content="大文字・小文字を区別(_M)" Margin="12,0,0,0" VerticalAlignment="Center" Checked="Input_OnChanged" Unchecked="Input_OnChanged"/>
    <CheckBox x:Name="UseRegularExpression" Content="正規表現(_R)" Margin="12,0,0,0" VerticalAlignment="Center"
              ToolTip="一致した文字だけを候補にします。例：数字の連続は [0-9]+。結果は適用前に確認してください。"
              Checked="Input_OnChanged" Unchecked="Input_OnChanged"/>
   </StackPanel>
  </StackPanel>
  <StackPanel x:Name="DialogFooter" DockPanel.Dock="Bottom" Margin="0,10,0,0">
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <DockPanel>
    <Button x:Name="StopButton" Content="処理を中止(_S)" Click="Stop_OnClick" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="キャンセル" IsCancel="True" MinWidth="95"/>
     <Button x:Name="ApplyButton" Content="選択した候補を適用(_A)" Click="Apply_OnClick" IsEnabled="False" Margin="8,0,0,0" MinWidth="160"/>
    </StackPanel>
   </DockPanel>
  </StackPanel>
  <Grid Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
<Button icons:ActionIcon.Key="SelectAll" Content="適用可能な候補をすべて選択(_L)" Click="SelectAll_OnClick"/>
<Button icons:ActionIcon.Key="Deselect" Content="すべて解除(_U)" Click="UnselectAll_OnClick" Margin="8,0,0,0"/>
    </StackPanel>
    <DataGrid x:Name="CandidateGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
     SelectionMode="Single" SelectionChanged="Candidate_OnSelected" EnableRowVirtualization="True" EnableColumnVirtualization="True">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="適用" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInclude}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn x:Name="CandidatePageColumn" Header="元ページ" Binding="{Binding PageNumber}" IsReadOnly="True" Width="70"/>
      <DataGridTextColumn x:Name="DestinationColumn" Header="移動先" Binding="{Binding DestinationSummary}" IsReadOnly="True" Width="80"/>
      <DataGridTextColumn Header="文字・内容" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
      <DataGridTextColumn Header="注意" Binding="{Binding Status}" IsReadOnly="True" Width="180"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
   <DockPanel Grid.Column="2">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
     <Button icons:ActionIcon.Key="NextPage" x:Name="DestinationButton" Content="リンク先を確認(_G)" Click="Destination_OnClick" DockPanel.Dock="Right" IsEnabled="False"/>
     <TextBlock x:Name="PreviewTitle" Text="候補を選択してプレビュー" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <Border Background="#343D47" Padding="4"><Viewbox Stretch="Uniform"><Grid x:Name="PreviewSurface">
     <Image x:Name="PreviewImage" Stretch="Fill"/>
     <Canvas x:Name="PreviewMarkers" IsHitTestVisible="False"/>
    </Grid></Viewbox></Border>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
