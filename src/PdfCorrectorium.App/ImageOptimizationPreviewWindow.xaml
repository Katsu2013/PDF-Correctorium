<Window x:Class="PdfCorrectorium.App.ImageOptimizationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ページ画像の最適化プレビュー"
        Width="1080"
        Height="760"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="#F3F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="12" Background="#374151"
                BorderBrush="#CBD3DA" BorderThickness="1">
            <Grid x:Name="PreviewHost" ClipToBounds="True" SizeChanged="PreviewHost_OnSizeChanged">
                <Image x:Name="PageImage" Stretch="Uniform" SnapsToDevicePixels="True" />
                <Canvas x:Name="OverlayCanvas" Background="Transparent" />
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Margin="0,12,12,12" Padding="16" Background="White"
                BorderBrush="#CBD3DA" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="最適化内容" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSummaryText" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="SavingsText" Margin="0,8,0,0" FontSize="15"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Border x:Name="LowSavingsNotice" Margin="0,12,0,0" Padding="10"
                            Background="#FFF7D6" BorderBrush="#E5B700" BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock Text="削減見込みは15%未満です。それでも実行する場合は［この内容で実行］を選択してください。"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Separator Margin="0,16,0,12" />
                    <TextBlock Text="領域ごとの設定" FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0" Foreground="#52606D" TextWrapping="Wrap"
                               Text="プレビュー内の色付き領域をクリックすると、背景へ置換するか、元画像のまま保持するかを切り替えられます。保持領域は周辺の画像と可能な範囲で一枚にまとめます。" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Border Width="24" Height="16" Background="#52E53935" BorderBrush="#D32F2F" BorderThickness="1" />
                        <TextBlock Margin="7,0,12,0" Text="背景へ置換" />
                        <Border Width="24" Height="16" Background="#5239A96B" BorderBrush="#228B4E" BorderThickness="1" />
                        <TextBlock Margin="7,0,0,0" Text="元画像を保持" />
                    </StackPanel>
                    <TextBlock x:Name="SelectionSummaryText" Margin="0,9,0,0" FontWeight="SemiBold" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Padding="8,3" Margin="0,0,6,0" Click="ReplaceAllButton_OnClick" Content="すべて置換" />
                        <Button Padding="8,3" Click="KeepAllButton_OnClick" Content="すべて保持" />
                    </StackPanel>

                    <Separator Margin="0,16,0,12" />
                    <TextBlock Text="検出した背景" FontWeight="SemiBold" />
                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <Border x:Name="BackgroundColorSwatch" Width="30" Height="22"
                                BorderBrush="#667085" BorderThickness="1" />
                        <TextBlock x:Name="BackgroundColorText" Margin="8,2,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="DetectionModeText" Margin="0,7,0,0" Foreground="#52606D" TextWrapping="Wrap" />

                    <Separator Margin="0,16,0,12" />
                    <TextBlock Text="検出箇所" FontWeight="SemiBold" />
                    <ItemsControl x:Name="RegionList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2,0,0" Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" BorderBrush="#CBD3DA"
                BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="96" Margin="3,3,8,3" Padding="8,5" IsCancel="True" Content="キャンセル" />
                <Button Width="132" Padding="8,5" IsDefault="True" Click="ApplyButton_OnClick"
                        Content="この内容で実行" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
