<Window x:Class="PdfCorrectorium.App.DocumentImageOptimizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF全体の画像最適化"
        Width="980" Height="680" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:kb="clr-namespace:PdfCorrectorium.App.Services" KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="PDF全体の画像最適化候補" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="DocumentSummaryText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#455566" />
            <TextBlock x:Name="SelectionSummaryText" Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <Button Padding="10,4" Margin="0,0,6,0" Click="SelectAllButton_OnClick" Content="すべて選択(_A)" AutomationProperties.AccessKey="Alt+A"/>
            <Button Padding="10,4" Click="ClearAllButton_OnClick" Content="選択解除(_D)" AutomationProperties.AccessKey="Alt+D"/>
            <TextBlock Margin="14,5,0,0" Foreground="#52606D"
                       Text="空白だけの全面画像はページを残し、画像オブジェクトだけを削除します。" />
        </StackPanel>

        <DataGrid x:Name="CandidateGrid" Grid.Row="2" ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Extended" SelectionUnit="FullRow" kb:KeyboardAccess.Key="L" AutomationProperties.Name="CandidateGrid" AutomationProperties.AccessKey="Alt+L">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="対象" Width="54"
                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="ページ" Width="70" Binding="{Binding PageNumber}" IsReadOnly="True" />
                <DataGridTextColumn Header="処理内容" Width="180" Binding="{Binding ActionText}" IsReadOnly="True" />
                <DataGridTextColumn Header="現在" Width="105" Binding="{Binding OriginalSizeText}" IsReadOnly="True" />
                <DataGridTextColumn Header="見込み" Width="105" Binding="{Binding EstimatedSizeText}" IsReadOnly="True" />
                <DataGridTextColumn Header="削減" Width="80" Binding="{Binding ReductionText}" IsReadOnly="True" />
                <DataGridTextColumn Header="詳細" Width="*" Binding="{Binding Message}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#52606D" TextWrapping="Wrap"
                       Text="一括適用は選択したページをまとめて登録します。順に確認ではページ画像と削減範囲を1ページずつ確認できます。" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <Button Width="90" Margin="0,3,8,3" Padding="8,5" IsCancel="True" Content="キャンセル" />
                <Button Margin="0,3,8,3" Padding="8,5" Click="ReviewButton_OnClick" Content="選択ページを順に確認(_R)"  MinWidth="150" AutomationProperties.AccessKey="Alt+R"/>
                <Button Padding="8,5" IsDefault="True" Click="BatchButton_OnClick" Content="選択ページを一括適用(_P)"  MinWidth="150" AutomationProperties.AccessKey="Alt+P"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
