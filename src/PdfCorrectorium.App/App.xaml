<Application x:Class="PdfCorrectorium.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ベクターアイコンの形状は、画面定義から独立したファイルで一元管理する。 -->
                <ResourceDictionary Source="Resources/VectorIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Color x:Key="AccentColor">#1F5E8C</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="#F6F8FA" />
            <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE4" />
            <Style TargetType="Window">
                <!-- Keep the same brand icon on the main window and every auxiliary dialog. -->
                <Setter Property="Icon" Value="/PdfCorrectorium;component/Resources/Branding/PdfCorrectorium.ico" />
            </Style>
            <!--
              標準のWPFボタンはOSのクラシックなテーマテンプレートへ依存するため、
              ダイアログでも一貫したWindows 11風の平坦な外観になる共通テンプレートを使う。
            -->
            <Style x:Key="ModernButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#F7F9FB" />
                <Setter Property="BorderBrush" Value="#AEBBC8" />
                <Setter Property="Foreground" Value="#1E2935" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#EAF3FA" />
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#4D87B3" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#D9EAF6" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsDefaulted" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#8B98A3" />
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#EEF1F3" />
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#D4DADF" />
                                    <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
