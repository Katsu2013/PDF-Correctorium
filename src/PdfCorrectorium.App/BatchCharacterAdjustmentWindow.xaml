<Window x:Class="PdfCorrectorium.App.BatchCharacterAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="前処理付き一括自動調整" Width="680" Height="780"
        MinWidth="580" MinHeight="650" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="キャンセル" IsCancel="True" Width="100" Margin="3,3,8,3" />
            <Button x:Name="ExecuteButton" Content="対象ページを実行" IsDefault="True"
                    MinWidth="140" Padding="12,5" Click="ExecuteButton_OnClick" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="文字の一括自動調整" FontSize="18" FontWeight="SemiBold" />

            <GroupBox Header="対象ページ" Margin="0,12,0,14" Padding="12,8">
                <StackPanel>
                    <RadioButton x:Name="CurrentPageRadioButton" Content="現在のページ"
                                 Margin="0,3" GroupName="TargetPages"
                                 Checked="TargetMode_OnChanged" />
                    <RadioButton x:Name="SelectedPagesRadioButton" Content="ページ一覧で選択したページ"
                                 Margin="0,5,0,3" GroupName="TargetPages"
                                 Checked="TargetMode_OnChanged" />
                    <RadioButton x:Name="SpecifiedPagesRadioButton" Content="ページを指定"
                                 Margin="0,5,0,3" GroupName="TargetPages"
                                 Checked="TargetMode_OnChanged" />
                    <Grid Margin="22,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PageSpecificationTextBox" Grid.Column="0"
                                 MinWidth="260" Padding="5,3" IsEnabled="False"
                                 TextChanged="PageSpecificationTextBox_OnTextChanged"
                                 ToolTip="例: 1,3,5-10" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="#52606D" Text="例: 1,3,5-10" />
                    </Grid>
                    <RadioButton x:Name="AllPagesRadioButton" Content="全ページ"
                                 Margin="0,5,0,3" GroupName="TargetPages"
                                 Checked="TargetMode_OnChanged" />
                    <TextBlock x:Name="TargetSummaryTextBlock" Margin="0,9,0,0"
                               Foreground="#52606D" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <Border Background="#F4F7FA" BorderBrush="#D7DEE7" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="前処理（必要な項目だけ選択してください）"
                               FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox x:Name="NormalizeHeightCheckBox" IsChecked="True" Margin="0,4">
                        <TextBlock TextWrapping="Wrap"
                                   Text="上下2行以内で行の高さの誤差が10%未満なら、平均値へ統一する" />
                    </CheckBox>
                    <CheckBox x:Name="AddLineEdgeSafetyMarginCheckBox" IsChecked="True" Margin="0,8,0,4">
                        <TextBlock TextWrapping="Wrap"
                                   Text="すべての行の行頭・行末を、行の高さの5%分だけ外側へ広げて認識余白を確保する" />
                    </CheckBox>
                    <CheckBox x:Name="ExpandLeadingCheckBox" IsChecked="True" Margin="0,8,0,4">
                        <TextBlock TextWrapping="Wrap"
                                   Text="行頭が開き鍵括弧（「『）なら、行の高さの50%分を行頭側へ広げる" />
                    </CheckBox>
                    <CheckBox x:Name="ExpandTrailingCheckBox" IsChecked="True" Margin="0,8,0,4">
                        <TextBlock TextWrapping="Wrap"
                                   Text="行末が句読点または閉じ鍵括弧（、。,.!?」』など）なら、行の高さの50%分を行末側へ広げる" />
                    </CheckBox>
                    <CheckBox x:Name="ExpandNarrowEdgeCharactersCheckBox" IsChecked="True" Margin="0,8,0,4">
                        <TextBlock TextWrapping="Wrap"
                                   Text="行頭・行末が細長い文字（・、｜、I、L、：、；など）なら、行の高さの50%分を該当する行端側へ広げる" />
                    </CheckBox>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="処理順: 行の高さを統一 → 行頭・行末へ認識余白を追加 → 特定文字の行端を拡張 → ページ画像から全体の文字送りを自動調整" />
            <TextBlock Margin="0,7,0,0" Foreground="#52606D" TextWrapping="Wrap"
                       Text="固定済みの領域と文字は変更しません。すべての変更は1回の［元に戻す］で取り消せます。" />
            <TextBlock Margin="0,7,0,0" Foreground="#8A5A00" TextWrapping="Wrap"
                       Text="対象ページを画像解析するため、ページ数によっては時間がかかります。処理中は編集操作を一時停止します。" />
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
