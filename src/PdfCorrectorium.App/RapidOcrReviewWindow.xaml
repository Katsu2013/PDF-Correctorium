<Window x:Class="PdfCorrectorium.App.RapidOcrReviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:PdfCorrectorium.App.Services"
 xmlns:kb="clr-namespace:PdfCorrectorium.App.Services"
 xmlns:icons="clr-namespace:PdfCorrectorium.App.Resources"
 Title="選択行の再認識 — 確認" Width="900" SizeToContent="Height" MinWidth="600" MinHeight="340"
 ShowInTaskbar="False" WindowStartupLocation="CenterOwner" KeyboardNavigation.TabNavigation="Cycle">
 <DockPanel Margin="12">
  <StackPanel x:Name="DialogFooter" DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="変更せず閉じる" IsCancel="True" MinWidth="120"/>
    <Button x:Name="ApplyButton" Content="候補を適用(_A)" IsDefault="True" Click="Apply_OnClick" MinWidth="120" Margin="8,0,0,0"/>
   </StackPanel>
  </StackPanel>
  <ScrollViewer x:Name="ReviewBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
    <TextBlock Text="原画像" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <Button x:Name="ZoomOutButton" icons:ActionIcon.Key="ZoomOut" Style="{StaticResource IconOnlyActionButtonStyle}" Content="縮小(_O)" ToolTip="縮小" kb:KeyboardAccess.Key="O" Click="ZoomOut_OnClick" Margin="0,0,4,0"/>
    <Button x:Name="ZoomInButton" icons:ActionIcon.Key="ZoomIn" Style="{StaticResource IconOnlyActionButtonStyle}" Content="拡大(_I)" ToolTip="拡大" kb:KeyboardAccess.Key="I" Click="ZoomIn_OnClick" Margin="0,0,8,0"/>
    <TextBlock x:Name="ZoomText" MinWidth="50" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,8,0"/>
    <Button x:Name="FitImageButton" icons:ActionIcon.Key="FitPage" Style="{StaticResource IconOnlyActionButtonStyle}" Content="全体表示(_F)" ToolTip="全体表示" kb:KeyboardAccess.Key="F" Click="FitImage_OnClick" Margin="0,0,4,0"/>
    <Button x:Name="ActualSizeButton" icons:ActionIcon.Key="ActualSize" Style="{StaticResource IconOnlyActionButtonStyle}" Content="100%(_Z)" ToolTip="100%で表示" kb:KeyboardAccess.Key="Z" Click="ActualSize_OnClick"/>
   </WrapPanel>
   <Border x:Name="ImageFrame" Grid.Row="1" Height="88" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" Margin="0,0,0,8"
           SizeChanged="ImageFrame_OnSizeChanged">
     <ScrollViewer x:Name="ImageViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   ScrollChanged="ImageViewport_OnScrollChanged" PreviewMouseWheel="ImageViewport_OnMouseWheel"
                   ToolTip="Ctrl＋ホイールで拡大・縮小できます。">
      <Image x:Name="LineImage" Stretch="None" HorizontalAlignment="Left" AutomationProperties.Name="選択行の原画像"/>
     </ScrollViewer>
   </Border>
   <StackPanel Grid.Row="2">
    <TextBlock Text="現在の文字" Margin="0,0,0,4"/>
    <ScrollViewer MaxHeight="54" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
     <TextBlock x:Name="CurrentText" FontSize="18" services:WordDifference.MaximumTextElements="512" TextWrapping="Wrap"/>
    </ScrollViewer>
    <DockPanel Margin="0,0,0,4">
     <Button x:Name="RestoreCandidateButton" DockPanel.Dock="Right" icons:ActionIcon.Key="Reset" Content="認識結果に戻す(_R)" Click="RestoreCandidate_OnClick"/>
     <Label Content="修正して適用する文字(_T)" Target="{Binding ElementName=CandidateEditor}" Padding="0" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBox x:Name="CandidateEditor" FontSize="18" MinHeight="34" MaxHeight="76" TextWrapping="Wrap" VerticalContentAlignment="Top"
             VerticalScrollBarVisibility="Auto" AcceptsReturn="False" TextChanged="CandidateEditor_OnTextChanged"
             DataObject.Pasting="CandidateEditor_OnPaste"
             PreviewKeyDown="CandidateEditor_OnPreviewKeyDown" AutomationProperties.Name="修正して適用する文字"/>
    <ListBox x:Name="DictionaryCandidates" MaxHeight="84" Margin="0,6,0,0" Visibility="Collapsed" SelectionChanged="DictionaryCandidates_OnSelectionChanged" AutomationProperties.Name="辞書の修正候補">
     <ListBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap"><Run Text="{Binding Source, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding Target, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Reason, Mode=OneWay}"/></TextBlock></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Margin="0,6,0,0">
     <CheckBox x:Name="RegisterKnownCheck" Content="修正語を正解語に登録" Margin="0,0,12,0"/>
     <CheckBox x:Name="RegisterRuleCheck" Content="修正した誤り→正解を登録"/>
    </WrapPanel>
    <TextBlock Text="差分プレビュー（異なる部分を赤く表示）" Margin="0,6,0,4"/>
    <ScrollViewer MaxHeight="54" VerticalScrollBarVisibility="Auto">
     <TextBlock x:Name="CandidateText" FontSize="18" services:WordDifference.MaximumTextElements="512" TextWrapping="Wrap"/>
    </ScrollViewer>
   </StackPanel>
  </Grid>
  </ScrollViewer>
 </DockPanel>
</Window>
