                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Grid Width="24" Height="24">
                                    <Path Data="{StaticResource IconGeometry.OpenFolderBack}"
                                          Fill="Transparent"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round">
                                        <Path.Stroke>
                                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
                                        </Path.Stroke>
                                    </Path>
                                    <Path Data="{StaticResource IconGeometry.OpenPdfBadge}" Fill="#D32F2F" Stroke="#D32F2F" StrokeThickness="1" StrokeLineJoin="Round" />
                                    <Path Data="{StaticResource IconGeometry.OpenPdfBadgeFold}" Fill="Transparent" Stroke="White" StrokeThickness="1.15" StrokeLineJoin="Round" />
                                    <Path Data="{StaticResource IconGeometry.OpenPdfBadgeLines}" Fill="Transparent" Stroke="White" StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="{StaticResource IconGeometry.OpenFolderFront}"
                                          Fill="White"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round">
                                        <Path.Stroke>
                                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
                                        </Path.Stroke>
                                    </Path>
                                </Grid>
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="PDFを開く" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenProjectCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="プロジェクトを開く">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Grid Width="24" Height="24">
                                    <Path Data="{StaticResource IconGeometry.OpenFolderBack}"
                                          Fill="Transparent"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round">
                                        <Path.Stroke>
                                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
                                        </Path.Stroke>
                                    </Path>
                                    <Path Data="{StaticResource IconGeometry.OpenProjectBadge}" Fill="#D32F2F" Stroke="#D32F2F" StrokeThickness="1" StrokeLineJoin="Round" />
                                    <Path Data="{StaticResource IconGeometry.OpenProjectBadgeSelection}" Fill="Transparent" Stroke="White" StrokeThickness="1" />
                                    <Rectangle Width="1.8" Height="1.8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13.1,3.1,0,0" />
                                    <Rectangle Width="1.8" Height="1.8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="19.1,3.1,0,0" />
                                    <Rectangle Width="1.8" Height="1.8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13.1,10.1,0,0" />
                                    <Rectangle Width="1.8" Height="1.8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="19.1,10.1,0,0" />
                                    <Path Data="{StaticResource IconGeometry.OpenFolderFront}"
                                          Fill="White"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round">
                                        <Path.Stroke>
                                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
                                        </Path.Stroke>
                                    </Path>
                                </Grid>
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="プロジェクトを開く" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveProjectCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="プロジェクトを上書き保存 (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Path StrokeThickness="1.8" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.SaveProject}" Fill="#263746">
                                    <Path.Stroke>
                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
                                    </Path.Stroke>
                                </Path>
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="上書き保存" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportPdfCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="編集済みPDFを別名で出力">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Path Fill="#FFC83B3B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.ExportPdf}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="PDF出力" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ImportOcrDataCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="OCRデータを読み込む">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Path Fill="#FF131313" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.ImportOcr}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="OCR読込" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="4,0" />
                    <ToggleButton IsChecked="{Binding IsOcrOverlayVisible}" IsEnabled="{Binding CanUsePreview}" Style="{StaticResource ToolbarIconToggleStyle}" ToolTip="OCRを表示／非表示">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Path Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.OcrVisibility}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="OCR表示" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsAddOcrRegionMode, Mode=TwoWay}"
                              IsEnabled="{Binding CanAddOcrRegion}"
                              Style="{StaticResource ToolbarIconToggleStyle}"
                              ToolTip="透明テキスト領域を追加。オンにしてページ上をドラッグします。">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.AddOcrRegion}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="領域追加" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Command="{Binding DeleteOcrRegionsCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}"
                        ToolTip="選択した透明テキスト領域を削除 (Delete)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Delete}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="削除" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="OcrEditToolbarButton" Command="{Binding ActivateOcrEditModeCommand}"
                                  IsChecked="{Binding IsOcrEditMode, Mode=OneWay}"
                                  Style="{StaticResource ToolbarIconToggleStyle}"
                                  ToolTip="OCR編集モードへ切り替え (Alt+Mからも選択可能)"
                                  AutomationProperties.Name="OCR編集モード">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="14" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" BorderThickness="1.5" CornerRadius="1" Margin="2">
                                <TextBlock Text="T" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="OCR編集" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="RedactionToolbarButton" Command="{Binding ActivateRedactionModeCommand}"
                                  IsChecked="{Binding IsRedactionMode, Mode=OneWay}"
                                  Style="{StaticResource ToolbarIconToggleStyle}"
                                  ToolTip="墨消しモードへ切り替え。ページ上をドラッグして範囲を指定 (Alt+E, D, M)"
                                  AutomationProperties.Name="墨消しモード">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="11" Background="#263746" CornerRadius="1" Margin="2" />
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="墨消し" />
                        </StackPanel>
                    </ToggleButton>
                    <Separator Margin="4,0" />
                    <Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="前のページ">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PreviousPage}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="前へ" />
                        </StackPanel>
                    </Button>
                    <!-- Smoke tests and accessibility automation continue to read the full summary from this element. -->
                    <TextBlock x:Name="ToolbarPageSummary" Text="{Binding PageSummary}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0">
                        <TextBox x:Name="ToolbarPageNumberBox"
                                 IsEnabled="{Binding HasDocument}"
                                 Width="48"
                                 MinHeight="25"
                                 Padding="4,1"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SelectedPage.PageNumber, Mode=OneWay}"
                                 ToolTip="ページ番号を入力して Enter で移動"
                                 AutomationProperties.Name="現在のページ番号"
                                 GotKeyboardFocus="ToolbarPageNumberBox_OnGotKeyboardFocus"
                                 PreviewKeyDown="ToolbarPageNumberBox_OnPreviewKeyDown"
                                 LostKeyboardFocus="ToolbarPageNumberBox_OnLostKeyboardFocus" kb:KeyboardAccess.Key="J" AutomationProperties.AccessKey="Alt+J"/>
                        <TextBlock Text=" / " VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageItems.Count}" MinWidth="24" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="次のページ">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.NextPage}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="次へ" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="4,0" />
                    <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="縮小">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.ZoomOut}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="縮小" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ZoomInCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="拡大">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.ZoomIn}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="拡大" />
                        </StackPanel>
                    </Button>
                    <Button Click="FitWidthButton_OnClick" IsEnabled="{Binding CanUsePreview}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="ページ幅に合わせる">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.FitWidth}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="幅に合わせる" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ActualSizeCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="実際のサイズ（100%）で表示" AutomationProperties.Name="100%で表示">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.ActualSize}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="100%" />
                        </StackPanel>
                    </Button>
                    <Button Click="FitHeightButton_OnClick" IsEnabled="{Binding CanUsePreview}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="ページ高さに合わせる（上下ぴったり）">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.FitHeight}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="高さに合わせる" />
                        </StackPanel>
                    </Button>
                    <Button Click="FitPageButton_OnClick" IsEnabled="{Binding CanUsePreview}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="ページ全体を表示">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.7" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.FitPage}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="ページ全体" />
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="DocumentViewModeSelector"
                              IsEnabled="{Binding HasDocument}"
                              Width="112" Margin="3,1"
                              ItemsSource="{Binding DocumentViewModeOptions}"
                              SelectedItem="{Binding SelectedDocumentViewModeOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource RoundedToolbarComboBoxStyle}"
                              ToolTip="{Binding DocumentViewModeDescription}"
                              kb:KeyboardAccess.Key="N"
                              AutomationProperties.Name="ページ表示モード"
                              AutomationProperties.AccessKey="Alt+N" />
                    <ComboBox x:Name="DocumentPageFlowModeSelector"
                              IsEnabled="{Binding HasDocument}"
                              Width="124" Margin="3,1"
                              ItemsSource="{Binding DocumentPageFlowModeOptions}"
                              SelectedItem="{Binding SelectedDocumentPageFlowModeOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource RoundedToolbarComboBoxStyle}"
                              ToolTip="ページ切り替え／連続スクロール"
                              kb:KeyboardAccess.Key="2"
                              AutomationProperties.Name="スクロール方式"
                              AutomationProperties.AccessKey="Alt+2" />
                    <Separator Margin="4,0" />
                    <ComboBox x:Name="EditUnitSelector" IsEnabled="{Binding CanUseOcrEditControls}" Width="110" Margin="3,1" SelectedIndex="{Binding EditUnitIndex, Mode=TwoWay}" ToolTip="OCR編集モードの編集単位" Style="{StaticResource RoundedToolbarComboBoxStyle}" kb:KeyboardAccess.Key="U" AutomationProperties.Name="OCRの編集単位" AutomationProperties.AccessKey="Alt+U">
                        <ComboBoxItem Content="行編集" />
                        <ComboBoxItem Content="段落編集" />
                        <ComboBoxItem Content="文字編集" />
                    </ComboBox>
                    <ComboBox x:Name="EditorModeSelector" IsEnabled="{Binding CanUsePreview}" Width="150" Margin="4,1" SelectedIndex="{Binding EditorModeIndex, Mode=TwoWay}" Style="{StaticResource BrandModeComboBoxStyle}" ToolTip="プレビュー上の操作モードを切り替えます" kb:KeyboardAccess.Key="M" AutomationProperties.Name="編集モード" AutomationProperties.AccessKey="Alt+M">
                        <ComboBoxItem Content="OCR編集" />
                        <ComboBoxItem Content="読み順編集" />
                        <ComboBoxItem Content="校正・確認" />
                        <ComboBoxItem Content="墨消し" />
                    </ComboBox>
                    <Separator Margin="4,0" />
                    <Button Command="{Binding ToggleRibbonUiModeCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="リボンUIへ切り替え">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ リボン表示" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </ToolBar>
            </ToolBarTray>
        </Border>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                   Visibility="{Binding ShowStatusBar, Converter={StaticResource BooleanToVisibilityConverter}}" KeyboardNavigation.TabIndex="9000" KeyboardNavigation.TabNavigation="Local">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <Separator DockPanel.Dock="Right" >
            </Separator>
            <StatusBarItem DockPanel.Dock="Right" IsEnabled="{Binding CanUsePreview}" ToolTip="表示倍率。－/＋、スライダー、または倍率表示から変更できます。" Padding="2,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StatusZoomOutButton" Command="{Binding ZoomOutCommand}" Style="{StaticResource FlatStatusBarButtonStyle}" ToolTip="縮小" AutomationProperties.Name="縮小">
                        <Viewbox Width="12" Height="12">
                            <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.Minus}" Height="24" Width="24" />
                        </Viewbox>
                    </Button>
                    <!-- 中央の位置50を100%とし、左右で倍率の変化量を変える。 -->
                    <Slider x:Name="StatusZoomSlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="False"
                            Style="{StaticResource CenteredZoomSliderStyle}" IsMoveToPointEnabled="True"
                            SmallChange="1" LargeChange="10"
                            Value="{Binding ZoomSliderPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{Binding ZoomDisplay}" AutomationProperties.Name="表示倍率"
                            AutomationProperties.HelpText="{Binding ZoomDisplay}"
                            Width="92" Margin="2,0" VerticalAlignment="Center">
                        <Slider.CommandBindings>
                            <CommandBinding Command="Slider.IncreaseSmall" Executed="StatusZoomSlider_OnChangeZoom" CanExecute="StatusZoomSlider_OnCanChangeZoom" />
                            <CommandBinding Command="Slider.DecreaseSmall" Executed="StatusZoomSlider_OnChangeZoom" CanExecute="StatusZoomSlider_OnCanChangeZoom" />
                            <CommandBinding Command="Slider.IncreaseLarge" Executed="StatusZoomSlider_OnChangeZoom" CanExecute="StatusZoomSlider_OnCanChangeZoom" />
                            <CommandBinding Command="Slider.DecreaseLarge" Executed="StatusZoomSlider_OnChangeZoom" CanExecute="StatusZoomSlider_OnCanChangeZoom" />
                        </Slider.CommandBindings>
                    </Slider>
                    <Button x:Name="StatusZoomInButton" Command="{Binding ZoomInCommand}" Style="{StaticResource FlatStatusBarButtonStyle}" ToolTip="拡大" AutomationProperties.Name="拡大">
                        <Viewbox Width="12" Height="12">
                            <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.Plus}" />
                        </Viewbox>
                    </Button>
                    <ComboBox x:Name="StatusZoomComboBox"
                              Text="{Binding ZoomDisplay, Mode=OneWay}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              Width="70" Height="20" MinHeight="20" Padding="6,0,24,0" Margin="2,0,0,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="StatusZoomComboBox_OnSelectionChanged"
                              PreviewKeyDown="StatusZoomComboBox_OnPreviewKeyDown"
                              LostKeyboardFocus="StatusZoomComboBox_OnLostKeyboardFocus"
                              ToolTip="倍率を入力するか、一覧から倍率・表示方法を選択します" kb:KeyboardAccess.Key="Z" AutomationProperties.Name="表示倍率" AutomationProperties.AccessKey="Alt+Z">
                        <ComboBoxItem Content="25%" Tag="25" />
                        <ComboBoxItem Content="50%" Tag="50" />
                        <ComboBoxItem Content="75%" Tag="75" />
                        <ComboBoxItem Content="100%" Tag="100" />
                        <ComboBoxItem Content="125%" Tag="125" />
                        <ComboBoxItem Content="150%" Tag="150" />
                        <ComboBoxItem Content="200%" Tag="200" />
                        <ComboBoxItem Content="300%" Tag="300" />
                        <ComboBoxItem Content="400%" Tag="400" />
                        <Separator />
                        <ComboBoxItem Content="ページ幅" Tag="FitWidth" />
                        <ComboBoxItem Content="ページ高さ" Tag="FitHeight" />
                        <ComboBoxItem Content="ページ全体" Tag="FitPage" />
                        <ComboBoxItem Content="選択範囲" Tag="FitSelection" />
                    </ComboBox>
                </StackPanel>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" >
            </Separator>
            <StatusBarItem x:Name="ProjectStorageModeStatusItem"
                           DockPanel.Dock="Right"
                           Content="{Binding ProjectStorageModeStatusText}"
                           Visibility="{Binding HasDocument, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Separator DockPanel.Dock="Right" >
            </Separator>
            <StatusBarItem DockPanel.Dock="Right"
                           Padding="4,0"
                           Visibility="{Binding IsBackgroundOperationVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="96" Height="8" Margin="0,0,5,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding BackgroundOperationProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsBackgroundOperationIndeterminate, Mode=OneWay}" />
                    <TextBlock Text="{Binding BackgroundOperationMessage, Mode=OneWay}"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"
                       Visibility="{Binding IsBackgroundOperationVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>

        <Grid x:Name="WorkspaceLayoutGrid" KeyboardNavigation.TabIndex="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding PageListColumnWidth}" />
                <ColumnDefinition Width="{Binding PageListSplitterWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding PropertiesPanelSplitterWidth}" />
                <ColumnDefinition Width="{Binding PropertiesPanelColumnWidth}" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                <TabControl x:Name="KeyboardNavigationTabs">
                    <TabItem Header="ページ(_L)" Padding="10,2,10,2" Margin="0,0,0,0" AutomationProperties.AccessKey="Alt+L">
                        <DockPanel Margin="4" KeyboardNavigation.TabNavigation="Local">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10" KeyboardNavigation.TabIndex="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ページ一覧" Style="{StaticResource PaneTitleStyle}" />
                                <ToggleButton Grid.Column="1"
                                      Content="サムネイル"
                                      IsChecked="{Binding ShowPageThumbnails, Mode=TwoWay}"
                                      Padding="7,3"
                                      ToolTip="ページ画像の表示をオン／オフします" />
                            </Grid>
                            <Border DockPanel.Dock="Top" Background="#F8F9FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="3" Margin="0,0,0,8" KeyboardNavigation.TabIndex="1">
                                <DockPanel LastChildFill="True" KeyboardNavigation.TabNavigation="Local">
                                    <ToolBarTray DockPanel.Dock="Top" IsLocked="True" HorizontalAlignment="Stretch" KeyboardNavigation.TabIndex="0">
                                        <ToolBar x:Name="PageCommandToolBar" Band="0" BandIndex="0" HorizontalAlignment="Stretch">
                                        <Button Command="{Binding InsertPagesCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページの後へPDFページを追加">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageInsert}" >
                                                    <Path.Fill>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                        </Button>
                                        <Button Command="{Binding DeletePagesCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページを削除">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageDelete}" >
                                                    <Path.Fill>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                        </Button>
                                        <Separator Width="4" />
                                        <Button Command="{Binding RotatePagesLeftCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページを左へ90°回転">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageRotateLeft}" >
                                                    <Path.Fill>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                        </Button>
                                        <Button Command="{Binding RotatePagesRightCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページを右へ90°回転">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageRotateRight}" >
                                                    <Path.Fill>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                        </Button>
                                        </ToolBar>
                                    </ToolBarTray>
                                    <Grid Margin="4,3,4,0" Visibility="{Binding ShowPageThumbnails, Converter={StaticResource BooleanToVisibilityConverter}}" KeyboardNavigation.TabIndex="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Content="小" VerticalAlignment="Center" Foreground="#667085"  Padding="0" Target="{Binding ElementName=KeyboardField6}" />
                                        <Slider Grid.Column="1" Minimum="72" Maximum="220" TickFrequency="4"
                                        Value="{Binding PageThumbnailSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="5,0" ToolTip="サムネイルの大きさ"  x:Name="KeyboardField6"/>
                                        <TextBlock Grid.Column="2" Text="大" VerticalAlignment="Center" Foreground="#667085" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Grid KeyboardNavigation.TabIndex="2">
                            <ListBox x:Name="PageList"
                             ItemsSource="{Binding PageItems}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                             SelectionMode="Extended"
                             SelectionChanged="PageList_OnSelectionChanged"
                             PreviewKeyDown="PageList_OnPreviewKeyDown"
                             PreviewMouseLeftButtonDown="PageList_OnPreviewMouseLeftButtonDown"
                             PreviewMouseRightButtonDown="PageList_OnPreviewMouseRightButtonDown"
                             PreviewMouseMove="PageList_OnPreviewMouseMove"
                             DragOver="PageList_OnDragOver"
                             DragLeave="PageList_OnDragLeave"
                             Drop="PageList_OnDrop"
                             AllowDrop="True"
                             HorizontalContentAlignment="Stretch"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource PageListItemStyle}" AutomationProperties.Name="ページ一覧">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="ページを挿入...(_I)" Command="{Binding PlacementTarget.DataContext.InsertPagesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"  AutomationProperties.AccessKey="Alt+I"/>
                                        <MenuItem Header="選択ページを削除(_D)" Command="{Binding PlacementTarget.DataContext.DeletePagesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Delete"  AutomationProperties.AccessKey="Alt+D"/>
                                        <Separator />
                                        <MenuItem Header="左へ90°回転(_L)" Command="{Binding PlacementTarget.DataContext.RotatePagesLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"  AutomationProperties.AccessKey="Alt+L"/>
                                        <MenuItem Header="右へ90°回転(_R)" Command="{Binding PlacementTarget.DataContext.RotatePagesRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"  AutomationProperties.AccessKey="Alt+R"/>
                                        <Separator />
                                        <MenuItem Header="サムネイルを表示(_T)" IsCheckable="True"
                                          IsChecked="{Binding PlacementTarget.DataContext.ShowPageThumbnails, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}"  AutomationProperties.AccessKey="Alt+T"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <Grid Visibility="{Binding DataContext.ShowPageThumbnails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border x:Name="ThumbnailFrame"
                                                Width="{Binding DataContext.PageThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.PageThumbnailHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#F4F6F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="読込中..." Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="ThumbnailFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="ThumbnailFrame" Property="BorderThickness" Value="3" />
                                                <Setter TargetName="ThumbnailFrame" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="12">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PageItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Viewbox Width="34" Height="34" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.42">
                                        <Path Data="{StaticResource IconGeometry.OpenPdfBadge}" Fill="Transparent" Stroke="#667085" StrokeThickness="1.2" />
                                    </Viewbox>
                                    <TextBlock Text="PDFを開くとページが表示されます"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="しおり(_K)" Margin="0,0,0,0" Padding="10,2,10,2" AutomationProperties.AccessKey="Alt+K">
                        <DockPanel Margin="4" KeyboardNavigation.TabNavigation="Local">
                            <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Margin="0,0,0,8" KeyboardNavigation.TabIndex="0">
                                <ToolBar x:Name="BookmarkCommandToolBar" Band="0" BandIndex="0">
                                <Button Command="{Binding AddBookmarkCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="現在のページにしおりを追加" Margin="2" AutomationProperties.Name="しおりを追加">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.BookmarkAdd}" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding AddChildBookmarkCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択中のしおりの子として追加" Margin="2" AutomationProperties.Name="選択中のしおりの子として追加">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.BookmarkAddChild}" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding DeleteBookmarkCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択したしおりを削除" Margin="2" AutomationProperties.Name="しおりを削除">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Delete}" Width="22" Height="23" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding GoToBookmarkCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" Margin="2" ToolTip="選択したしおりのページへ移動" AutomationProperties.Name="しおりのページへ移動">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.BookmarkGoTo}" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding MoveBookmarkUpCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" Margin="2" ToolTip="同じ階層内で上へ">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.MoveUp}" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding MoveBookmarkDownCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" Margin="2" ToolTip="同じ階層内で下へ">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.MoveDown}" />
                                    </Viewbox>
                                </Button>
                                </ToolBar>
                            </ToolBarTray>
                            <ToolBarTray DockPanel.Dock="Bottom" IsLocked="True" Margin="0,8,0,0" Background="{x:Null}" KeyboardNavigation.TabIndex="9000" KeyboardNavigation.TabNavigation="Local">
                                <ToolBar x:Name="BookmarkTransferToolBar" Band="0" BandIndex="0" Background="{x:Null}">
                                    <Button Command="{Binding ImportBookmarksCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" Margin="2" ToolTip="しおりをインポート" AutomationProperties.Name="しおりをインポート">
                                        <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                            <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Import}" />
                                        </Viewbox>
                                    </Button>
                                    <Button Command="{Binding ExportBookmarksCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" Margin="2" ToolTip="しおりをエクスポート" AutomationProperties.Name="しおりをエクスポート">
                                        <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                            <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Export}" />
                                        </Viewbox>
                                    </Button>
                                </ToolBar>
                            </ToolBarTray>
                            <TreeView x:Name="BookmarkTree"
                                  ItemsSource="{Binding BookmarkItems}"
                                  FontWeight="Normal"
                                  SelectedItemChanged="BookmarkTree_OnSelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="BookmarkTree_OnPreviewMouseLeftButtonDown"
                                  PreviewMouseMove="BookmarkTree_OnPreviewMouseMove"
                                  PreviewKeyDown="BookmarkTree_OnPreviewKeyDown"
                                  DragOver="BookmarkTree_OnDragOver"
                                  DragLeave="BookmarkTree_OnDragLeave"
                                  Drop="BookmarkTree_OnDrop"
                                  ToolTip="選択後にF2、ダブルクリック、または右クリックの［編集］でタイトルを変更できます。" AutomationProperties.Name="しおり" KeyboardNavigation.TabIndex="1">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="編集(_E)" Click="EditBookmarkMenuItem_OnClick" InputGestureText="F2"  AutomationProperties.AccessKey="Alt+E"/>
                                        <MenuItem Header="このしおりへ移動(_G)" Click="GoToBookmarkMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+G"/>
                                        <Separator />
                                        <MenuItem Header="子しおりを追加(_C)" Click="AddChildBookmarkMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+C"/>
                                        <MenuItem Header="削除(_D)" Click="DeleteBookmarkMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+D"/>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <!-- 各行のクリック領域を保ったまま、上下に少し余白を加える。 -->
                                        <Setter Property="Padding" Value="1,2" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="BookmarkTreeItem_OnPreviewMouseRightButtonDown" />
                                        <EventSetter Event="MouseDoubleClick" Handler="BookmarkTreeItem_OnMouseDoubleClick" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <Grid Grid.Column="2" Margin="4">
                <Border Background="{StaticResource CanvasSurroundBrush}" CornerRadius="5">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <Grid KeyboardNavigation.TabIndex="0">
                            <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4"
                                          PreviewMouseWheel="PreviewScrollViewer_OnPreviewMouseWheel"
                                          ScrollChanged="PreviewScrollViewer_OnScrollChanged"
                                          SizeChanged="PreviewScrollViewer_OnSizeChanged">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Grid x:Name="PreviewDocumentLayoutHost" HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PreviousPreviewPageHost" Background="White" BorderBrush="#91A0AE" BorderThickness="1"
                                            Margin="6" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Visibility="{Binding HasPreviousPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Tag="{Binding PreviousPreviewPageNumber}"
                                            MouseLeftButtonUp="AdjacentPreviewPage_OnMouseLeftButtonUp"
                                            ToolTip="クリックしてこのページを編集">
                                        <Grid Width="{Binding PreviousPreviewPixelWidth}" Height="{Binding PreviousPreviewPixelHeight}">
                                            <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}" /></Grid.LayoutTransform>
                                            <Image Source="{Binding PreviousPreviewImage}" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border Background="#CC263746" CornerRadius="3" Padding="7,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding PreviousPreviewPageNumber, StringFormat={}{0} ページ}" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- 空き側は位置だけを確保し、Acrobatと同様にページ面を描画しない。 -->
                                    <Border x:Name="FacingBlankPageHost" Background="Transparent" BorderThickness="0"
                                            Margin="6" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Width="{Binding PreviewPixelWidth}" Height="{Binding PreviewPixelHeight}"
                                            IsHitTestVisible="False" Visibility="Collapsed">
                                        <Border.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}" /></Border.LayoutTransform>
                                    </Border>
                                <Border x:Name="PreviewPageHost"
                                        Background="White"
                                        BorderBrush="#CBD3DA"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        PreviewMouseLeftButtonDown="PreviewPageHost_OnPreviewMouseLeftButtonDown"
                                        PreviewMouseRightButtonDown="PreviewPageHost_OnPreviewMouseRightButtonDown">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="PreviewContextMenu_OnOpened"
                                                     IsEnabled="{Binding PlacementTarget.DataContext.CanUsePreview, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="透明テキスト領域を追加(_A)"
                                                      Tag="AddOcrRegion"
                                                      IsCheckable="True"
                                                      Click="PreviewAddOcrRegionMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+A"/>
                                            <MenuItem Header="OCRオーバーレイを表示(_O)"
                                                      Tag="ToggleOverlay"
                                                      IsCheckable="True"
                                                      Click="PreviewToggleOverlayMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+O"/>
                                            <MenuItem Header="選択を解除(_D)"
                                                      Click="PreviewClearSelectionMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+D"/>
                                            <Separator />
                                            <MenuItem Header="拡大(_I)"
                                                      InputGestureText="Ctrl++"
                                                      Click="PreviewZoomInMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+I"/>
                                            <MenuItem Header="縮小(_U)"
                                                      InputGestureText="Ctrl+-"
                                                      Click="PreviewZoomOutMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+U"/>
                                            <MenuItem Header="ページ幅に合わせる(_W)"
                                                      Click="PreviewFitWidthMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+W"/>
                                            <MenuItem Header="100%で表示(_1)"
                                                      Command="{Binding ActualSizeCommand}"  AutomationProperties.AccessKey="Alt+1"/>
                                            <MenuItem Header="ページ高さに合わせる(_H)"
                                                      Click="PreviewFitHeightMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+H"/>
                                            <MenuItem Header="ページ全体を表示(_F)"
                                                      Click="PreviewFitPageMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+F"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid Width="{Binding PreviewPixelWidth}" Height="{Binding PreviewPixelHeight}">
                                        <Grid.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}" />
                                        </Grid.LayoutTransform>
                                        <Image Source="{Binding PreviewImage, NotifyOnTargetUpdated=True}" TargetUpdated="PreviewImage_OnTargetUpdated"
                                               Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <ListBox x:Name="OverlayCanvas"
                                                 ItemsSource="{Binding OverlayItems}"
                                                 SelectionMode="Extended"
                                                 SelectionChanged="OverlayCanvas_OnSelectionChanged"
                                                 RequestBringIntoView="OverlayCanvas_OnRequestBringIntoView"
                                                 PreviewMouseLeftButtonDown="OverlayCanvas_OnPreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="OverlayCanvas_OnPreviewMouseMove"
                                                 PreviewMouseLeftButtonUp="OverlayCanvas_OnPreviewMouseLeftButtonUp"
                                                 Visibility="{Binding IsOcrOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox">
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddOcrRegionMode}" Value="True">
                                                            <Setter Property="Cursor" Value="Cross" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRedactionMode}" Value="True">
                                                            <Setter Property="Cursor" Value="Cross" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsRedactionMode}" Value="True" />
                                                                <Condition Binding="{Binding RedactionInputModeIndex}" Value="1" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Cursor" Value="IBeam" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <EventSetter Event="RequestBringIntoView" Handler="OverlayCanvas_OnRequestBringIntoView" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="{Binding Width}" Height="{Binding Height}" RenderTransformOrigin="0.5,0.5">
                                                        <Grid.RenderTransform>
                                                            <RotateTransform Angle="{Binding RotationDegrees}" />
                                                        </Grid.RenderTransform>
                                                        <Grid.Resources>
                                                            <Style x:Key="ResizeHandleStyle" TargetType="Thumb">
                                                                <Setter Property="Width" Value="{Binding DataContext.ResizeHandleSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Setter Property="Height" Value="{Binding DataContext.ResizeHandleSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Setter Property="Background" Value="{Binding DataContext.ResizeHandleFillBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Setter Property="BorderBrush" Value="{Binding DataContext.ResizeHandleBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Setter Property="Opacity" Value="{Binding DataContext.ResizeHandleOpacity, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}" />
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="{Binding DataContext.InverseZoomFactor, RelativeSource={RelativeSource AncestorType=Window}}"
