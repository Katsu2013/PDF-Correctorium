<Window x:Class="PdfCorrectorium.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfCorrectorium.App.ViewModels"
        xmlns:ocr="clr-namespace:PdfCorrectorium.App.Controls"
        Title="PDF Correctorium" Height="850" Width="1400" MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_OnPreviewKeyDown" Closing="MainWindow_OnClosing" xmlns:kb="clr-namespace:PdfCorrectorium.App.Services" KeyboardNavigation.TabNavigation="Cycle">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <!--
            ツールバー共通の内側余白。
            ボタン種別ごとのスタイルから参照することで、余白を変更するときに
            複数のツールバーを個別修正しなくて済むようにする。
        -->
        <Thickness x:Key="ToolbarButtonPadding">2</Thickness>

        <Style TargetType="ToolBarTray">
            <Setter Property="Background" Value="{StaticResource ToolbarBrush}" />
        </Style>
        <Style TargetType="ToolBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="MinWidth" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Style.Triggers>
                <!-- アイコンのみの表示では、余白を詰めた正方形に固定する。 -->
                <DataTrigger Binding="{Binding DataContext.ShowToolbarText, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Width" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarIconToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="ToggleChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Border x:Name="ActiveRail" Height="2" Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Bottom" Margin="4,0" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#F2F4F6" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#F3B1B1" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ActiveRail" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleChrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- アイコンのみの表示では、通常ボタンと同じ正方形に固定する。 -->
                <DataTrigger Binding="{Binding DataContext.ShowToolbarText, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Width" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarIconViewboxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="{Binding DataContext.ToolbarIconSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.ToolbarIconSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="Both" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Visibility" Value="{Binding DataContext.ShowToolbarText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Style>
        <Style x:Key="PropertyIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <!-- 24pxアイコンとキーボードフォーカス時の2px枠を収める。 -->
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <!-- 左ペインの小型操作ボタンは、文字記号ではなくベクターアイコンを使う。
             OSのフォント構成や高DPI倍率に左右されず、常に同じ形で表示するための共通スタイル。 -->
        <Style x:Key="LeftPaneIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <Style x:Key="LeftPaneIconViewboxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="Both" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- タブと切替ボタンの外観は App.xaml の共通スタイルを使用する。 -->
        <Style x:Key="PageListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#F2F4F6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 共通スタイルに別名を付け、既存の画面内参照を維持する。 -->
        <Style x:Key="ToolbarComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ModernComboBoxItemStyle}" />
        <Style x:Key="RoundedToolbarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ToolbarComboBoxItemStyle}" />
        </Style>
        <Style x:Key="BrandModeComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource RoundedToolbarComboBoxStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PaneTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:BookmarkNodeViewModel}" ItemsSource="{Binding Children}">
            <DockPanel ToolTip="{Binding PageNumber, StringFormat=ページ {0}}" LastChildFill="True">
                <Viewbox Width="13" Height="16" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Path Fill="Transparent"
                          Stroke="#52606D"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round"
                          Data="{StaticResource IconGeometry.Bookmark}" />
                </Viewbox>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PageNumber, StringFormat=  p.{0}}" Foreground="#667085" FontWeight="Normal" VerticalAlignment="Center" />
                <Grid MinWidth="70">
                    <TextBlock x:Name="BookmarkTitleText"
                               Text="{Binding Title}"
                               Padding="2,1"
                               FontWeight="Normal"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="BookmarkTitleEditor"
                             Tag="BookmarkTitleEditor"
                             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Visibility="Collapsed"
                             Padding="2,0"
                             FontWeight="Normal"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="BookmarkTitleEditor_OnPreviewKeyDown"
                             LostKeyboardFocus="BookmarkTitleEditor_OnLostKeyboardFocus" />
                </Grid>
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="BookmarkTitleText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BookmarkTitleEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <Style x:Key="QatIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <Style x:Key="RibbonTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="18,6,18,6" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderContent" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="White" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="TabChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonBigButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="MaxWidth" Value="92" />
            <Setter Property="Height" Value="78" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <Style x:Key="RibbonBigToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="MaxWidth" Value="92" />
            <Setter Property="Height" Value="78" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="ToggleChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <Style x:Key="RibbonSmallToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="ToggleChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonGroupBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,4,8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="RibbonGroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="RibbonTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,2,4,0">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,3">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BackstageNavButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="BackstageRecentButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7DEE6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
    <DockPanel KeyboardNavigation.TabNavigation="Local">
        <!-- === クイックアクセスツールバー (QAT) === -->
        <Border x:Name="QuickAccessToolbar" DockPanel.Dock="Top" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Height="36">
            <DockPanel LastChildFill="True">
                <!-- 右側: UIモード切替ボタン (リボン ⇄ クラシック) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Command="{Binding ToggleRibbonUiModeCommand}" Style="{StaticResource ModernButtonStyle}"
                            Height="28" Padding="11,2" ToolTip="{Binding UiModeToggleToolTip}"
                            AutomationProperties.Name="{Binding UiModeToggleToolTip}" kb:KeyboardAccess.Key="5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UiModeToggleText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 左側: QATボタン群 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="PDF Correctorium" FontWeight="SemiBold" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <Rectangle Width="1" Height="20" Fill="#CBD5E1" Margin="0,0,5,0" />
                    <Button Command="{Binding SaveProjectCommand}" Style="{StaticResource QatIconButtonStyle}" ToolTip="プロジェクトを上書き保存 (Ctrl+S)"
                            AutomationProperties.Name="プロジェクトを上書き保存" kb:KeyboardAccess.Key="1">
                        <Viewbox Width="18" Height="18">
                            <Path StrokeThickness="1.8" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.SaveProject}" Fill="#263746">
                                <Path.Stroke>
                                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
                                </Path.Stroke>
                            </Path>
                        </Viewbox>
                    </Button>
                    <Button Command="{Binding ExportPdfCommand}" Style="{StaticResource QatIconButtonStyle}" ToolTip="編集済みPDFを別名で出力"
                            AutomationProperties.Name="編集済みPDFを別名で出力" kb:KeyboardAccess.Key="2">
                        <Viewbox Width="18" Height="18">
                            <Path Fill="#FFC83B3B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.ExportPdf}" />
                        </Viewbox>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="#CBD5E1" Margin="5,0" />
                    <Button Command="{Binding UndoCommand}" Style="{StaticResource QatIconButtonStyle}" ToolTip="元に戻す (Ctrl+Z)"
                            AutomationProperties.Name="元に戻す" kb:KeyboardAccess.Key="3">
                        <Viewbox Width="18" Height="18">
                            <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Undo}" />
                        </Viewbox>
                    </Button>
                    <Button Command="{Binding RedoCommand}" Style="{StaticResource QatIconButtonStyle}" ToolTip="やり直す (Ctrl+Y)"
                            AutomationProperties.Name="やり直す" kb:KeyboardAccess.Key="4">
                        <Viewbox Width="18" Height="18">
                            <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Redo}" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
        <DockPanel x:Name="EditorShell" KeyboardNavigation.TabNavigation="Local">

        <!-- === リボンUIコンテナ === -->
        <Border DockPanel.Dock="Top" Visibility="{Binding IsRibbonUiMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <TabControl x:Name="MainRibbonTabControl" Style="{StaticResource RibbonTabControlStyle}" SelectedIndex="1"
                        SelectionChanged="MainRibbonTabControl_OnSelectionChanged">
                <!-- 【ファイル】は通常のコマンド面ではなく、作業領域を置き換えるBackstageビューを開く。 -->
                <TabItem x:Name="RibbonFileTab" Header="ファイル" Style="{StaticResource RibbonTabItemStyle}"
                         AutomationProperties.Name="ファイル" kb:KeyboardAccess.Key="F" />
                <!-- 【ホーム】タブ -->
                <TabItem Header="ホーム" Style="{StaticResource RibbonTabItemStyle}" AutomationProperties.Name="ホーム" kb:KeyboardAccess.Key="H">
                    <StackPanel Orientation="Horizontal" Height="98" VerticalAlignment="Top">
                        <!-- モード切替グループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="モード切替" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Command="{Binding ActivateOcrEditModeCommand}" IsChecked="{Binding IsOcrEditMode, Mode=OneWay}"
                                                  Style="{StaticResource RibbonBigToggleStyle}" ToolTip="OCR編集モードへ切り替え">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="22" Height="18" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" BorderThickness="1.6" CornerRadius="2" Margin="0,2,0,4">
                                                <TextBlock Text="T" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="OCR編集" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Command="{Binding ActivateReadingOrderModeCommand}" IsChecked="{Binding IsReadingOrderMode, Mode=OneWay}"
                                                  Style="{StaticResource RibbonBigToggleStyle}" ToolTip="読み順編集モードへ切り替え">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="18" Margin="0,2,0,4">
                                                <Path Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.ReadingEarlier}" />
                                            </Viewbox>
                                            <TextBlock Text="読み順" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Command="{Binding ActivateReviewModeCommand}" IsChecked="{Binding IsReviewMode, Mode=OneWay}"
                                                  Style="{StaticResource RibbonBigToggleStyle}" ToolTip="校正・確認モードへ切り替え">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="18" Margin="0,2,0,4">
                                                <Path Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.RotationReset}" />
                                            </Viewbox>
                                            <TextBlock Text="校正・確認" FontSize="12" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Command="{Binding ActivateRedactionModeCommand}" IsChecked="{Binding IsRedactionMode, Mode=OneWay}"
                                                  Style="{StaticResource RibbonBigToggleStyle}" ToolTip="墨消しモードへ切り替え">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="22" Height="14" Background="#263746" CornerRadius="1" Margin="0,4,0,6" />
                                            <TextBlock Text="墨消し" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 表示・移動グループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="表示・移動" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="前のページ">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PreviousPage}" />
                                                </Viewbox>
                                                <TextBlock Text="前へ" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="次のページ">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.NextPage}" />
                                                </Viewbox>
                                                <TextBlock Text="次へ" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- ページ番号 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <TextBox Width="38" Height="22" Padding="2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding HasDocument}" Text="{Binding SelectedPage.PageNumber, Mode=OneWay}"
                                                 GotKeyboardFocus="ToolbarPageNumberBox_OnGotKeyboardFocus"
                                                 PreviewKeyDown="ToolbarPageNumberBox_OnPreviewKeyDown"
                                                 LostKeyboardFocus="ToolbarPageNumberBox_OnLostKeyboardFocus" ToolTip="ページ番号を入力して Enter" />
                                        <TextBlock Text=" / " VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Text="{Binding PageItems.Count}" MinWidth="20" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center" Margin="2,0">
                                        <Button Click="FitWidthButton_OnClick" IsEnabled="{Binding CanUsePreview}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="幅に合わせる">
                                            <TextBlock Text="幅に合わせる" FontSize="12" />
                                        </Button>
                                        <Button Click="FitPageButton_OnClick" IsEnabled="{Binding CanUsePreview}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="ページ全体を表示">
                                            <TextBlock Text="全体表示" FontSize="11" />
                                        </Button>
                                    </StackPanel>

                                    <Button Command="{Binding ActualSizeCommand}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="100%（原寸）で表示">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="20" Height="20" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.ActualSize}" />
                                            </Viewbox>
                                            <TextBlock Text="100%" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 検索・校正グループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="検索・校正" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="FindOcrTextMenuItem_OnClick" IsEnabled="{Binding HasDocument}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="透明テキストを検索 (Ctrl+F)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Search}" />
                                            </Viewbox>
                                            <TextBlock Text="検索" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ReplaceOcrTextMenuItem_OnClick" IsEnabled="{Binding HasDocument}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="透明テキストを置換 (Ctrl+H)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Replace}" />
                                            </Viewbox>
                                            <TextBlock Text="置換" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="CommentsAndTags_OnClick" IsEnabled="{Binding HasDocument}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="コメントとタグの管理">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Bookmark}" />
                                            </Viewbox>
                                            <TextBlock Text="コメント" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- 【編集・校正】タブ：現在の編集モードに必要な操作だけを表示する -->
                <TabItem Header="編集・校正" Style="{StaticResource RibbonTabItemStyle}" AutomationProperties.Name="編集・校正" kb:KeyboardAccess.Key="E">
                    <StackPanel Orientation="Horizontal" Height="98" VerticalAlignment="Top">
                        <!-- 編集単位グループ (OCR編集モード時のみ有効) -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}" Visibility="{Binding IsOcrEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="編集単位" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanUseOcrEditControls}">
                                    <ToggleButton Command="{Binding SelectParagraphUnitCommand}" IsChecked="{Binding IsParagraphEditMode, Mode=OneWay}"
                                                  Style="{StaticResource RibbonBigToggleStyle}" ToolTip="段落単位で選択・編集します">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="20" Height="16" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" BorderThickness="1.5" CornerRadius="1" Margin="0,2,0,4">
                                                <TextBlock Text="¶" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="段落編集" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Command="{Binding SelectLineUnitCommand}" IsChecked="{Binding IsLineEditMode, Mode=OneWay}"
                                                  Style="{StaticResource RibbonBigToggleStyle}" ToolTip="行単位で選択・編集します">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="20" Height="16" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" BorderThickness="1.5" CornerRadius="1" Margin="0,2,0,4">
                                                <StackPanel VerticalAlignment="Center">
                                                    <Rectangle Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Margin="2,1" />
                                                    <Rectangle Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Margin="2,1" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="行編集" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Command="{Binding SelectCharacterUnitCommand}" IsChecked="{Binding IsCharacterEditMode, Mode=OneWay}"
                                                  Style="{StaticResource RibbonBigToggleStyle}" ToolTip="文字単位で選択・編集します">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="20" Height="16" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" BorderThickness="1.5" CornerRadius="1" Margin="0,2,0,4">
                                                <TextBlock Text="A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="文字編集" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 領域操作グループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}" Visibility="{Binding IsOcrEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="領域操作" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton IsChecked="{Binding IsAddOcrRegionMode, Mode=TwoWay}" IsEnabled="{Binding CanAddOcrRegion}"
                                                  Style="{StaticResource RibbonBigToggleStyle}" ToolTip="透明テキスト領域を追加。オンにしてドラッグします。">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.AddOcrRegion}" />
                                            </Viewbox>
                                            <TextBlock Text="領域追加" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button Command="{Binding DeleteOcrRegionsCommand}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="選択した透明テキスト領域を削除 (Delete)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Delete}" />
                                            </Viewbox>
                                            <TextBlock Text="選択削除" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton IsChecked="{Binding IsOcrOverlayVisible}" IsEnabled="{Binding CanUsePreview}"
                                                  Style="{StaticResource RibbonBigToggleStyle}" ToolTip="OCRオーバーレイを表示／非表示">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.OcrVisibility}" />
                                            </Viewbox>
                                            <TextBlock Text="OCR表示" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 配置・文字送りグループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}" Visibility="{Binding IsOcrEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="配置・文字送り" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 左右整列 -->
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Command="{Binding AlignLeftCommand}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="選択した領域を左揃え">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.6" Data="{StaticResource IconGeometry.AlignLeft}" />
                                                </Viewbox>
                                                <TextBlock Text="左揃え" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding AlignHorizontalCenterCommand}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="選択した領域を左右中央揃え">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.6" Data="{StaticResource IconGeometry.AlignHorizontalCenter}" />
                                                </Viewbox>
                                                <TextBlock Text="中央揃え" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding AlignRightCommand}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="選択した領域を右揃え">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.6" Data="{StaticResource IconGeometry.AlignRight}" />
                                                </Viewbox>
                                                <TextBlock Text="右揃え" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- 上下整列 -->
                                    <StackPanel VerticalAlignment="Center" Margin="2,0">
                                        <Button Command="{Binding AlignTopCommand}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="選択した領域を上揃え">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.6" Data="{StaticResource IconGeometry.AlignTop}" />
                                                </Viewbox>
                                                <TextBlock Text="上揃え" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding AlignVerticalCenterCommand}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="選択した領域を上下中央揃え">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.6" Data="{StaticResource IconGeometry.AlignVerticalCenter}" />
                                                </Viewbox>
                                                <TextBlock Text="上下中央" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding AlignBottomCommand}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="選択した領域を下揃え">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.6" Data="{StaticResource IconGeometry.AlignBottom}" />
                                                </Viewbox>
                                                <TextBlock Text="下揃え" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- 文字送り -->
                                    <StackPanel VerticalAlignment="Center" Margin="2,0">
                                        <Button Command="{Binding EqualizeCharacterAdvancesCommand}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="{Binding EqualizeCharacterAdvancesToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.6" Data="{StaticResource IconGeometry.EqualizeCharacterAdvances}" />
                                                </Viewbox>
                                                <TextBlock Text="文字等分" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RestoreOriginalCharacterAdvancesCommand}" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="{Binding RestoreOriginalCharacterAdvancesToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.6" Data="{StaticResource IconGeometry.RestoreCharacterAdvances}" />
                                                </Viewbox>
                                                <TextBlock Text="OCR復元" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 高度な校正グループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}" Visibility="{Binding IsOcrEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="高度な校正" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="BatchCharacterAdjustmentMenuItem_OnClick" IsEnabled="{Binding CanEditGeometry}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="前処理付き一括自動調整">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.EstimateCharacterAdvances}" />
                                            </Viewbox>
                                            <TextBlock Text="一括調整" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="RepeatedRegionPropagationMenuItem_OnClick" IsEnabled="{Binding CanEditGeometry}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="選択領域の編集を他ページへ反映">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageInsert}" />
                                            </Viewbox>
                                            <TextBlock Text="他ページへ反映" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OcrQualityAnalysisMenuItem_OnClick" IsEnabled="{Binding HasDocument}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="OCR品質の異常候補を走査">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.QualityCheck}" />
                                            </Viewbox>
                                            <TextBlock Text="品質チェック" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 読み順編集モード -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsReadingOrderMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource RibbonGroupBorderStyle}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="読み順" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding MoveReadingEarlierCommand}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="選択したOCR領域を読み順の1つ前へ移動" AutomationProperties.Name="読み順を1つ前へ">
                                            <StackPanel HorizontalAlignment="Center"><Viewbox Width="28" Height="28" Margin="0,2"><Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" Data="{StaticResource IconGeometry.ReadingEarlier}" /></Viewbox><TextBlock Text="1つ前へ" FontSize="12" /></StackPanel>
                                        </Button>
                                        <Button Command="{Binding MoveReadingLaterCommand}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="選択したOCR領域を読み順の1つ後へ移動" AutomationProperties.Name="読み順を1つ後へ">
                                            <StackPanel HorizontalAlignment="Center"><Viewbox Width="28" Height="28" Margin="0,2"><Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" Data="{StaticResource IconGeometry.ReadingLater}" /></Viewbox><TextBlock Text="1つ後へ" FontSize="12" /></StackPanel>
                                        </Button>
                                        <Button Command="{Binding RecalculateReadingOrderCommand}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="現在ページの読み順を位置から再計算" AutomationProperties.Name="読み順を再計算">
                                            <StackPanel HorizontalAlignment="Center"><Viewbox Width="28" Height="28" Margin="0,2"><Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" Data="{StaticResource IconGeometry.RecalculateReadingOrder}" /></Viewbox><TextBlock Text="再計算" FontSize="12" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RibbonGroupBorderStyle}">
