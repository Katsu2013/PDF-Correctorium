                                                        <Thumb x:Name="MoveHandle" Tag="Move" Cursor="SizeAll" Background="Transparent" Margin="5"
                                                               DragStarted="RedactionThumb_OnDragStarted"
                                                               DragDelta="RedactionThumb_OnDragDelta"
                                                               DragCompleted="RedactionThumb_OnDragCompleted"
                                                               AutomationProperties.Name="墨消し範囲を移動">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="Transparent" />
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                        <Thumb x:Name="NorthHandle" Tag="N" Width="18" Height="8" Cursor="SizeNS" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="NorthEastHandle" Tag="NE" Width="10" Height="10" Cursor="SizeNESW" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="EastHandle" Tag="E" Width="8" Height="18" Cursor="SizeWE" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="SouthEastHandle" Tag="SE" Width="10" Height="10" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="SouthHandle" Tag="S" Width="18" Height="8" Cursor="SizeNS" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="SouthWestHandle" Tag="SW" Width="10" Height="10" Cursor="SizeNESW" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="WestHandle" Tag="W" Width="8" Height="18" Cursor="SizeWE" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="NorthWestHandle" Tag="NW" Width="10" Height="10" Cursor="SizeNWSE" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsPath}" Value="True">
                                                            <Setter TargetName="RedactionPreviewBorder" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="RedactionPreviewPath" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTextSelection}" Value="True">
                                                            <Setter TargetName="RedactionPreviewBorder" Property="CornerRadius" Value="3" />
                                                            <Setter TargetName="RedactionPreviewBorder" Property="BorderThickness" Value="1" />
                                                            <Setter TargetName="MoveHandle" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="RedactionPreviewBorder" Property="BorderBrush" Value="#FFFFFFFF" />
                                                            <Setter TargetName="RedactionPreviewBorder" Property="BorderThickness" Value="2.5" />
                                                            <Setter TargetName="RedactionPreviewPath" Property="Stroke" Value="#FFFFFFFF" />
                                                            <Setter TargetName="RedactionPreviewPath" Property="StrokeThickness" Value="2.5" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                <Condition Binding="{Binding IsTextSelection}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="NorthHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="NorthEastHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="EastHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="SouthEastHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="SouthHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="SouthWestHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="WestHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="NorthWestHandle" Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Reading-order badges live in their own foreground layer so region
                                             borders and resize handles can never cover the sequence number. -->
                                        <ItemsControl x:Name="ReadingOrderBadgeLayer"
                                                      ItemsSource="{Binding OverlayItems}"
                                                      IsHitTestVisible="False"
                                                      Panel.ZIndex="100">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOcrOverlayVisible}" Value="True" />
                                                                <Condition Binding="{Binding IsReadingOrderMode}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ReadingOrderBadge"
                                                            Background="#FF006A6A"
                                                            BorderBrush="White"
                                                            BorderThickness="1"
                                                            CornerRadius="11"
                                                            Margin="-10,-10,0,0"
                                                            MinWidth="22"
                                                            Height="22"
                                                            Padding="4,0"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding DataContext.InverseZoomFactor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            ScaleY="{Binding DataContext.InverseZoomFactor, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </Border.RenderTransform>
                                                        <TextBlock Text="{Binding ReadingOrder}"
                                                                   Foreground="White"
                                                                   FontWeight="Bold"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                    <Border x:Name="NextPreviewPageHost" Background="White" BorderBrush="#91A0AE" BorderThickness="1"
                                            Margin="6" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Visibility="{Binding HasNextPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Tag="{Binding NextPreviewPageNumber}"
                                            MouseLeftButtonUp="AdjacentPreviewPage_OnMouseLeftButtonUp"
                                            ToolTip="クリックしてこのページを編集">
                                        <Grid Width="{Binding NextPreviewPixelWidth}" Height="{Binding NextPreviewPixelHeight}">
                                            <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}" /></Grid.LayoutTransform>
                                            <Image Source="{Binding NextPreviewImage}" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border Background="#CC263746" CornerRadius="3" Padding="7,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding NextPreviewPageNumber, StringFormat={}{0} ページ}" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                                    <!-- 連続表示では全ページ分の軽量な枠をここへ並べる。
                                         画像は表示範囲周辺だけを遅延生成し、現在ページだけ
                                         PreviewPageHost を差し込んで編集機能を維持する。 -->
                                    <ocr:ContinuousPagePanel x:Name="ContinuousDocumentLayoutHost"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top"
                                                             Visibility="Collapsed" />
                                </Grid>
                            </ScrollViewer>

                            <Border Width="620" Height="700" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/PdfCorrectorium;component/Resources/Branding/PdfCorrectorium-128.png"
                                           Width="88" Height="88" Stretch="Uniform" Margin="0,0,0,22" />
                                    <TextBlock Text="{Binding DocumentTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding DocumentDescription}" TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Margin="20,12,20,0" TextWrapping="Wrap" MaxWidth="500" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                                        <Button Content="PDFを開く" Command="{Binding OpenPdfCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="180" />
                                        <Button Content="プロジェクトを開く" Command="{Binding OpenProjectCommand}" MinWidth="180" Margin="10,3,3,3" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#99000000">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="220" Height="8" />
                                    <TextBlock Text="PDFプレビューを描画しています..." Foreground="White" FontSize="16" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer x:Name="KeyboardPropertiesPane" VerticalScrollBarVisibility="Auto" Padding="12,8" Focusable="False">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PropertiesPaneTitle" Text="{Binding PropertiesPaneTitle}" Style="{StaticResource PaneTitleStyle}" />
                            <ToggleButton Grid.Column="1"
                                      Content="説明"
                                      IsChecked="{Binding ShowPropertyHelpText, Mode=TwoWay}"
                                      Padding="7,3"
                                      ToolTip="操作説明の表示／非表示" />
                        </Grid>
                        <TextBlock Text="{Binding PropertiesPaneSummary}" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Separator Margin="0,14" />
                        <Border Background="#FFF8E7" BorderBrush="#E7C66B" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10"
                                Visibility="{Binding HasInputPdfIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="確認(_W)" Click="InputPdfIssues_OnClick" Padding="8,3" Margin="8,0,0,0"
                                        ToolTip="入力PDFのフォーム、署名、フォントなどの注意事項を表示" />
                                <TextBlock Text="{Binding InputPdfIssueSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <StackPanel Visibility="{Binding IsOcrInteractionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="文書注釈" Style="{StaticResource PaneTitleStyle}" />
                        <TextBlock Text="コメント、タグ、PDF内ページリンクを選択中の文字領域へ設定できます。"
                                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,7" />
                        <UniformGrid Columns="2">
                            <Button Content="コメント・タグ" Click="CommentsAndTags_OnClick" ToolTip="編集 メニュー → コメントとタグ (Alt+E, C)" Margin="0,0,3,0" />
                            <Button Content="リンク設定" Click="InternalLinkEdit_OnClick" IsEnabled="{Binding HasSelectedOverlay}" ToolTip="ページ メニュー → ページリンクを設定 (Alt+P, K)" Margin="3,0,0,0" />
                        </UniformGrid>
                        <UniformGrid Columns="4" Margin="0,6,0,0">
                            <Button Content="戻る" Click="InternalLinkBack_OnClick" IsEnabled="{Binding CanNavigateInternalLinkBack}" ToolTip="ページ メニュー → リンク移動前へ戻る (Alt+P, B)" Margin="0,0,2,0" />
                            <Button Content="進む" Click="InternalLinkForward_OnClick" IsEnabled="{Binding CanNavigateInternalLinkForward}" ToolTip="ページ メニュー → リンク移動を進める (Alt+P, F)" Margin="2,0" />
                            <Button Content="リンク先" Click="InternalLinkNavigate_OnClick" IsEnabled="{Binding HasInternalLinkForSelection}" ToolTip="ページ メニュー → リンク先へ移動 (Alt+P, G)" Margin="2,0" />
                            <Button Content="リンク削除" Click="InternalLinkDelete_OnClick" IsEnabled="{Binding HasInternalLinkForSelection}" ToolTip="ページ メニュー → ページリンクを削除 (Alt+P, E)" Margin="2,0,0,0" />
                        </UniformGrid>
                        </StackPanel>
                        <Separator Margin="0,14" />
                        <StackPanel x:Name="RedactionPanel" Visibility="{Binding IsRedactionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="#FFF4F4" BorderBrush="#D32F2F" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,0,0,9">
                            <TextBlock Text="墨消しモードです。文字選択、矩形、多角形、フリーハンドから指定方法を選べます。作成後は移動・サイズ変更でき、Escキーで未確定形状を取り消します。"
                                       TextWrapping="Wrap" Foreground="#8F1F1F" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="指定範囲はプロジェクトでは非破壊です。PDF文字選択は元のページ構造を保って対象文字だけを矩形へ置き換えます。安全に構造保持できない場合は画像化せず出力を中止します。任意範囲は対象ページを高精細画像化して確定します。"
                                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,8" />
                        <Label Content="指定方法(_M)" Padding="0" Target="{Binding ElementName=RedactionInputModeComboBox}" />
                        <ComboBox x:Name="RedactionInputModeComboBox" SelectedIndex="{Binding RedactionInputModeIndex, Mode=TwoWay}"
                                  IsEnabled="{Binding HasDocument}"
                                  SelectionChanged="RedactionInputModeComboBox_OnSelectionChanged"
                                  Margin="0,2,0,7" AutomationProperties.AccessKey="Alt+M">
                            <ComboBoxItem Content="矩形" />
                            <ComboBoxItem Content="PDF文字を選択" />
                            <ComboBoxItem Content="多角形" />
                            <ComboBoxItem Content="フリーハンド" />
                        </ComboBox>
                        <TextBlock Text="文字選択は可視・透明テキストを囲み、同じ行をマーカー状の連続した墨消し帯にします。多角形はクリックで頂点を追加し、ダブルクリックまたはEnterで確定します。"
                                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8" />
                        <Label Content="墨消し色(_C)" Padding="0" Target="{Binding ElementName=RedactionColorTextBox}" />
                        <DockPanel Margin="0,3,0,6">
                            <Border DockPanel.Dock="Right" Width="30" Height="24" Margin="6,0,0,0"
                                    Background="{Binding RedactionColorPreview}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                            <TextBox x:Name="RedactionColorTextBox" Text="{Binding RedactionColorHex, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="#RRGGBB形式で入力" AutomationProperties.AccessKey="Alt+C" />
                        </DockPanel>
                        <UniformGrid Columns="6" Margin="0,0,0,7">
                            <Button Background="#000000" Tag="#000000" Height="24" Click="RedactionColorButton_OnClick" ToolTip="黒" AutomationProperties.Name="墨消し色 黒" />
                            <Button Background="#FFFFFF" Tag="#FFFFFF" Height="24" Click="RedactionColorButton_OnClick" ToolTip="白" AutomationProperties.Name="墨消し色 白" />
                            <Button Background="#D32F2F" Tag="#D32F2F" Height="24" Click="RedactionColorButton_OnClick" ToolTip="赤" AutomationProperties.Name="墨消し色 赤" />
                            <Button Background="#1565C0" Tag="#1565C0" Height="24" Click="RedactionColorButton_OnClick" ToolTip="青" AutomationProperties.Name="墨消し色 青" />
                            <Button Background="#388E3C" Tag="#388E3C" Height="24" Click="RedactionColorButton_OnClick" ToolTip="緑" AutomationProperties.Name="墨消し色 緑" />
                            <Button Background="#F9A825" Tag="#F9A825" Height="24" Click="RedactionColorButton_OnClick" ToolTip="黄" AutomationProperties.Name="墨消し色 黄" />
                        </UniformGrid>
                        <ToggleButton x:Name="RedactionEyedropperButton" Content="スポイトで取得(_I)" Margin="0,0,0,7"
                                      Click="RedactionEyedropperButton_OnClick"
                                      ToolTip="現在のPDFページをクリックし、その位置の色を墨消し色として取得します。"
                                      AutomationProperties.AccessKey="Alt+I" />
                        <Label Content="編集画面での表示(_V)" Padding="0" Target="{Binding ElementName=RedactionPreviewTranslucentRadioButton}" />
                        <UniformGrid Columns="2" Margin="0,2,0,7">
                            <RadioButton x:Name="RedactionPreviewTranslucentRadioButton" Content="半透明(_T)"
                                         GroupName="RedactionPreviewOpacity" IsChecked="{Binding IsRedactionPreviewTranslucent, Mode=TwoWay}"
                                         AutomationProperties.AccessKey="Alt+T" />
                            <RadioButton x:Name="RedactionPreviewOpaqueRadioButton" Content="不透明(_O)"
                                         GroupName="RedactionPreviewOpacity" IsChecked="{Binding IsRedactionPreviewOpaque, Mode=TwoWay}"
                                         AutomationProperties.AccessKey="Alt+O" />
                        </UniformGrid>
                        <Button Content="事前に選択した文字・OCR領域を墨消し" Command="{Binding AddSelectedRedactionsCommand}"
                                ToolTip="OCR編集で選択してから墨消しモードへ切り替えた文字またはOCR領域を対象にします。" />
                        <TextBlock Text="{Binding CurrentPageRedactionCount, StringFormat=このページ: {0}件}" Margin="0,7,0,3" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ListBox ItemsSource="{Binding RedactionItems}" SelectedItem="{Binding SelectedRedaction}" MaxHeight="86" AutomationProperties.Name="このページの墨消し範囲">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="3">
                                        <Border Width="18" Height="14" Background="{Binding ColorHex}" BorderBrush="#999" BorderThickness="1" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Description}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Columns="2" Margin="0,5,0,0">
                            <Button Content="選択範囲を削除" Command="{Binding DeleteSelectedRedactionCommand}" Margin="0,0,3,0"
                                    ToolTip="選択中の墨消し範囲を削除します。Undoで元に戻せます。" />
                            <Button Content="ページ内を全解除" Command="{Binding ClearCurrentPageRedactionsCommand}" Margin="3,0,0,0" />
                        </UniformGrid>
                        </StackPanel>
                        <Separator Margin="0,14" />
                        <StackPanel x:Name="ReviewPanel" Visibility="{Binding IsReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="校正・確認" Style="{StaticResource PaneTitleStyle}" />
                            <TextBlock Text="文字と確認ステータスを編集できます。枠の移動・変形操作は無効です。"
                                       TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,8" />
                            <Label Content="確認対象の絞り込み(_Q)" Padding="0" Target="{Binding ElementName=ReviewFilterComboBox}" />
                            <ComboBox x:Name="ReviewFilterComboBox" ItemsSource="{Binding ReviewFilterOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedIndex="{Binding ReviewFilterIndex, Mode=TwoWay}" ToolTip="確認対象の絞り込み" AutomationProperties.AccessKey="Alt+Q"/>
                            <TextBlock Text="{Binding ReviewSummary}" Margin="0,8,0,4" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Label Content="確認対象(_R)" Padding="0" Target="{Binding ElementName=ReviewTargetList}" />
                            <ListBox x:Name="ReviewTargetList" ItemsSource="{Binding ReviewItems}" MaxHeight="132"
                                     SelectedItem="{Binding SelectedReviewItem, Mode=TwoWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonDown="ReviewTargetList_OnPreviewMouseLeftButtonDown" AutomationProperties.AccessKey="Alt+R">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="3,4" ToolTip="{Binding Text}">
                                            <TextBlock Text="{Binding ReadingOrder, StringFormat={}{0}.}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="このページに該当する領域はありません。前／次の対象で別のページも検索できます。"
                                       Visibility="{Binding HasNoReviewItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                            <UniformGrid Columns="2" Margin="0,7,0,0">
                                <Button x:Name="PreviousReviewButton" Content="前の対象" Command="{Binding PreviousReviewCommand}"
                                        Click="ReviewNavigationButton_OnClick" Margin="0,0,3,0" />
                                <Button x:Name="NextReviewButton" Content="次の対象" Command="{Binding NextReviewCommand}"
                                        Click="ReviewNavigationButton_OnClick" Margin="3,0,0,0" />
                            </UniformGrid>
                            <Button x:Name="VerifyAndNextButton" Content="確認済みにして次へ" Command="{Binding VerifyAndNextCommand}"
                                    Click="ReviewNavigationButton_OnClick" Margin="0,6,0,0"
                                    ToolTip="選択中の1領域を確認済みにして、ページ順・読み順で次の対象へ移動します。" />
                            <StackPanel Visibility="{Binding IsReviewNavigating, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                                <ProgressBar IsIndeterminate="True" Height="3" />
                                <Button Content="検索を中止" Command="{Binding CancelReviewNavigationCommand}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Separator Margin="0,14" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowMultipleSelectionProperties, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="複数領域の整列" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding SelectedOverlayCount, StringFormat=選択中: {0}領域}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,8" />
                            <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#F0A0A0" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,0,0,8">
                                <TextBlock Text="{Binding AlignmentReferenceDescription}" TextWrapping="Wrap" Foreground="#8F1F1F" FontWeight="SemiBold" />
                            </Border>
