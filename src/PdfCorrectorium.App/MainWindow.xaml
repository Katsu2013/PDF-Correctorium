<Window x:Class="PdfCorrectorium.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfCorrectorium.App.ViewModels"
        Title="PDF Correctorium" Height="850" Width="1400" MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_OnPreviewKeyDown" Closing="MainWindow_OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <!--
            ツールバー共通の内側余白。
            ボタン種別ごとのスタイルから参照することで、余白を変更するときに
            複数のツールバーを個別修正しなくて済むようにする。
        -->
        <Thickness x:Key="ToolbarButtonPadding">4</Thickness>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="{Binding DataContext.ToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.ToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Style.Triggers>
                <!-- アイコンのみの表示では、設定値を一辺とする正方形に固定する。 -->
                <DataTrigger Binding="{Binding DataContext.ShowToolbarText, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Width" Value="{Binding DataContext.ToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarIconToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="{Binding DataContext.ToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.ToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Style.Triggers>
                <!-- アイコンのみの表示では、通常ボタンと同じ正方形に固定する。 -->
                <DataTrigger Binding="{Binding DataContext.ShowToolbarText, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Width" Value="{Binding DataContext.ToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarIconViewboxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="{Binding DataContext.ToolbarIconSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.ToolbarIconSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="Both" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,1,0" />
            <Setter Property="Visibility" Value="{Binding DataContext.ShowToolbarText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Style>
        <Style x:Key="PropertyIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <!-- 左ペインの小型操作ボタンは、文字記号ではなくベクターアイコンを使う。
             OSのフォント構成や高DPI倍率に左右されず、常に同じ形で表示するための共通スタイル。 -->
        <Style x:Key="LeftPaneIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <Style x:Key="LeftPaneIconViewboxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="Both" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:BookmarkNodeViewModel}" ItemsSource="{Binding Children}">
            <DockPanel ToolTip="{Binding PageNumber, StringFormat=ページ {0}}" LastChildFill="True">
                <Viewbox Width="13" Height="16" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Path Fill="Transparent"
                          Stroke="#52606D"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round"
                          Data="{StaticResource IconGeometry.Bookmark}" />
                </Viewbox>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PageNumber, StringFormat=  p.{0}}" Foreground="#667085" VerticalAlignment="Center" />
                <Grid MinWidth="70">
                    <TextBlock x:Name="BookmarkTitleText"
                               Text="{Binding Title}"
                               Padding="2,1"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="BookmarkTitleEditor"
                             Tag="BookmarkTitleEditor"
                             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Visibility="Collapsed"
                             Padding="2,0"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="BookmarkTitleEditor_OnPreviewKeyDown"
                             LostKeyboardFocus="BookmarkTitleEditor_OnLostKeyboardFocus" />
                </Grid>
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="BookmarkTitleText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BookmarkTitleEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid Background="#EEF1F4">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="PDFを開く..." Command="{Binding OpenPdfCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="プロジェクトを開く..." Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="NDLOCR-Liteデータを読み込む..." Command="{Binding ImportOcrDataCommand}" />
                <MenuItem Header="文書のプロパティ..." Click="DocumentPropertiesMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="プロジェクトを上書き保存" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="プロジェクトを別名で保存..." Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="編集済みPDFを別名で出力..." Command="{Binding ExportPdfCommand}" />
                <Separator />
                <MenuItem Header="終了" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="やり直す" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="透明テキストを検索..." InputGestureText="Ctrl+F" Click="FindOcrTextMenuItem_OnClick" />
                <MenuItem Header="透明テキストを置換..." InputGestureText="Ctrl+H" Click="ReplaceOcrTextMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="設定..." Click="ApplicationSettingsMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="ページ一覧"
                          IsCheckable="True"
                          IsChecked="{Binding ShowPageListPanel, Mode=TwoWay}" />
                <MenuItem Header="OCRプロパティ"
                          IsCheckable="True"
                          IsChecked="{Binding ShowPropertiesPanel, Mode=TwoWay}" />
                <MenuItem Header="ステータスバー"
                          IsCheckable="True"
                          IsChecked="{Binding ShowStatusBar, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="プロパティの詳しい説明"
                          IsCheckable="True"
                          IsChecked="{Binding ShowPropertyHelpText, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="しおり(_B)">
                <MenuItem Header="現在のページにしおりを追加" Command="{Binding AddBookmarkCommand}" />
                <MenuItem Header="選択中のしおりへ子しおりを追加" Command="{Binding AddChildBookmarkCommand}" />
                <MenuItem Header="選択中のしおりを削除" Command="{Binding DeleteBookmarkCommand}" />
                <Separator />
                <MenuItem Header="しおりをインポート..." Command="{Binding ImportBookmarksCommand}" />
                <MenuItem Header="しおりをエクスポート..." Command="{Binding ExportBookmarksCommand}" />
            </MenuItem>
            <MenuItem Header="OCR(_O)">
                <MenuItem Header="透明テキスト領域を追加"
                          IsCheckable="True"
                          IsChecked="{Binding IsAddOcrRegionMode, Mode=TwoWay}" />
                <MenuItem Header="選択した透明テキスト領域を削除"
                          Command="{Binding DeleteOcrRegionsCommand}"
                          InputGestureText="Delete" />
                <Separator />
                <MenuItem Header="前処理付き一括自動調整..."
                          Click="BatchCharacterAdjustmentMenuItem_OnClick" />
                <MenuItem Header="選択領域の編集を他ページへ反映..."
                          Click="RepeatedRegionPropagationMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="OCR品質の異常候補..."
                          Click="OcrQualityAnalysisMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="ページ(_P)">
                <MenuItem Header="ページを挿入..." Command="{Binding InsertPagesCommand}" />
                <MenuItem Header="選択ページを削除" Command="{Binding DeletePagesCommand}" InputGestureText="Delete" />
                <Separator />
                <MenuItem Header="選択ページを左へ90°回転" Command="{Binding RotatePagesLeftCommand}" />
                <MenuItem Header="選択ページを右へ90°回転" Command="{Binding RotatePagesRightCommand}" />
                <Separator />
                <MenuItem Header="{Binding CurrentPageImageOptimizationActionText}"
                          Command="{Binding OptimizeCurrentPageImageCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding IsCurrentPageImageOptimizationEnabled, Mode=OneWay}"
                          ToolTip="ページサイズと内容位置を保ったまま、全面画像の四辺余白、中央空白帯、単一色背景を削減します" />
                <MenuItem Header="PDF全体の画像を分析・最適化..."
                          Command="{Binding OptimizeDocumentImagesCommand}"
                          ToolTip="全ページを走査して容量削減候補、概算サイズ、空白全面画像を一覧表示します" />
            </MenuItem>
            <MenuItem Header="検証(_A)">
                <MenuItem Header="現在のプロジェクトを検証(_V)" Click="ValidateProjectMenuItem_OnClick" />
                <MenuItem Header="バックアップから復旧(_R)" Click="RestoreProjectMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="ログフォルダーを開く(_L)" Click="OpenLogFolderMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="バージョン情報(_A)" Click="AboutMenuItem_OnClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1">
            <ToolBarTray IsLocked="False">
                <ToolBar x:Name="MainToolbarPanel" Band="0" BandIndex="0" Padding="6,2">
                    <Button Command="{Binding OpenPdfCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="PDFを開く">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Path Data="{StaticResource IconGeometry.OpenPdf}" StrokeThickness="1.5" StrokeLineJoin="Round" >
                                    <Path.Stroke>
                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
                                    </Path.Stroke>
                                    <Path.Fill>
                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
                                    </Path.Fill>
                                </Path>
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="PDFを開く" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenProjectCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="プロジェクトを開く">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Path Fill="#D9A441" StrokeThickness="1.4" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.OpenProject}" >
                                    <Path.Stroke>
                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
                                    </Path.Stroke>
                                </Path>
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="プロジェクトを開く" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveProjectCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="プロジェクトを上書き保存 (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Path StrokeThickness="1.8" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.SaveProject}" >
                                    <Path.Fill>
                                        <SolidColorBrush Color="{DynamicResource AccentColor}"/>
                                    </Path.Fill>
                                    <Path.Stroke>
                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
                                    </Path.Stroke>
                                </Path>
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="上書き保存" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportPdfCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="編集済みPDFを別名で出力">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Path Fill="#FFC83B3B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.ExportPdf}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="PDF出力" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ImportOcrDataCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="OCRデータを読み込む">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Path Fill="#FF131313" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.ImportOcr}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="OCR読込" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="8,0" />
                    <ToggleButton IsChecked="{Binding IsOcrOverlayVisible}" Style="{StaticResource ToolbarIconToggleStyle}" ToolTip="OCRを表示／非表示">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}" MaxWidth="64">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.OcrVisibility}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="OCR表示" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsAddOcrRegionMode, Mode=TwoWay}"
                              IsEnabled="{Binding HasPreview}"
                              Style="{StaticResource ToolbarIconToggleStyle}"
                              ToolTip="透明テキスト領域を追加。オンにしてページ上をドラッグします。">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.AddOcrRegion}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="領域追加" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Command="{Binding DeleteOcrRegionsCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}"
                        ToolTip="選択した透明テキスト領域を削除 (Delete)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Delete}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="削除" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="8,0" />
                    <Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="前のページ">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PreviousPage}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="前へ" />
                        </StackPanel>
                    </Button>
                    <!-- Smoke tests and accessibility automation continue to read the full summary from this element. -->
                    <TextBlock x:Name="ToolbarPageSummary" Text="{Binding PageSummary}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <TextBox x:Name="ToolbarPageNumberBox"
                                 Width="48"
                                 MinHeight="25"
                                 Padding="4,1"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SelectedPage.PageNumber, Mode=OneWay}"
                                 ToolTip="ページ番号を入力して Enter で移動"
                                 AutomationProperties.Name="現在のページ番号"
                                 GotKeyboardFocus="ToolbarPageNumberBox_OnGotKeyboardFocus"
                                 PreviewKeyDown="ToolbarPageNumberBox_OnPreviewKeyDown"
                                 LostKeyboardFocus="ToolbarPageNumberBox_OnLostKeyboardFocus" />
                        <TextBlock Text=" / " VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageItems.Count}" MinWidth="24" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="次のページ">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.NextPage}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="次へ" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="8,0" />
                    <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="縮小">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.ZoomOut}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="縮小" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ZoomInCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="拡大">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.ZoomIn}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="拡大" />
                        </StackPanel>
                    </Button>
                    <Button Click="FitWidthButton_OnClick" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="ページ幅に合わせる">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.FitWidth}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="幅に合わせる" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ActualSizeCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="100%で表示">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Grid>
                                    <Ellipse Stroke="#263746" StrokeThickness="1.7" />
                                    <TextBlock Text="1:1" Foreground="#263746" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="100%" />
                        </StackPanel>
                    </Button>
                    <Button Click="FitHeightButton_OnClick" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="ページ高さに合わせる（上下ぴったり）">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.FitHeight}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="高さに合わせる" />
                        </StackPanel>
                    </Button>
                    <Button Click="FitPageButton_OnClick" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="ページ全体を表示">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.7" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.FitPage}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="ページ全体" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="8,0" />
                    <ComboBox x:Name="EditUnitSelector" Width="110" Margin="4,3" SelectedIndex="{Binding EditUnitIndex, Mode=TwoWay}" ToolTip="OCRの編集単位">
                        <ComboBoxItem Content="行編集" />
                        <ComboBoxItem Content="段落編集" />
                        <ComboBoxItem Content="文字編集" />
                    </ComboBox>
                    <ComboBox Width="150" Margin="8,3" SelectedIndex="{Binding EditorModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="OCR編集" />
                        <ComboBoxItem Content="読み順編集" />
                        <ComboBoxItem Content="校正・確認" />
                    </ComboBox>
                </ToolBar>
            </ToolBarTray>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                   Visibility="{Binding ShowStatusBar, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <Separator DockPanel.Dock="Right" >
            </Separator>
            <StatusBarItem DockPanel.Dock="Right" ToolTip="表示倍率。－/＋、スライダー、または倍率表示から変更できます。" Padding="2,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ZoomOutCommand}" Width="20" Height="20" Padding="0" ToolTip="縮小" MinHeight="20" BorderThickness="1,1,1,1" Margin="2,2,2,2" BorderBrush="{x:Null}" Background="{x:Null}" AutomationProperties.Name="縮小">
                        <Viewbox Width="12" Height="12">
                            <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.Minus}" Height="24" Width="24" />
                        </Viewbox>
                    </Button>
                    <Slider x:Name="StatusZoomSlider" Minimum="25" Maximum="400" TickFrequency="1" IsSnapToTickEnabled="False"
                            SmallChange="1" LargeChange="10"
                            Value="{Binding ZoomPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="92" Margin="2,0" VerticalAlignment="Center" />
                    <Button Command="{Binding ZoomInCommand}" Width="20" Height="20" Padding="0,0,0,0" ToolTip="拡大" MinHeight="20" Margin="2,2,2,2" BorderBrush="{x:Null}" Background="{x:Null}" AutomationProperties.Name="拡大">
                        <Viewbox Width="12" Height="12">
                            <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.Plus}" />
                        </Viewbox>
                    </Button>
                    <ComboBox x:Name="StatusZoomComboBox"
                              Text="{Binding ZoomDisplay, Mode=OneWay}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              Width="70" Height="20" Padding="1,0" Margin="2,0,0,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="StatusZoomComboBox_OnSelectionChanged"
                              PreviewKeyDown="StatusZoomComboBox_OnPreviewKeyDown"
                              LostKeyboardFocus="StatusZoomComboBox_OnLostKeyboardFocus"
                              ToolTip="倍率を入力するか、一覧から倍率・表示方法を選択します">
                        <ComboBoxItem Content="25%" Tag="25" />
                        <ComboBoxItem Content="50%" Tag="50" />
                        <ComboBoxItem Content="75%" Tag="75" />
                        <ComboBoxItem Content="100%" Tag="100" />
                        <ComboBoxItem Content="125%" Tag="125" />
                        <ComboBoxItem Content="150%" Tag="150" />
                        <ComboBoxItem Content="200%" Tag="200" />
                        <ComboBoxItem Content="300%" Tag="300" />
                        <ComboBoxItem Content="400%" Tag="400" />
                        <Separator />
                        <ComboBoxItem Content="ページ幅" Tag="FitWidth" />
                        <ComboBoxItem Content="ページ高さ" Tag="FitHeight" />
                        <ComboBoxItem Content="ページ全体" Tag="FitPage" />
                        <ComboBoxItem Content="選択範囲" Tag="FitSelection" />
                    </ComboBox>
                </StackPanel>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" >
            </Separator>
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding StorageModeText}" />
            <Separator DockPanel.Dock="Right" >
            </Separator>
            <StatusBarItem DockPanel.Dock="Right"
                           Padding="4,0"
                           Visibility="{Binding IsBackgroundOperationVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="96" Height="8" Margin="0,0,5,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding BackgroundOperationProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsBackgroundOperationIndeterminate, Mode=OneWay}" />
                    <TextBlock Text="{Binding BackgroundOperationMessage, Mode=OneWay}"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"
                       Visibility="{Binding IsBackgroundOperationVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding PageListColumnWidth}" />
                <ColumnDefinition Width="{Binding PageListSplitterWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding PropertiesPanelSplitterWidth}" />
                <ColumnDefinition Width="{Binding PropertiesPanelColumnWidth}" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="6,6,6,6">
                <TabControl>
                    <TabItem Header="ページ" Padding="10,2,10,2" Margin="0,0,0,0">
                        <DockPanel Margin="4">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ページ一覧" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1"
                                      Content="サムネイル"
                                      IsChecked="{Binding ShowPageThumbnails, Mode=TwoWay}"
                                      Padding="7,3"
                                      ToolTip="ページ画像の表示をオン／オフします" />
                            </Grid>
                            <Border DockPanel.Dock="Top" Background="#F4F6F8" BorderBrush="#D0D5DD" BorderThickness="0,0,0,1" Padding="3" Margin="0,0,0,6">
                                <DockPanel LastChildFill="True">
                                    <ToolBarTray DockPanel.Dock="Top" IsLocked="True" HorizontalAlignment="Stretch">
                                        <ToolBar x:Name="PageCommandToolBar" Band="0" BandIndex="0" HorizontalAlignment="Stretch">
                                        <Button Command="{Binding InsertPagesCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページの後へPDFページを追加">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageInsert}" >
                                                    <Path.Fill>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                        </Button>
                                        <Button Command="{Binding DeletePagesCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページを削除">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageDelete}" >
                                                    <Path.Fill>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                        </Button>
                                        <Separator Width="4" />
                                        <Button Command="{Binding RotatePagesLeftCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページを左へ90°回転">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageRotateLeft}" >
                                                    <Path.Fill>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                        </Button>
                                        <Button Command="{Binding RotatePagesRightCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページを右へ90°回転">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageRotateRight}" >
                                                    <Path.Fill>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                        </Button>
                                        </ToolBar>
                                    </ToolBarTray>
                                    <Grid Margin="4,3,4,0" Visibility="{Binding ShowPageThumbnails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="小" VerticalAlignment="Center" Foreground="#667085" />
                                        <Slider Grid.Column="1" Minimum="72" Maximum="220" TickFrequency="4"
                                        Value="{Binding PageThumbnailSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="5,0" ToolTip="サムネイルの大きさ" />
                                        <TextBlock Grid.Column="2" Text="大" VerticalAlignment="Center" Foreground="#667085" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <ListBox x:Name="PageList"
                             ItemsSource="{Binding PageItems}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                             SelectionMode="Extended"
                             SelectionChanged="PageList_OnSelectionChanged"
                             PreviewKeyDown="PageList_OnPreviewKeyDown"
                             PreviewMouseLeftButtonDown="PageList_OnPreviewMouseLeftButtonDown"
                             PreviewMouseRightButtonDown="PageList_OnPreviewMouseRightButtonDown"
                             PreviewMouseMove="PageList_OnPreviewMouseMove"
                             DragOver="PageList_OnDragOver"
                             DragLeave="PageList_OnDragLeave"
                             Drop="PageList_OnDrop"
                             AllowDrop="True"
                             HorizontalContentAlignment="Stretch">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="ページを挿入..." Command="{Binding PlacementTarget.DataContext.InsertPagesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="選択ページを削除" Command="{Binding PlacementTarget.DataContext.DeletePagesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Delete" />
                                        <Separator />
                                        <MenuItem Header="左へ90°回転" Command="{Binding PlacementTarget.DataContext.RotatePagesLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="右へ90°回転" Command="{Binding PlacementTarget.DataContext.RotatePagesRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="サムネイルを表示" IsCheckable="True"
                                          IsChecked="{Binding PlacementTarget.DataContext.ShowPageThumbnails, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <Grid Visibility="{Binding DataContext.ShowPageThumbnails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border x:Name="ThumbnailFrame"
                                                Width="{Binding DataContext.PageThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.PageThumbnailHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#EEF1F4" BorderBrush="#CBD3DA" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="読込中..." Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="ThumbnailFrame" Property="BorderBrush" Value="#FF0078D4" />
                                                <Setter TargetName="ThumbnailFrame" Property="BorderThickness" Value="3" />
                                                <Setter TargetName="ThumbnailFrame" Property="Background" Value="#FFEAF4FF" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="しおり" Margin="0,0,0,0" Padding="10,2,10,2">
                        <DockPanel Margin="4">
                            <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Margin="0,0,0,8">
                                <ToolBar x:Name="BookmarkCommandToolBar" Band="0" BandIndex="0">
                                <Button Command="{Binding AddBookmarkCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="現在のページにしおりを追加" Margin="2" AutomationProperties.Name="しおりを追加">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.BookmarkAdd}" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding AddChildBookmarkCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択中のしおりの下に追加" Margin="2" AutomationProperties.Name="子しおりを追加">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.BookmarkAddChild}" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding DeleteBookmarkCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択したしおりを削除" Margin="2" AutomationProperties.Name="しおりを削除">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Delete}" Width="22" Height="23" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding GoToBookmarkCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" Margin="2" ToolTip="選択したしおりのページへ移動" AutomationProperties.Name="しおりのページへ移動">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.BookmarkGoTo}" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding MoveBookmarkUpCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" Margin="2" ToolTip="同じ階層内で上へ">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.MoveUp}" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding MoveBookmarkDownCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" Margin="2" ToolTip="同じ階層内で下へ">
                                    <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.MoveDown}" />
                                    </Viewbox>
                                </Button>
                                </ToolBar>
                            </ToolBarTray>
                            <ToolBarTray DockPanel.Dock="Bottom" IsLocked="True" Margin="0,8,0,0" Background="{x:Null}">
                                <ToolBar x:Name="BookmarkTransferToolBar" Band="0" BandIndex="0" Background="{x:Null}">
                                    <Button Command="{Binding ImportBookmarksCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" Margin="2" ToolTip="しおりをインポート" AutomationProperties.Name="しおりをインポート">
                                        <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                            <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Import}" />
                                        </Viewbox>
                                    </Button>
                                    <Button Command="{Binding ExportBookmarksCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" Margin="2" ToolTip="しおりをエクスポート" AutomationProperties.Name="しおりをエクスポート">
                                        <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                            <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Export}" />
                                        </Viewbox>
                                    </Button>
                                </ToolBar>
                            </ToolBarTray>
                            <TreeView x:Name="BookmarkTree"
                                  ItemsSource="{Binding BookmarkItems}"
                                  SelectedItemChanged="BookmarkTree_OnSelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="BookmarkTree_OnPreviewMouseLeftButtonDown"
                                  PreviewMouseMove="BookmarkTree_OnPreviewMouseMove"
                                  PreviewKeyDown="BookmarkTree_OnPreviewKeyDown"
                                  DragOver="BookmarkTree_OnDragOver"
                                  DragLeave="BookmarkTree_OnDragLeave"
                                  Drop="BookmarkTree_OnDrop"
                                  ToolTip="選択後にF2、ダブルクリック、または右クリックの［編集］でタイトルを変更できます。">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="編集" Click="EditBookmarkMenuItem_OnClick" InputGestureText="F2" />
                                        <MenuItem Header="このしおりへ移動" Click="GoToBookmarkMenuItem_OnClick" />
                                        <Separator />
                                        <MenuItem Header="子しおりを追加" Click="AddChildBookmarkMenuItem_OnClick" />
                                        <MenuItem Header="削除" Click="DeleteBookmarkMenuItem_OnClick" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="BookmarkTreeItem_OnPreviewMouseRightButtonDown" />
                                        <EventSetter Event="MouseDoubleClick" Handler="BookmarkTreeItem_OnMouseDoubleClick" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D8DEE4" />

            <Grid Grid.Column="2" Margin="4">
                <Border Background="#3D4652" CornerRadius="4">
                    <DockPanel>
                        <Grid>
                            <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4"
                                          PreviewMouseWheel="PreviewScrollViewer_OnPreviewMouseWheel" SizeChanged="PreviewScrollViewer_OnSizeChanged">
                                <Border x:Name="PreviewPageHost"
                                        Background="White"
                                        BorderBrush="#CBD3DA"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        PreviewMouseRightButtonDown="PreviewPageHost_OnPreviewMouseRightButtonDown">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="PreviewContextMenu_OnOpened">
                                            <MenuItem Header="透明テキスト領域を追加"
                                                      Tag="AddOcrRegion"
                                                      IsCheckable="True"
                                                      Click="PreviewAddOcrRegionMenuItem_OnClick" />
                                            <MenuItem Header="OCRオーバーレイを表示"
                                                      Tag="ToggleOverlay"
                                                      IsCheckable="True"
                                                      Click="PreviewToggleOverlayMenuItem_OnClick" />
                                            <MenuItem Header="選択を解除"
                                                      Click="PreviewClearSelectionMenuItem_OnClick" />
                                            <Separator />
                                            <MenuItem Header="拡大"
                                                      InputGestureText="Ctrl++"
                                                      Click="PreviewZoomInMenuItem_OnClick" />
                                            <MenuItem Header="縮小"
                                                      InputGestureText="Ctrl+-"
                                                      Click="PreviewZoomOutMenuItem_OnClick" />
                                            <MenuItem Header="ページ幅に合わせる"
                                                      Click="PreviewFitWidthMenuItem_OnClick" />
                                            <MenuItem Header="100%で表示"
                                                      Command="{Binding ActualSizeCommand}" />
                                            <MenuItem Header="ページ高さに合わせる"
                                                      Click="PreviewFitHeightMenuItem_OnClick" />
                                            <MenuItem Header="ページ全体を表示"
                                                      Click="PreviewFitPageMenuItem_OnClick" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid Width="{Binding PreviewPixelWidth}" Height="{Binding PreviewPixelHeight}">
                                        <Grid.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}" />
                                        </Grid.LayoutTransform>
                                        <Image Source="{Binding PreviewImage, NotifyOnTargetUpdated=True}" TargetUpdated="PreviewImage_OnTargetUpdated"
                                               Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <ListBox x:Name="OverlayCanvas"
                                                 ItemsSource="{Binding OverlayItems}"
                                                 SelectionMode="Extended"
                                                 SelectionChanged="OverlayCanvas_OnSelectionChanged"
                                                 RequestBringIntoView="OverlayCanvas_OnRequestBringIntoView"
                                                 PreviewMouseLeftButtonDown="OverlayCanvas_OnPreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="OverlayCanvas_OnPreviewMouseMove"
                                                 PreviewMouseLeftButtonUp="OverlayCanvas_OnPreviewMouseLeftButtonUp"
                                                 Visibility="{Binding IsOcrOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox">
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddOcrRegionMode}" Value="True">
                                                            <Setter Property="Cursor" Value="Cross" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <EventSetter Event="RequestBringIntoView" Handler="OverlayCanvas_OnRequestBringIntoView" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="{Binding Width}" Height="{Binding Height}" RenderTransformOrigin="0.5,0.5">
                                                        <Grid.RenderTransform>
                                                            <RotateTransform Angle="{Binding RotationDegrees}" />
                                                        </Grid.RenderTransform>
                                                        <Grid.Resources>
                                                            <Style x:Key="ResizeHandleStyle" TargetType="Thumb">
                                                                <Setter Property="Width" Value="{Binding DataContext.ResizeHandleSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Setter Property="Height" Value="{Binding DataContext.ResizeHandleSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Setter Property="Background" Value="{Binding DataContext.ResizeHandleFillBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Setter Property="BorderBrush" Value="{Binding DataContext.ResizeHandleBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Setter Property="Opacity" Value="{Binding DataContext.ResizeHandleOpacity, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}" />
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="{Binding DataContext.InverseZoomFactor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                        ScaleY="{Binding DataContext.InverseZoomFactor, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <EventSetter Event="DragStarted" Handler="ResizeThumb_OnDragStarted" />
                                                                <EventSetter Event="DragDelta" Handler="ResizeThumb_OnDragDelta" />
                                                                <EventSetter Event="DragCompleted" Handler="ResizeThumb_OnDragCompleted" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                                            <Condition Binding="{Binding DataContext.IsLineEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                            <Style x:Key="RotationHandleStyle" TargetType="Thumb">
                                                                <Setter Property="Width" Value="15" />
                                                                <Setter Property="Height" Value="15" />
                                                                <Setter Property="Background" Value="#FFFFD400" />
                                                                <Setter Property="BorderBrush" Value="#FF7A5A00" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
