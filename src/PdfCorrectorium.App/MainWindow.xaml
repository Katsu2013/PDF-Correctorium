                <MenuItem Header="しおりをインポート...(_I)" Command="{Binding ImportBookmarksCommand}"  AutomationProperties.AccessKey="Alt+I"/>
                <MenuItem Header="しおりをエクスポート...(_E)" Command="{Binding ExportBookmarksCommand}"  AutomationProperties.AccessKey="Alt+E"/>
            </MenuItem>
            <MenuItem x:Name="OcrMenu" Header="OCR(_O)" IsEnabled="{Binding HasDocument}">
