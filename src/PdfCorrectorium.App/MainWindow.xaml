                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <icons:ActionIcon Key="LinkVisibility" Width="24" Height="24" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="リンク表示" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton kb:ToolbarItem.Key="main.linkMode" Click="LinkEditingMode_OnClick" IsChecked="{Binding IsLinkEditMode, Mode=OneWay}" IsEnabled="{Binding CanUsePreview}"
                                  Style="{StaticResource ToolbarIconToggleStyle}" ToolTip="リンクを選択・編集／文字・範囲から追加（Alt+Mからも選択可能）"
                                  AutomationProperties.Name="リンク編集モード">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <icons:ActionIcon Key="Link" Width="24" Height="24" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="リンク編集" />
                        </StackPanel>
                    </ToggleButton>
                    <ComboBox kb:ToolbarItem.Key="main.editorMode" x:Name="EditorModeSelector" IsEnabled="{Binding CanUsePreview}" Width="150" Margin="4,1" SelectedIndex="{Binding EditorModeIndex, Mode=TwoWay}" Style="{StaticResource BrandModeComboBoxStyle}" ToolTip="プレビュー上の操作モードを切り替えます" kb:KeyboardAccess.Key="M" AutomationProperties.Name="編集モード" AutomationProperties.AccessKey="Alt+M">
                        <ComboBoxItem Content="OCR編集" />
                        <ComboBoxItem Content="読み順編集" />
                        <ComboBoxItem Content="校正・確認" />
                        <ComboBoxItem Content="墨消し" />
                        <ComboBoxItem Content="リンク編集" />
