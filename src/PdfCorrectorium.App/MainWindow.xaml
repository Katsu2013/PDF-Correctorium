                                            <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.EqualizeCharacterAdvances}" />
