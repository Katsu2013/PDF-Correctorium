                                        <Button Command="{Binding VerifyAndNextCommand}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="選択領域を確認済みにして次の対象へ移動" AutomationProperties.Name="確認済みにして次へ"><StackPanel HorizontalAlignment="Center"><Viewbox Width="28" Height="28"><Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" Data="{StaticResource IconGeometry.Validate}" /></Viewbox><TextBlock Text="確認して次へ" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RibbonGroupBorderStyle}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="品質" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
