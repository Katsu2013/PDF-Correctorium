                            </ToolBarTray>
                            <TextBlock Text="枠内をドラッグすると移動できます。四隅または上下左右のハンドルをドラッグするとサイズを変更できます。編集内容はプロジェクトファイルへ保存されます。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0"
                                   Style="{StaticResource PropertyHelpTextStyle}" />
                            </StackPanel>
                            </Expander>
                            <Button icons:ActionIcon.Key="Delete" Content="選択OCR領域を削除"
                                Command="{Binding DeleteOcrRegionsCommand}" HorizontalAlignment="Stretch" Margin="0,12,0,4"
                                ToolTip="複数選択中は選択した領域をまとめて削除します。Undoで復元できます。" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
        <Border x:Name="PdfExportOverlay" Panel.ZIndex="1000"
                Background="#990F1720"
                Visibility="{Binding IsPdfExporting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- 日本語の文末だけが次行へ送られないよう、本文の有効幅を確保します。 -->
            <Border Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="PDFを生成・検証しています"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="編集中の変更を保護するため、完了するまでこの画面の操作を一時停止しています。出力先PDFをほかのアプリで開かずにお待ちください。"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,12,0,16" />
                    <ProgressBar Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BackgroundOperationProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsBackgroundOperationIndeterminate, Mode=OneWay}" />
                    <TextBlock x:Name="PdfExportProgressText" Text="{Binding BackgroundOperationMessage}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
