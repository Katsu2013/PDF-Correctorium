                                                        <DataTrigger Binding="{Binding DataContext.ShowOcrFrames, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                            <Setter TargetName="RotationConnector" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="RegionRotationHandle" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <!-- OCR領域に依存しない文書内／Webリンクのクリック範囲です。 -->
                                        <ItemsControl x:Name="LinkAreaOverlayLayer" ItemsSource="{Binding LinkAreaItems}" Panel.ZIndex="70"
