<Window x:Class="PdfCorrectorium.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfCorrectorium.App.ViewModels"
        xmlns:ocr="clr-namespace:PdfCorrectorium.App.Controls"
        xmlns:icons="clr-namespace:PdfCorrectorium.App.Resources"
        xmlns:avalonControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        Title="PDF Correctorium" Height="850" Width="1400" MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_OnPreviewKeyDown" Closing="MainWindow_OnClosing" xmlns:kb="clr-namespace:PdfCorrectorium.App.Services" KeyboardNavigation.TabNavigation="Cycle">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <kb:CompactPropertyColumnsConverter x:Key="CompactPropertyColumnsConverter" />
        <DataTemplate x:Key="CompactPropertyChoiceTemplate">
            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
        </DataTemplate>
        <Style x:Key="LinkResizeHandleStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="{DynamicResource LinkTextBrush}" /><Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource InputBrush}" BorderThickness="1" /></ControlTemplate></Setter.Value></Setter>
            <EventSetter Event="DragStarted" Handler="LinkResize_OnStarted" />
            <EventSetter Event="DragDelta" Handler="LinkResize_OnDelta" />
            <EventSetter Event="DragCompleted" Handler="LinkResize_OnCompleted" />
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsSelected}" Value="True" />
                <Condition Binding="{Binding DataContext.CanTransformSelectedLink, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="LinkOverlayTemplate">
            <Grid Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding ToolTip}"
                  MouseLeftButtonDown="LinkAreaOverlay_OnClick" MouseMove="LinkMove_OnMove" MouseLeftButtonUp="LinkMove_OnUp"
                  MouseRightButtonDown="LinkAreaOverlay_OnRightClick">
                <Grid.ContextMenu><ContextMenu>
                    <MenuItem icons:ActionIcon.Key="Link" Header="リンクを編集(_E)" Click="InternalLinkEdit_OnClick" IsEnabled="{Binding IsEditable}" />
                    <MenuItem icons:ActionIcon.Key="NextPage" Header="リンク先へ移動(_G)" Click="InternalLinkNavigate_OnClick" IsEnabled="{Binding IsEditable}" />
                    <MenuItem icons:ActionIcon.Key="Delete" Header="リンクを削除(_D)" Click="InternalLinkDelete_OnClick" IsEnabled="{Binding CanDelete}" />
                </ContextMenu></Grid.ContextMenu>
                <Border>
                    <Border.Style><Style TargetType="Border">
                        <Setter Property="Background" Value="#182563EB" /><Setter Property="BorderBrush" Value="{DynamicResource LinkTextBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExternal}" Value="True"><Setter Property="BorderBrush" Value="#7C3AED" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsEditable}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderThickness" Value="2" /><Setter Property="Background" Value="#402563EB" /></DataTrigger>
                        </Style.Triggers>
                    </Style></Border.Style>
                </Border>
                <Thumb Tag="NW" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource LinkResizeHandleStyle}" />
                <Thumb Tag="N" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource LinkResizeHandleStyle}" Cursor="SizeNS" />
                <Thumb Tag="NE" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource LinkResizeHandleStyle}" Cursor="SizeNESW" />
                <Thumb Tag="E" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource LinkResizeHandleStyle}" Cursor="SizeWE" />
                <Thumb Tag="SE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource LinkResizeHandleStyle}" />
                <Thumb Tag="S" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource LinkResizeHandleStyle}" Cursor="SizeNS" />
                <Thumb Tag="SW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource LinkResizeHandleStyle}" Cursor="SizeNESW" />
                <Thumb Tag="W" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource LinkResizeHandleStyle}" Cursor="SizeWE" />
            </Grid>
        </DataTemplate>
        <!--
            ツールバー共通の内側余白。
            ボタン種別ごとのスタイルから参照することで、余白を変更するときに
            複数のツールバーを個別修正しなくて済むようにする。
        -->
        <Thickness x:Key="ToolbarButtonPadding">2</Thickness>

        <!-- The stock AvalonDock anchorable template fixes its tabs below the content.
             Keep the stock item styles and commands; only exchange the header/content rows. -->
        <ControlTemplate x:Key="TopAvalonAnchorablePaneTemplate"
                         TargetType="{x:Type avalonControls:LayoutAnchorablePaneControl}">
            <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local"
                  SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Background="Transparent" />
                <avalonControls:AnchorablePaneTabPanel x:Name="HeaderPanel" Grid.Row="0"
                    Margin="2,2,2,0" Panel.ZIndex="1" IsItemsHost="True"
                    KeyboardNavigation.TabIndex="1" />
                <Border x:Name="ContentPanel" Grid.Row="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    KeyboardNavigation.TabIndex="2"
                    KeyboardNavigation.TabNavigation="Cycle">
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                        Margin="{TemplateBinding Padding}"
                        ContentSource="SelectedContent"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Border>
            </Grid>
        </ControlTemplate>

        <!-- Toolbar-only panes have their drag grip inside the toolbar content.  Do not
             reserve a second title/tab row, including after floating or re-docking. -->
        <ControlTemplate x:Key="ToolbarAvalonAnchorablePaneTemplate"
                         TargetType="{x:Type avalonControls:LayoutAnchorablePaneControl}">
            <DockPanel Background="{DynamicResource ToolbarBrush}" LastChildFill="True">
                <avalonControls:AnchorablePaneTitle x:Name="ToolbarDragTitle"
                    DockPanel.Dock="Left" Width="12" MinHeight="28"
                    Model="{Binding Model.SelectedContent, RelativeSource={RelativeSource TemplatedParent}}"
                    Cursor="SizeAll" ToolTip="ドラッグしてツールバーを移動">
                    <avalonControls:AnchorablePaneTitle.Template>
                        <ControlTemplate TargetType="{x:Type avalonControls:AnchorablePaneTitle}">
                            <Border Background="Transparent">
                                <Grid Width="6" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Ellipse Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <Ellipse Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Ellipse Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Ellipse Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                    <Ellipse Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </avalonControls:AnchorablePaneTitle.Template>
                </avalonControls:AnchorablePaneTitle>
                <ContentPresenter Content="{Binding Model.SelectedContent.Content, RelativeSource={RelativeSource TemplatedParent}}" />
            </DockPanel>
            <ControlTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Model.SelectedContent.IsFloating, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                        <Condition Binding="{Binding Model.SelectedContent.Parent.IsDirectlyHostedInFloatingWindow, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ToolbarDragTitle" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- The pane/tab containers keep AvalonDock's own drag handling.  Only their chrome
             follows the application's existing underline-tab treatment. -->
        <Style x:Key="AvalonPaneTabItemStyle" TargetType="TabItem"
               BasedOn="{StaticResource ModernTabItemStyle}">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="Padding" Value="10,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ContentId}" Value="main-toolbar">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContentId}" Value="page-toolbar">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A toolbar remains a ToolBar, not a panel-shaped strip.  AvalonDock's native
             AnchorablePaneTitle is retained as the small drag surface beside its buttons. -->
        <ControlTemplate x:Key="AvalonToolbarContentTemplate"
                         TargetType="{x:Type avalonControls:LayoutAnchorableControl}">
            <DockPanel LastChildFill="True" Background="{DynamicResource ToolbarBrush}">
                    <ContentPresenter Content="{Binding LayoutItem.View, RelativeSource={RelativeSource TemplatedParent}}"
                                      FlowDirection="{TemplateBinding FlowDirection}" />
            </DockPanel>
        </ControlTemplate>
        <ControlTemplate x:Key="AvalonVerticalToolbarContentTemplate"
                         TargetType="{x:Type avalonControls:LayoutAnchorableControl}">
            <DockPanel LastChildFill="True" Background="{DynamicResource ToolbarBrush}">
                    <ContentPresenter Content="{Binding LayoutItem.View, RelativeSource={RelativeSource TemplatedParent}}"
                                      FlowDirection="{TemplateBinding FlowDirection}" />
            </DockPanel>
        </ControlTemplate>

        <Style TargetType="ToolBarTray">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
        </Style>
        <Style TargetType="ToolBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="MinWidth" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Style.Triggers>
                <!-- アイコンのみの表示では、余白を詰めた正方形に固定する。 -->
                <DataTrigger Binding="{Binding DataContext.ShowToolbarText, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Width" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarIconToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="ToggleChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Border x:Name="ActiveRail" Height="2" Background="{DynamicResource AccentFillBrush}"
                                    VerticalAlignment="Bottom" Margin="4,0" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ActiveRail" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleChrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- アイコンのみの表示では、通常ボタンと同じ正方形に固定する。 -->
                <DataTrigger Binding="{Binding DataContext.ShowToolbarText, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Width" Value="{Binding DataContext.CompactToolbarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarIconViewboxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="{Binding DataContext.ToolbarIconSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.ToolbarIconSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="Both" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Visibility" Value="{Binding DataContext.ShowToolbarText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Style>
        <Style x:Key="PropertyIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <!-- 24pxアイコンとキーボードフォーカス時の2px枠を収める。 -->
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

        <!-- Help is shared by every property mode, independent of state/error messages. -->
        <Style x:Key="PropertyHelpTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Visibility" Value="{Binding ShowPropertyHelpText, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Style>
        <Style x:Key="PropertyHelpBorderStyle" TargetType="Border">
            <Setter Property="Visibility" Value="{Binding ShowPropertyHelpText, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Style>
        <Style x:Key="PropertyTextActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="1,2" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <!-- 左ペインの小型操作ボタンは、文字記号ではなくベクターアイコンを使う。
             OSのフォント構成や高DPI倍率に左右されず、常に同じ形で表示するための共通スタイル。 -->
        <Style x:Key="LeftPaneIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <Style x:Key="LeftPaneIconViewboxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="Both" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- タブと切替ボタンの外観は App.xaml の共通スタイルを使用する。 -->
        <Style x:Key="PageListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 共通スタイルに別名を付け、既存の画面内参照を維持する。 -->
        <Style x:Key="ToolbarComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ModernComboBoxItemStyle}" />
        <Style x:Key="RoundedToolbarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ToolbarComboBoxItemStyle}" />
        </Style>
        <Style x:Key="BrandModeComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource RoundedToolbarComboBoxStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PaneTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:BookmarkNodeViewModel}" ItemsSource="{Binding Children}">
            <DockPanel ToolTip="{Binding PageNumber, StringFormat=ページ {0}}" LastChildFill="True">
                <Viewbox Width="13" Height="16" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Path Fill="Transparent"
                          Stroke="{DynamicResource SecondaryTextBrush}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round"
                          Data="{StaticResource IconGeometry.Bookmark}" />
                </Viewbox>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PageNumber, StringFormat=  p.{0}}" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Normal" VerticalAlignment="Center" />
                <Grid MinWidth="70">
                    <TextBlock x:Name="BookmarkTitleText"
                               Text="{Binding Title}"
                               Padding="2,1"
                               FontWeight="Normal"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="BookmarkTitleEditor"
                             Tag="BookmarkTitleEditor"
                             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Visibility="Collapsed"
                             Padding="2,0"
                             FontWeight="Normal"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="BookmarkTitleEditor_OnPreviewKeyDown"
                             LostKeyboardFocus="BookmarkTitleEditor_OnLostKeyboardFocus" />
                </Grid>
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="BookmarkTitleText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BookmarkTitleEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel x:Name="MainWorkspaceDock" KeyboardNavigation.TabNavigation="Local">
        <Menu DockPanel.Dock="Top" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource PrimaryTextBrush}" KeyboardNavigation.TabIndex="0">
            <MenuItem Header="ファイル(_F)" SubmenuOpened="FileMenu_OnSubmenuOpened">
                <MenuItem Header="PDFを開く...(_O)" icons:ActionIcon.Key="OpenPdf" Command="{Binding OpenPdfCommand}" InputGestureText="Ctrl+O"  AutomationProperties.AccessKey="Alt+O"/>
                <MenuItem Header="プロジェクトを開く...(_P)" icons:ActionIcon.Key="OpenProject" Command="{Binding OpenProjectCommand}"  AutomationProperties.AccessKey="Alt+P"/>
                <MenuItem x:Name="RecentFilesMenuItem" Header="最近開いたファイル(_R)" AutomationProperties.AccessKey="Alt+R"
                          ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding CanOpenRecentFiles}"
                          ToolTip="最近開いたPDF・プロジェクトを開きます。表示件数と履歴クリアは設定画面で変更できます。"
                          ToolTipService.ShowOnDisabled="True">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="ToolTip" Value="{Binding FullPath}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding FullPath}" />
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" MaxWidth="600" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="NDLOCR-Liteデータを読み込む...(_I)" icons:ActionIcon.Key="ImportOcr" Command="{Binding ImportOcrDataCommand}"  AutomationProperties.AccessKey="Alt+I"/>
<MenuItem icons:ActionIcon.Key="DocumentProperties" x:Name="DocumentPropertiesMenuItem" Header="文書のプロパティ...(_D)" IsEnabled="{Binding HasDocument}" Click="DocumentPropertiesMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+D"/>
                <Separator />
                <MenuItem Header="プロジェクトを上書き保存(_S)" icons:ActionIcon.Key="SaveProject" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"  AutomationProperties.AccessKey="Alt+S"/>
                <MenuItem Header="プロジェクトを別名で保存...(_A)" icons:ActionIcon.Key="SaveProject" Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S"  AutomationProperties.AccessKey="Alt+A"/>
                <MenuItem Header="編集済みPDFを別名で出力...(_E)" icons:ActionIcon.Key="ExportPdf" Command="{Binding ExportPdfCommand}"  AutomationProperties.AccessKey="Alt+E"/>
                <MenuItem Header="作業データ・ページ画像の出力(_W)" IsEnabled="{Binding CanEditDocument}">
                    <MenuItem Header="OCR作業文字（TXT）...(_T)" icons:ActionIcon.Key="Export" Tag="0" Click="DocumentDataExport_OnClick" />
                    <MenuItem Header="コメント一覧（CSV）...(_C)" icons:ActionIcon.Key="Export" Tag="1" Click="DocumentDataExport_OnClick" />
