                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- 墨消しモード -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRedactionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource RibbonGroupBorderStyle}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="墨消し範囲" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel VerticalAlignment="Center" Margin="2,0,6,0">
                                            <TextBlock Text="指定方法" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,2" />
                                            <ComboBox SelectedIndex="{Binding RedactionInputModeIndex, Mode=TwoWay}" Width="130" Height="28" ToolTip="墨消し範囲の指定方法" AutomationProperties.Name="墨消し範囲の指定方法">
                                                <ComboBoxItem Content="PDF文字を選択" /><ComboBoxItem Content="矩形" /><ComboBoxItem Content="多角形" /><ComboBoxItem Content="フリーハンド" />
                                            </ComboBox>
                                        </StackPanel>
                                        <Button Command="{Binding AddSelectedRedactionsCommand}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="事前に選択した文字・OCR領域を墨消し" AutomationProperties.Name="選択範囲を墨消し"><StackPanel HorizontalAlignment="Center"><Border Width="28" Height="18" Background="#263746" CornerRadius="2" Margin="0,5,0,8" /><TextBlock Text="選択を墨消し" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Button>
                                        <Button Command="{Binding DeleteSelectedRedactionCommand}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="選択中の墨消し範囲を削除" AutomationProperties.Name="選択中の墨消し範囲を削除"><StackPanel HorizontalAlignment="Center"><Viewbox Width="28" Height="28"><Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" Data="{StaticResource IconGeometry.Delete}" /></Viewbox><TextBlock Text="範囲を削除" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Button>
                                        <Button Command="{Binding ClearCurrentPageRedactionsCommand}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="このページの墨消し範囲をすべて解除" AutomationProperties.Name="このページの墨消しをすべて解除"><StackPanel HorizontalAlignment="Center"><Viewbox Width="28" Height="28"><Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" Data="{StaticResource IconGeometry.Recovery}" /></Viewbox><TextBlock Text="ページ内を解除" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 【表示・検証】タブ -->
                <TabItem Header="表示・検証" Style="{StaticResource RibbonTabItemStyle}" AutomationProperties.Name="表示・検証" kb:KeyboardAccess.Key="V">
                    <StackPanel Orientation="Horizontal" Height="98" VerticalAlignment="Top">
                        <!-- サイドバー表示グループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="サイドバー表示" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton IsChecked="{Binding ShowPageListPanel, Mode=TwoWay}" Style="{StaticResource RibbonSmallToggleStyle}" Width="100">
                                            <TextBlock Text="ページ一覧" FontSize="11" Margin="4,0,0,0" />
                                        </ToggleButton>
                                        <ToggleButton IsChecked="{Binding ShowPropertiesPanel, Mode=TwoWay}" Style="{StaticResource RibbonSmallToggleStyle}" Width="100">
                                            <TextBlock Text="OCRプロパティ" FontSize="11" Margin="4,0,0,0" />
                                        </ToggleButton>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <ToggleButton IsChecked="{Binding ShowStatusBar, Mode=TwoWay}" Style="{StaticResource RibbonSmallToggleStyle}" Width="100">
                                            <TextBlock Text="ステータスバー" FontSize="11" Margin="4,0,0,0" />
                                        </ToggleButton>
                                        <ToggleButton IsChecked="{Binding ShowPropertyHelpText, Mode=TwoWay}" Style="{StaticResource RibbonSmallToggleStyle}" Width="100">
                                            <TextBlock Text="プロパティ説明" FontSize="11" Margin="4,0,0,0" />
                                        </ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- ページレイアウトグループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="ページレイアウト" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <ComboBox ItemsSource="{Binding DocumentViewModeOptions}" SelectedItem="{Binding SelectedDocumentViewModeOption, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" Width="132" Height="28" Margin="0,0,0,4"
                                              IsEnabled="{Binding HasDocument}" Style="{StaticResource RoundedToolbarComboBoxStyle}" ToolTip="{Binding DocumentViewModeDescription}" />
                                    <ComboBox ItemsSource="{Binding DocumentPageFlowModeOptions}" SelectedItem="{Binding SelectedDocumentPageFlowModeOption, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" Width="132" Height="28"
                                              IsEnabled="{Binding HasDocument}" Style="{StaticResource RoundedToolbarComboBoxStyle}" ToolTip="ページ切り替え／連続スクロール" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 見開き詳細グループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}" IsEnabled="{Binding IsFacingPagesView}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="見開きの詳細" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel VerticalAlignment="Center">
                                    <ToggleButton IsChecked="{Binding FacingPagesShowCoverSeparately, Mode=TwoWay}" Style="{StaticResource RibbonSmallToggleStyle}" Width="146" ToolTip="見開き表示で表紙を片側へ単独表示" AutomationProperties.Name="表紙を単独表示">
                                        <TextBlock Text="表紙を単独表示" FontSize="12" />
                                    </ToggleButton>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton IsChecked="{Binding IsFacingPagesLeftBinding, Mode=TwoWay}" Style="{StaticResource RibbonSmallToggleStyle}" Width="72" ToolTip="左綴じとしてページを配置" AutomationProperties.Name="左綴じ"><TextBlock Text="左綴じ" FontSize="12" /></ToggleButton>
                                        <ToggleButton IsChecked="{Binding IsFacingPagesRightBinding, Mode=TwoWay}" Style="{StaticResource RibbonSmallToggleStyle}" Width="72" ToolTip="右綴じとしてページを配置" AutomationProperties.Name="右綴じ"><TextBlock Text="右綴じ" FontSize="12" /></ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 品質・文書情報グループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="品質・文書情報" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="OcrQualityAnalysisMenuItem_OnClick" IsEnabled="{Binding HasDocument}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="OCR品質の候補を文書全体から確認" AutomationProperties.Name="OCR品質チェック">
                                        <StackPanel HorizontalAlignment="Center"><Viewbox Width="28" Height="28" Margin="0,2"><Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" Data="{StaticResource IconGeometry.QualityCheck}" /></Viewbox><TextBlock Text="OCR品質" FontSize="12" /></StackPanel>
                                    </Button>
                                    <Button Click="DocumentPropertiesMenuItem_OnClick" IsEnabled="{Binding HasDocument}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="文書のプロパティを表示・編集" AutomationProperties.Name="文書のプロパティ">
                                        <StackPanel HorizontalAlignment="Center"><Viewbox Width="28" Height="28" Margin="0,2"><Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" Data="{StaticResource IconGeometry.DocumentProperties}" /></Viewbox><TextBlock Text="文書情報" FontSize="12" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 検証・保守グループ -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="検証・保守" Style="{StaticResource RibbonGroupTitleStyle}" DockPanel.Dock="Bottom" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="ValidateProjectMenuItem_OnClick" IsEnabled="{Binding HasDocument}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="現在のプロジェクトを検証" AutomationProperties.Name="プロジェクト検証">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Validate}" />
                                            </Viewbox>
                                            <TextBlock Text="プロジェクト検証" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="RestoreProjectMenuItem_OnClick" IsEnabled="{Binding CanRestoreProjectBackup}" Style="{StaticResource RibbonBigButtonStyle}" ToolTip="バックアップから復旧" AutomationProperties.Name="バックアップから復旧">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,2,0,2">
                                                <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.Recovery}" />
                                            </Viewbox>
                                            <TextBlock Text="バックアップ復旧" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Margin="2,0,0,0">
                                        <Button Click="OpenLogFolderMenuItem_OnClick" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="ログフォルダーを開く">
                                            <TextBlock Text="ログフォルダー" FontSize="11" />
                                        </Button>
                                        <Button Click="AboutMenuItem_OnClick" Style="{StaticResource RibbonSmallButtonStyle}" ToolTip="バージョン情報">
                                            <TextBlock Text="バージョン情報" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- === クラシック メニュー＆ツールバー（UIモード切替で表示） === -->
        <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsClassicUiMode, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Menu DockPanel.Dock="Top" Background="White" Foreground="{StaticResource PrimaryTextBrush}" KeyboardNavigation.TabIndex="0">
            <MenuItem Header="ファイル(_F)" SubmenuOpened="FileMenu_OnSubmenuOpened">
                <MenuItem Header="PDFを開く...(_O)" Command="{Binding OpenPdfCommand}" InputGestureText="Ctrl+O"  AutomationProperties.AccessKey="Alt+O"/>
                <MenuItem Header="プロジェクトを開く...(_P)" Command="{Binding OpenProjectCommand}"  AutomationProperties.AccessKey="Alt+P"/>
                <MenuItem x:Name="RecentFilesMenuItem" Header="最近開いたファイル(_R)" AutomationProperties.AccessKey="Alt+R"
                          ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding CanOpenRecentFiles}"
                          ToolTip="最近開いたPDF・プロジェクトを開きます。表示件数と履歴クリアは設定画面で変更できます。"
                          ToolTipService.ShowOnDisabled="True">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="ToolTip" Value="{Binding FullPath}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding FullPath}" />
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" MaxWidth="600" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="NDLOCR-Liteデータを読み込む...(_I)" Command="{Binding ImportOcrDataCommand}"  AutomationProperties.AccessKey="Alt+I"/>
                <MenuItem x:Name="DocumentPropertiesMenuItem" Header="文書のプロパティ...(_D)" IsEnabled="{Binding HasDocument}" Click="DocumentPropertiesMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+D"/>
                <Separator />
                <MenuItem Header="プロジェクトを上書き保存(_S)" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"  AutomationProperties.AccessKey="Alt+S"/>
                <MenuItem Header="プロジェクトを別名で保存...(_A)" Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S"  AutomationProperties.AccessKey="Alt+A"/>
                <MenuItem Header="編集済みPDFを別名で出力...(_E)" Command="{Binding ExportPdfCommand}"  AutomationProperties.AccessKey="Alt+E"/>
                <Separator />
                <MenuItem Header="終了(_X)" Command="{Binding ExitCommand}"  AutomationProperties.AccessKey="Alt+X"/>
            </MenuItem>
            <MenuItem Header="編集(_E)" AutomationProperties.AccessKey="Alt+E">
                <MenuItem Header="元に戻す(_U)" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"  AutomationProperties.AccessKey="Alt+U"/>
                <MenuItem Header="やり直す(_R)" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}"  AutomationProperties.AccessKey="Alt+R"/>
                <Separator />
                <MenuItem x:Name="FindOcrTextMenuItem" Header="透明テキストを検索...(_F)" IsEnabled="{Binding HasDocument}" InputGestureText="Ctrl+F" Click="FindOcrTextMenuItem_OnClick" />
                <MenuItem x:Name="ReplaceOcrTextMenuItem" Header="透明テキストを置換...(_H)" IsEnabled="{Binding HasDocument}" InputGestureText="Ctrl+H" Click="ReplaceOcrTextMenuItem_OnClick"  AutomationProperties.AccessKey="Alt+H"/>
                <Separator />
                <MenuItem Header="コメントとタグ...(_C)" IsEnabled="{Binding HasDocument}" Click="CommentsAndTags_OnClick" AutomationProperties.AccessKey="Alt+C" />
                <MenuItem x:Name="RedactionMenuItem" Header="墨消し(_D)" IsEnabled="{Binding HasDocument}" AutomationProperties.AccessKey="Alt+D">
                    <MenuItem Header="墨消しモードへ切り替え(_M)" Command="{Binding ActivateRedactionModeCommand}"
                              IsCheckable="True" IsChecked="{Binding IsRedactionMode, Mode=OneWay}" AutomationProperties.AccessKey="Alt+M" />
                    <MenuItem Header="選択文字・領域を墨消し(_S)" Command="{Binding AddSelectedRedactionsCommand}" AutomationProperties.AccessKey="Alt+S" />
                    <MenuItem Header="選択中の墨消し範囲を削除(_R)" Command="{Binding DeleteSelectedRedactionCommand}" AutomationProperties.AccessKey="Alt+R" />
                    <MenuItem Header="このページの墨消しを解除(_C)" Command="{Binding ClearCurrentPageRedactionsCommand}" AutomationProperties.AccessKey="Alt+C" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ApplicationSettingsMenuItem" Header="設定...(_P)" Click="ApplicationSettingsMenuItem_OnClick" />
            </MenuItem>
            <MenuItem x:Name="ViewMenu" Header="表示(_V)">
                <MenuItem Header="ページ一覧(_P)"
                          IsCheckable="True"
                          IsChecked="{Binding ShowPageListPanel, Mode=TwoWay}"  AutomationProperties.AccessKey="Alt+P"/>
                <MenuItem Header="OCRプロパティ(_O)"
                          IsCheckable="True"
                          IsChecked="{Binding ShowPropertiesPanel, Mode=TwoWay}"  AutomationProperties.AccessKey="Alt+O"/>
                <MenuItem Header="ステータスバー(_S)"
                          IsCheckable="True"
                          IsChecked="{Binding ShowStatusBar, Mode=TwoWay}"  AutomationProperties.AccessKey="Alt+S"/>
                <Separator />
                <MenuItem Header="ページ表示(_L)" IsEnabled="{Binding HasDocument}" AutomationProperties.AccessKey="Alt+L">
                    <MenuItem Header="ページ配置(_A)" AutomationProperties.AccessKey="Alt+A">
                        <MenuItem Header="単一ページ(_1)" IsCheckable="True" IsChecked="{Binding IsSinglePageView, Mode=TwoWay}" AutomationProperties.AccessKey="Alt+1" />
                        <MenuItem Header="見開き(_F)" IsCheckable="True" IsChecked="{Binding IsFacingPagesView, Mode=TwoWay}" AutomationProperties.AccessKey="Alt+F" />
                    </MenuItem>
                    <MenuItem Header="スクロール方式(_S)" AutomationProperties.AccessKey="Alt+S">
                        <MenuItem Header="ページ切り替え(_P)" IsCheckable="True" IsChecked="{Binding IsPageByPageView, Mode=TwoWay}" AutomationProperties.AccessKey="Alt+P" />
                        <MenuItem Header="連続スクロール(_C)" IsCheckable="True" IsChecked="{Binding IsContinuousView, Mode=TwoWay}" AutomationProperties.AccessKey="Alt+C" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="見開き表示の設定(_G)" IsEnabled="{Binding IsFacingPagesView}" AutomationProperties.AccessKey="Alt+G">
                        <MenuItem Header="表紙を単独表示(_C)" IsCheckable="True"
                                  IsChecked="{Binding FacingPagesShowCoverSeparately, Mode=TwoWay}"
                                  AutomationProperties.AccessKey="Alt+C" />
                        <Separator />
                        <MenuItem Header="左綴じ(_L)" IsCheckable="True"
                                  IsChecked="{Binding IsFacingPagesLeftBinding, Mode=TwoWay}"
                                  AutomationProperties.AccessKey="Alt+L" />
                        <MenuItem Header="右綴じ(_R)" IsCheckable="True"
                                  IsChecked="{Binding IsFacingPagesRightBinding, Mode=TwoWay}"
                                  AutomationProperties.AccessKey="Alt+R" />
                    </MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem Header="プロパティの詳しい説明(_H)"
                          IsCheckable="True"
                          IsChecked="{Binding ShowPropertyHelpText, Mode=TwoWay}"  AutomationProperties.AccessKey="Alt+H"/>
                <Separator />
                <MenuItem Header="リボン表示へ切り替え(_B)" Command="{Binding ToggleRibbonUiModeCommand}" AutomationProperties.AccessKey="Alt+B" />
            </MenuItem>
            <MenuItem x:Name="BookmarkMenu" Header="しおり(_B)" IsEnabled="{Binding HasDocument}">
                <MenuItem Header="現在のページにしおりを追加(_A)" Command="{Binding AddBookmarkCommand}"  AutomationProperties.AccessKey="Alt+A"/>
