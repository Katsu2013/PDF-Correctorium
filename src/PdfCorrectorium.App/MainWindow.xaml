                                 AutomationProperties.Name="現在のページ番号"
                                 GotKeyboardFocus="ToolbarPageNumberBox_OnGotKeyboardFocus"
                                 PreviewKeyDown="ToolbarPageNumberBox_OnPreviewKeyDown"
                                 LostKeyboardFocus="ToolbarPageNumberBox_OnLostKeyboardFocus" kb:KeyboardAccess.Key="J" AutomationProperties.AccessKey="Alt+J"/>
                        <TextBlock x:Name="ToolbarPageNumberSeparator" Text=" / " VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock x:Name="ToolbarPageCount" Text="{Binding PageItems.Count}" MinWidth="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button kb:ToolbarItem.Key="page.next" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="次のページ">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.NextPage}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="次へ" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="4,0" />
                    <Button kb:ToolbarItem.Key="page.zoomOut" Command="{Binding ZoomOutCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="縮小">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.ZoomOut}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="縮小" />
                        </StackPanel>
                    </Button>
                    <Button kb:ToolbarItem.Key="page.zoomIn" Command="{Binding ZoomInCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="拡大">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.ZoomIn}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="拡大" />
                        </StackPanel>
                    </Button>
                    <Button kb:ToolbarItem.Key="page.fitWidth" Click="FitWidthButton_OnClick" IsEnabled="{Binding CanUsePreview}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="ページ幅に合わせる">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.FitWidth}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="幅に合わせる" />
                        </StackPanel>
                    </Button>
                    <Button kb:ToolbarItem.Key="page.actualSize" Command="{Binding ActualSizeCommand}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="実際のサイズ（100%）で表示" AutomationProperties.Name="100%で表示">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.ActualSize}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="100%" />
                        </StackPanel>
                    </Button>
                    <Button kb:ToolbarItem.Key="page.fitHeight" Click="FitHeightButton_OnClick" IsEnabled="{Binding CanUsePreview}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="ページ高さに合わせる（上下ぴったり）">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.FitHeight}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="高さに合わせる" />
                        </StackPanel>
                    </Button>
                    <Button kb:ToolbarItem.Key="page.fitPage" Click="FitPageButton_OnClick" IsEnabled="{Binding CanUsePreview}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="ページ全体を表示">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.FitPage}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="ページ全体" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="4,0" />
                    <RadioButton kb:ToolbarItem.Key="page.single" x:Name="SinglePageToolbarButton" GroupName="PageLayout" IsEnabled="{Binding HasDocument}"
                                  IsChecked="{Binding IsSinglePageView, Mode=TwoWay}"
                                  Style="{StaticResource ToolbarIconToggleStyle}" ToolTip="単一ページ表示"
                                  kb:KeyboardAccess.Key="N" AutomationProperties.Name="単一ページ表示" AutomationProperties.AccessKey="Alt+N">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="15" Height="19" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" BorderThickness="1.5" CornerRadius="1" Margin="2" />
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="単一" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton kb:ToolbarItem.Key="page.facing" x:Name="FacingPagesToolbarButton" GroupName="PageLayout" IsEnabled="{Binding HasDocument}"
                                  IsChecked="{Binding IsFacingPagesView, Mode=TwoWay}"
                                  Style="{StaticResource ToolbarIconToggleStyle}" ToolTip="見開き表示"
                                  kb:KeyboardAccess.Key="2" AutomationProperties.Name="見開き表示" AutomationProperties.AccessKey="Alt+2">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24" ClipToBounds="True">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.FacingPages}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="見開き" />
                        </StackPanel>
                    </RadioButton>
                    <Separator Margin="4,0" />
                    <ToggleButton kb:ToolbarItem.Key="page.continuous" x:Name="ContinuousScrollToolbarButton" IsEnabled="{Binding HasDocument}"
                                  IsChecked="{Binding IsContinuousView, Mode=TwoWay}"
                                  Style="{StaticResource ToolbarIconToggleStyle}" ToolTip="連続スクロール。オフではページごとに切り替え"
                                  kb:KeyboardAccess.Key="3" AutomationProperties.Name="連続スクロール" AutomationProperties.AccessKey="Alt+3">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24" ClipToBounds="True">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.ContinuousScroll}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="連続スクロール" />
                        </StackPanel>
                    </ToggleButton>
                </ToolBar>
            </ToolBarTray>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                   Visibility="{Binding ShowStatusBar, Converter={StaticResource BooleanToVisibilityConverter}}" KeyboardNavigation.TabIndex="9000" KeyboardNavigation.TabNavigation="Local">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <Separator DockPanel.Dock="Right" >
            </Separator>
            <StatusBarItem DockPanel.Dock="Right" IsEnabled="{Binding CanUsePreview}" ToolTip="表示倍率。－/＋、スライダー、または倍率表示から変更できます。" Padding="2,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StatusZoomOutButton" Command="{Binding ZoomOutCommand}" Style="{StaticResource FlatStatusBarButtonStyle}" ToolTip="縮小" AutomationProperties.Name="縮小">
                        <Viewbox Width="12" Height="12">
                            <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.Minus}" Height="24" Width="24" />
                        </Viewbox>
                    </Button>
                    <!-- 中央の位置50を100%とし、左右で倍率の変化量を変える。 -->
                    <Slider x:Name="StatusZoomSlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="False"
                            Style="{StaticResource CenteredZoomSliderStyle}" IsMoveToPointEnabled="True"
                            SmallChange="1" LargeChange="10"
                            Value="{Binding ZoomSliderPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{Binding ZoomDisplay}" AutomationProperties.Name="表示倍率"
                            AutomationProperties.HelpText="{Binding ZoomDisplay}"
                            Width="92" Margin="2,0" VerticalAlignment="Center">
                        <Slider.CommandBindings>
                            <CommandBinding Command="Slider.IncreaseSmall" Executed="StatusZoomSlider_OnChangeZoom" CanExecute="StatusZoomSlider_OnCanChangeZoom" />
                            <CommandBinding Command="Slider.DecreaseSmall" Executed="StatusZoomSlider_OnChangeZoom" CanExecute="StatusZoomSlider_OnCanChangeZoom" />
                            <CommandBinding Command="Slider.IncreaseLarge" Executed="StatusZoomSlider_OnChangeZoom" CanExecute="StatusZoomSlider_OnCanChangeZoom" />
                            <CommandBinding Command="Slider.DecreaseLarge" Executed="StatusZoomSlider_OnChangeZoom" CanExecute="StatusZoomSlider_OnCanChangeZoom" />
                        </Slider.CommandBindings>
                    </Slider>
                    <Button x:Name="StatusZoomInButton" Command="{Binding ZoomInCommand}" Style="{StaticResource FlatStatusBarButtonStyle}" ToolTip="拡大" AutomationProperties.Name="拡大">
                        <Viewbox Width="12" Height="12">
                            <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconGeometry.Plus}" />
                        </Viewbox>
                    </Button>
                    <ComboBox x:Name="StatusZoomComboBox"
                              Text="{Binding ZoomDisplay, Mode=OneWay}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              Width="70" Height="20" MinHeight="20" Padding="6,0,24,0" Margin="2,0,0,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="StatusZoomComboBox_OnSelectionChanged"
                              PreviewKeyDown="StatusZoomComboBox_OnPreviewKeyDown"
                              LostKeyboardFocus="StatusZoomComboBox_OnLostKeyboardFocus"
                              ToolTip="倍率を入力するか、一覧から倍率・表示方法を選択します" kb:KeyboardAccess.Key="Z" AutomationProperties.Name="表示倍率" AutomationProperties.AccessKey="Alt+Z">
                        <ComboBoxItem Content="25%" Tag="25" />
                        <ComboBoxItem Content="50%" Tag="50" />
                        <ComboBoxItem Content="75%" Tag="75" />
                        <ComboBoxItem Content="100%" Tag="100" />
                        <ComboBoxItem Content="125%" Tag="125" />
                        <ComboBoxItem Content="150%" Tag="150" />
                        <ComboBoxItem Content="200%" Tag="200" />
                        <ComboBoxItem Content="300%" Tag="300" />
                        <ComboBoxItem Content="400%" Tag="400" />
                        <Separator />
                        <ComboBoxItem Content="ページ幅" Tag="FitWidth" />
                        <ComboBoxItem Content="ページ高さ" Tag="FitHeight" />
                        <ComboBoxItem Content="ページ全体" Tag="FitPage" />
                        <ComboBoxItem Content="選択範囲" Tag="FitSelection" />
                    </ComboBox>
                </StackPanel>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" >
            </Separator>
            <StatusBarItem x:Name="ProjectStorageModeStatusItem"
                           DockPanel.Dock="Right"
                           Content="{Binding ProjectStorageModeStatusText}"
                           Visibility="{Binding HasDocument, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Separator DockPanel.Dock="Right" >
            </Separator>
            <StatusBarItem x:Name="BackgroundProgressStatusItem" DockPanel.Dock="Right"
                           Padding="4,0"
                           Visibility="{Binding ShowBackgroundOperationInStatusBar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="96" Height="8" Margin="0,0,5,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding BackgroundOperationProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsBackgroundOperationIndeterminate, Mode=OneWay}" />
                    <TextBlock Text="{Binding BackgroundOperationMessage, Mode=OneWay}"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"
                       Visibility="{Binding ShowBackgroundOperationInStatusBar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StatusBarItem x:Name="DocumentLoadingStatusItem" DockPanel.Dock="Right" Padding="4,0"
                           ToolTip="{Binding DocumentLoadingSummary}"
                           Visibility="{Binding IsDocumentLoadingProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="DocumentLoadingProgressBar" Width="64" Height="8" Margin="0,0,5,0"
                                 Minimum="0" Maximum="100" Value="{Binding DocumentLoadingProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsDocumentLoadingProgressIndeterminate}" />
                    <TextBlock Text="{Binding DocumentLoadingStatusText}" MaxWidth="190" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Padding="2,0"
                           Visibility="{Binding IsRapidOcrRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="再認識を中止" icons:ActionIcon.Key="Stop" Click="CancelRecognizeLine_OnClick"
                        Padding="4,0" Height="22" MinHeight="0" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Padding="4,0">
                <TextBlock Text="{Binding LexiconPreparationStatus}" MaxWidth="210" TextTrimming="CharacterEllipsis" ToolTip="{Binding LexiconPreparationStatus}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsBackgroundOperationVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsDocumentLoadingProgressVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem x:Name="GeneralStatusItem" Content="{Binding StatusMessageDisplay}" />
        </StatusBar>

        <Border x:Name="BottomToolbarHost" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <ToolBarTray x:Name="BottomToolBarTray" IsLocked="False" Orientation="Horizontal" />
        </Border>
        <Border x:Name="LeftToolbarHost" DockPanel.Dock="Left" Visibility="Collapsed" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <ToolBarTray x:Name="LeftToolBarTray" IsLocked="False" Orientation="Vertical" />
        </Border>
        <Border x:Name="RightToolbarHost" DockPanel.Dock="Right" Visibility="Collapsed" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <ToolBarTray x:Name="RightToolBarTray" IsLocked="False" Orientation="Vertical" />
        </Border>

        <Grid x:Name="WorkspaceLayoutGrid" KeyboardNavigation.TabIndex="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding PageListColumnWidth}" />
                <ColumnDefinition Width="{Binding PageListSplitterWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding PropertiesPanelSplitterWidth}" />
                <ColumnDefinition Width="{Binding PropertiesPanelColumnWidth}" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavigationDockPane" Grid.Column="0" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="4,6">
                <DockPanel Margin="0" KeyboardNavigation.TabNavigation="Local">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10" KeyboardNavigation.TabIndex="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ページ一覧" Style="{StaticResource PaneTitleStyle}" />
<ToggleButton icons:ActionIcon.Key="Thumbnail" Grid.Column="1"
                                      Content="サムネイル"
                                      IsChecked="{Binding ShowPageThumbnails, Mode=TwoWay}"
                                      Padding="7,3"
                                      ToolTip="ページ画像の表示をオン／オフします" />
                            </Grid>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="3" Margin="0,0,0,8" KeyboardNavigation.TabIndex="1">
                                <DockPanel LastChildFill="True" KeyboardNavigation.TabNavigation="Local">
                                    <ToolBarTray DockPanel.Dock="Top" IsLocked="True" HorizontalAlignment="Stretch" KeyboardNavigation.TabIndex="0">
                                        <ToolBar x:Name="PageCommandToolBar" Band="0" BandIndex="0" HorizontalAlignment="Stretch">
                                        <Button Command="{Binding InsertPagesCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページの後へPDFページを追加">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Canvas Width="24" Height="24" ClipToBounds="True">
                                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconGeometry.PageInsert}" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                        <Button Command="{Binding DeletePagesCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページを削除">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageDelete}" >
                                                    <Path.Fill>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                        </Button>
                                        <Separator Width="4" />
                                        <Button Command="{Binding RotatePagesLeftCommand}" Style="{StaticResource LeftPaneIconButtonStyle}" ToolTip="選択ページを左へ90°回転">
                                            <Viewbox Style="{StaticResource LeftPaneIconViewboxStyle}">
                                                <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PageRotateLeft}" >
                                                    <Path.Fill>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                        </Button>
