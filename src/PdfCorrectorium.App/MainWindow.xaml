                <MenuItem Header="選択ページを左へ90°回転(_L)" Command="{Binding RotatePagesLeftCommand}"  AutomationProperties.AccessKey="Alt+L"/>
                <MenuItem Header="選択ページを右へ90°回転(_R)" Command="{Binding RotatePagesRightCommand}"  AutomationProperties.AccessKey="Alt+R"/>
                <Separator />
                <MenuItem Header="{Binding CurrentPageImageOptimizationActionText}"
                          Command="{Binding OptimizeCurrentPageImageCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding IsCurrentPageImageOptimizationEnabled, Mode=OneWay}"
                          ToolTip="ページサイズと内容位置を保ったまま、全面画像の四辺余白、中央空白帯、単一色背景を削減します" />
                <MenuItem Header="PDF全体の画像を分析・最適化...(_O)"
                          Command="{Binding OptimizeDocumentImagesCommand}"
                          ToolTip="全ページを走査して容量削減候補、概算サイズ、空白全面画像を一覧表示します"  AutomationProperties.AccessKey="Alt+O"/>
                <Separator />
                <MenuItem Header="ページリンクを設定...(_K)" Click="InternalLinkEdit_OnClick"
                          IsEnabled="{Binding HasSelectedOverlay}" ToolTip="選択領域から別ページへの内部リンクを設定" AutomationProperties.AccessKey="Alt+K" />
                <MenuItem Header="リンク先へ移動(_G)" Click="InternalLinkNavigate_OnClick"
