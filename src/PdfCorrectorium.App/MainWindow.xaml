                            Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="読み上げパネルを開く"
                            AutomationProperties.Name="読み上げ">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <icons:ActionIcon Key="ReadAloud" Width="24" Height="24" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="読み上げ" />
                        </StackPanel>
                    </Button>
                </ToolBar>
                <ToolBar x:Name="PageLayoutToolBar" Band="1" BandIndex="0" Padding="0,2" Background="Transparent">
                    <TextBlock x:Name="PageToolbarTitle" Text="ページ表示" VerticalAlignment="Center" Margin="3,0,8,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <Button kb:ToolbarItem.Key="page.previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="前のページ">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Fill="Transparent" Stroke="{DynamicResource BodyTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.PreviousPage}" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="前へ" />
                        </StackPanel>
                    </Button>
                    <!-- Smoke tests and accessibility automation continue to read the full summary from this element. -->
                    <TextBlock x:Name="ToolbarPageSummary" Text="{Binding PageSummary}" Visibility="Collapsed" />
                    <StackPanel kb:ToolbarItem.Key="page.number" x:Name="ToolbarPageNumberPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0">
                        <TextBox x:Name="ToolbarPageNumberBox"
                                 IsEnabled="{Binding HasDocument}"
                                 Width="48"
                                 MinHeight="25"
                                 Padding="4,1"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SelectedPage.PageNumber, Mode=OneWay}"
