                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SelectedOverlay.Left, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" PreviewKeyDown="NumericTextBox_OnPreviewKeyDown" LostKeyboardFocus="NumericTextBox_OnLostKeyboardFocus" PreviewMouseWheel="NumericTextBox_OnPreviewMouseWheel" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SelectedOverlay.Top, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" PreviewKeyDown="NumericTextBox_OnPreviewKeyDown" LostKeyboardFocus="NumericTextBox_OnLostKeyboardFocus" PreviewMouseWheel="NumericTextBox_OnPreviewMouseWheel" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="幅" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="高さ" Margin="0,8,0,0" />
                                <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding SelectedOverlay.Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" PreviewKeyDown="NumericTextBox_OnPreviewKeyDown" LostKeyboardFocus="NumericTextBox_OnLostKeyboardFocus" PreviewMouseWheel="NumericTextBox_OnPreviewMouseWheel" />
                                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding SelectedOverlay.Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" PreviewKeyDown="NumericTextBox_OnPreviewKeyDown" LostKeyboardFocus="NumericTextBox_OnLostKeyboardFocus" PreviewMouseWheel="NumericTextBox_OnPreviewMouseWheel" />
                            </Grid>
                            <TextBlock Text="回転角度（度）" Margin="0,10,0,0" />
                            <TextBox IsEnabled="{Binding IsSelectedGeometryEditable}" Text="{Binding SelectedOverlay.RotationDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" PreviewKeyDown="NumericTextBox_OnPreviewKeyDown" LostKeyboardFocus="NumericTextBox_OnLostKeyboardFocus" PreviewMouseWheel="NumericTextBox_OnPreviewMouseWheel" />
                            <TextBlock Text="数値欄は ↑/↓ またはマウスホイールで1、Ctrl併用で0.1、Shift併用で10ずつ変更できます。"
                                   Foreground="#667085" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding ShowPropertyHelpText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ToolBarTray IsLocked="True" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <ToolBar x:Name="RotationPresetToolBar" Band="0" BandIndex="0">
                                <Button Tag="-90" Click="RotatePresetButton_OnClick" Style="{StaticResource PropertyIconButtonStyle}" ToolTip="左へ90度回転" AutomationProperties.Name="左へ90度回転">
                                    <Viewbox>
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.RotateLeft}" />
                                    </Viewbox>
                                </Button>
                                <Button Tag="0" Click="RotatePresetButton_OnClick" Style="{StaticResource PropertyIconButtonStyle}" ToolTip="回転角度を0度へ戻す" AutomationProperties.Name="回転角度を0度へ戻す">
                                    <Viewbox>
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.RotationReset}" />
                                    </Viewbox>
                                </Button>
                                <Button Tag="90" Click="RotatePresetButton_OnClick" Style="{StaticResource PropertyIconButtonStyle}" ToolTip="右へ90度回転" AutomationProperties.Name="右へ90度回転">
                                    <Viewbox>
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.RotateRight}" />
                                    </Viewbox>
                                </Button>
                                </ToolBar>
                            </ToolBarTray>
                            <TextBlock Text="枠内をドラッグすると移動できます。四隅または上下左右のハンドルをドラッグするとサイズを変更できます。編集内容はプロジェクトファイルへ保存されます。" TextWrapping="Wrap" Foreground="#667085" Margin="0,10,0,0"
                                   Visibility="{Binding ShowPropertyHelpText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Separator Margin="0,16" />
                        </StackPanel>
                        <TextBlock Text="文字枠を選択すると編集項目が表示されます。文書情報は［ファイル］→［文書のプロパティ］で確認できます。" TextWrapping="Wrap" Foreground="#667085"
                               Visibility="{Binding ShowPropertyHelpText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
        <Border Panel.ZIndex="1000"
                Background="#990F1720"
                Visibility="{Binding IsPdfExporting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- 日本語の文末だけが次行へ送られないよう、本文の有効幅を確保します。 -->
            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="PDFを生成・検証しています"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="編集中の変更を保護するため、完了するまでこの画面の操作を一時停止しています。出力先PDFをほかのアプリで開かずにお待ちください。"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#475569"
                               Margin="0,12,0,16" />
                    <ProgressBar Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BackgroundOperationProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsBackgroundOperationIndeterminate, Mode=OneWay}" />
                    <TextBlock Text="{Binding BackgroundOperationMessage}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#475569"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
