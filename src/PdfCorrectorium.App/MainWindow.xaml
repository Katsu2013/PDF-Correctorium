                                <Label Grid.Row="0" Grid.Column="2" Content="Y(_Y)" Padding="0" Target="{Binding ElementName=KeyboardY}" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SelectedOverlay.Left, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" PreviewKeyDown="NumericTextBox_OnPreviewKeyDown" LostKeyboardFocus="NumericTextBox_OnLostKeyboardFocus" PreviewMouseWheel="NumericTextBox_OnPreviewMouseWheel"  x:Name="KeyboardX" AutomationProperties.AccessKey="Alt+X"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SelectedOverlay.Top, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" PreviewKeyDown="NumericTextBox_OnPreviewKeyDown" LostKeyboardFocus="NumericTextBox_OnLostKeyboardFocus" PreviewMouseWheel="NumericTextBox_OnPreviewMouseWheel"  x:Name="KeyboardY" AutomationProperties.AccessKey="Alt+Y"/>
                                <Label Grid.Row="2" Grid.Column="0" Content="幅(_W)" Margin="0,8,0,0" Padding="0" Target="{Binding ElementName=KeyboardWidth}" />
                                <Label Grid.Row="2" Grid.Column="2" Content="高さ(_G)" Margin="0,8,0,0" Padding="0" Target="{Binding ElementName=KeyboardHeight}" />
                                <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding SelectedOverlay.Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" PreviewKeyDown="NumericTextBox_OnPreviewKeyDown" LostKeyboardFocus="NumericTextBox_OnLostKeyboardFocus" PreviewMouseWheel="NumericTextBox_OnPreviewMouseWheel"  x:Name="KeyboardWidth" AutomationProperties.AccessKey="Alt+W"/>
                                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding SelectedOverlay.Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" PreviewKeyDown="NumericTextBox_OnPreviewKeyDown" LostKeyboardFocus="NumericTextBox_OnLostKeyboardFocus" PreviewMouseWheel="NumericTextBox_OnPreviewMouseWheel"  x:Name="KeyboardHeight" AutomationProperties.AccessKey="Alt+G"/>
                            </Grid>
                            <Label Content="回転角度（度）(_R)" Margin="0,10,0,0"  Padding="0" Target="{Binding ElementName=KeyboardField5}" />
                            <TextBox IsEnabled="{Binding IsSelectedGeometryEditable}" Text="{Binding SelectedOverlay.RotationDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" PreviewKeyDown="NumericTextBox_OnPreviewKeyDown" LostKeyboardFocus="NumericTextBox_OnLostKeyboardFocus" PreviewMouseWheel="NumericTextBox_OnPreviewMouseWheel"  x:Name="KeyboardField5" AutomationProperties.AccessKey="Alt+R"/>
                            <TextBlock Text="数値欄は ↑/↓ またはマウスホイールで1、Ctrl併用で0.1、Shift併用で10ずつ変更できます。"
                                   Foreground="#667085" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding ShowPropertyHelpText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ToolBarTray IsLocked="True" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <ToolBar x:Name="RotationPresetToolBar" Band="0" BandIndex="0" IsEnabled="{Binding IsSelectedGeometryEditable}">
                                <Button Tag="-90" Click="RotatePresetButton_OnClick" Style="{StaticResource PropertyIconButtonStyle}" ToolTip="左へ90度回転" AutomationProperties.Name="左へ90度回転">
                                    <Viewbox>
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.RotateLeft}" />
                                    </Viewbox>
                                </Button>
                                <Button Tag="0" Click="RotatePresetButton_OnClick" Style="{StaticResource PropertyIconButtonStyle}" ToolTip="回転角度を0度へ戻す" AutomationProperties.Name="回転角度を0度へ戻す">
                                    <Viewbox>
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.RotationReset}" />
                                    </Viewbox>
                                </Button>
                                <Button Tag="90" Click="RotatePresetButton_OnClick" Style="{StaticResource PropertyIconButtonStyle}" ToolTip="右へ90度回転" AutomationProperties.Name="右へ90度回転">
                                    <Viewbox>
                                        <Path Fill="Transparent" Stroke="#263746" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeometry.RotateRight}" />
                                    </Viewbox>
                                </Button>
                                </ToolBar>
                            </ToolBarTray>
                            <TextBlock Text="枠内をドラッグすると移動できます。四隅または上下左右のハンドルをドラッグするとサイズを変更できます。編集内容はプロジェクトファイルへ保存されます。" TextWrapping="Wrap" Foreground="#667085" Margin="0,10,0,0"
                                   Visibility="{Binding ShowPropertyHelpText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Separator Margin="0,16" />
                        </StackPanel>
                        <Border Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,4,0,0"
                                Visibility="{Binding ShowOcrSelectionHint, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="OCR領域を選択するとプロパティを編集できます"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </DockPanel>

        <!-- === ファイル Backstage: QATを残し、通常のリボン／作業領域を全面的に置き換える === -->
        <Border x:Name="BackstageView" Panel.ZIndex="900" Visibility="Collapsed"
                Background="#F8FAFC" KeyboardNavigation.TabNavigation="Cycle"
                AutomationProperties.Name="ファイル">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BackstageBackButton" DockPanel.Dock="Left" Click="BackstageBackButton_OnClick"
                                Style="{StaticResource ModernButtonStyle}" Height="32" Margin="8,6" Padding="12,2"
                                ToolTip="文書画面へ戻る (Esc)" AutomationProperties.Name="文書画面へ戻る">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="←" FontSize="18" Margin="0,-2,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="戻る" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="ファイル" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" Margin="10,0" />
                        <TextBlock DockPanel.Dock="Right" Text="Escで文書画面へ戻ります" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="286" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#D7DEE6" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="BackstagePrimaryCommands" Margin="18,18,18,24">
                                <TextBlock Text="開く" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="14,0,0,5" />
                                <Button Command="{Binding OpenPdfCommand}" Click="BackstageCommand_OnClick" Style="{StaticResource BackstageNavButtonStyle}"
                                        ToolTip="PDFを開く (Ctrl+O)" AutomationProperties.Name="PDFを開く">
                                    <TextBlock Text="PDFを開く" />
                                </Button>
                                <Button Command="{Binding OpenProjectCommand}" Click="BackstageCommand_OnClick" Style="{StaticResource BackstageNavButtonStyle}"
                                        ToolTip="PDF Correctoriumのプロジェクトを開く" AutomationProperties.Name="プロジェクトを開く">
                                    <TextBlock Text="プロジェクトを開く" />
                                </Button>
                                <Button Command="{Binding ImportOcrDataCommand}" Click="BackstageCommand_OnClick" Style="{StaticResource BackstageNavButtonStyle}"
                                        ToolTip="NDLOCR-Liteデータを読み込む" AutomationProperties.Name="OCRデータを読み込む">
                                    <TextBlock Text="OCRデータを読み込む" />
                                </Button>

                                <Separator Margin="6,10" />
                                <TextBlock Text="保存と出力" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="14,0,0,5" />
                                <Button Command="{Binding SaveProjectCommand}" Click="BackstageCommand_OnClick" Style="{StaticResource BackstageNavButtonStyle}"
                                        ToolTip="プロジェクトを上書き保存 (Ctrl+S)" AutomationProperties.Name="プロジェクトを上書き保存">
                                    <TextBlock Text="上書き保存" />
                                </Button>
                                <Button Command="{Binding SaveProjectAsCommand}" Click="BackstageCommand_OnClick" Style="{StaticResource BackstageNavButtonStyle}"
                                        ToolTip="プロジェクトを別名で保存 (Ctrl+Shift+S)" AutomationProperties.Name="プロジェクトを別名で保存">
                                    <TextBlock Text="名前を付けて保存" />
                                </Button>
                                <Button Command="{Binding ExportPdfCommand}" Click="BackstageCommand_OnClick" Style="{StaticResource BackstageNavButtonStyle}"
                                        ToolTip="編集済みPDFを別名で出力" AutomationProperties.Name="編集済みPDFを別名で出力">
                                    <TextBlock Text="PDF出力" />
                                </Button>

                                <Separator Margin="6,10" />
                                <TextBlock Text="管理" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="14,0,0,5" />
                                <Button IsEnabled="{Binding HasDocument}" Click="BackstageDocumentProperties_OnClick" Style="{StaticResource BackstageNavButtonStyle}"
                                        ToolTip="文書のプロパティを表示・編集" AutomationProperties.Name="文書のプロパティ">
                                    <TextBlock Text="文書のプロパティ" />
                                </Button>
                                <Button Click="BackstageApplicationSettings_OnClick" Style="{StaticResource BackstageNavButtonStyle}"
                                        ToolTip="アプリケーション設定を開く" AutomationProperties.Name="設定">
                                    <TextBlock Text="設定" />
                                </Button>
                                <Button Click="BackstageAbout_OnClick" Style="{StaticResource BackstageNavButtonStyle}"
                                        ToolTip="バージョン情報を表示" AutomationProperties.Name="バージョン情報">
                                    <TextBlock Text="バージョン情報" />
                                </Button>
                                <Button Command="{Binding ExitCommand}" Click="BackstageCommand_OnClick" Style="{StaticResource BackstageNavButtonStyle}"
                                        ToolTip="PDF Correctoriumを終了" AutomationProperties.Name="終了">
                                    <TextBlock Text="終了" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1" Margin="34,26,34,30" MaxWidth="980" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="最近開いたファイル" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Grid.Row="1" Text="PDFまたはプロジェクトを選ぶと、現在の編集状態を確認してから開きます。"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,18" />
                        <Grid Grid.Row="2">
                            <TextBlock Text="最近開いたファイルはありません。" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentFiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="BackstageRecentFilesList" ItemsSource="{Binding RecentFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding OpenCommand}" Click="BackstageCommand_OnClick"
                                                    Style="{StaticResource BackstageRecentButtonStyle}"
                                                    ToolTip="{Binding FullPath}" AutomationProperties.Name="{Binding FullPath}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FullPath}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
        <Border Panel.ZIndex="1000"
                Background="#990F1720"
                Visibility="{Binding IsPdfExporting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- 日本語の文末だけが次行へ送られないよう、本文の有効幅を確保します。 -->
            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="PDFを生成・検証しています"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="編集中の変更を保護するため、完了するまでこの画面の操作を一時停止しています。出力先PDFをほかのアプリで開かずにお待ちください。"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#475569"
                               Margin="0,12,0,16" />
                    <ProgressBar Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BackgroundOperationProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsBackgroundOperationIndeterminate, Mode=OneWay}" />
                    <TextBlock Text="{Binding BackgroundOperationMessage}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#475569"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
