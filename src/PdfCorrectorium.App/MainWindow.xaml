                <MenuItem Header="リンク移動を進める(_F)" Click="InternalLinkForward_OnClick"
                          IsEnabled="{Binding CanNavigateInternalLinkForward}" AutomationProperties.AccessKey="Alt+F" />
                <MenuItem Header="ページリンクを削除(_E)" Click="InternalLinkDelete_OnClick"
