                                                      IsHitTestVisible="{Binding CanHitLinkAreas}" ItemTemplate="{StaticResource LinkOverlayTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" /><Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style></ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                        <Canvas IsHitTestVisible="False" Panel.ZIndex="90">
                                            <Border x:Name="MarqueeSelectionRectangle"
                                                    Visibility="Collapsed"
                                                    Background="#28D32F2F"
                                                    BorderBrush="#FFD32F2F"
                                                    BorderThickness="1" />
                                            <Canvas x:Name="TextRedactionMarkerPreviewCanvas"
                                                    Visibility="Collapsed" />
                                            <Polygon x:Name="RedactionPathPreview" Visibility="Collapsed"
                                                     Fill="#40D32F2F" Stroke="#FFD32F2F" StrokeThickness="2" />
                                        </Canvas>
                                        <!-- 墨消し指定は編集時だけ半透明で表示し、PDF出力時は指定色で確定する。 -->
                                        <ItemsControl x:Name="RedactionOverlayLayer" ItemsSource="{Binding RedactionItems}"
                                                      IsHitTestVisible="{Binding IsRedactionMode}" Panel.ZIndex="80">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="{Binding Width}" Height="{Binding Height}" ClipToBounds="False"
                                                          PreviewMouseLeftButtonDown="RedactionOverlay_OnPreviewMouseLeftButtonDown"
                                                          ToolTip="ドラッグで移動し、周囲のハンドルでサイズを変更します。">
                                                        <Border x:Name="RedactionPreviewBorder"
                                                                Background="{Binding ColorHex}"
                                                                Opacity="{Binding DataContext.RedactionPreviewOpacity, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderBrush="#FFFF3B30" BorderThickness="2" />
                                                        <Path x:Name="RedactionPreviewPath" Data="{Binding ShapeGeometry}" Stretch="Fill"
                                                              Fill="{Binding ColorHex}"
                                                              Opacity="{Binding DataContext.RedactionPreviewOpacity, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              Stroke="#FFFF3B30" StrokeThickness="2" Visibility="Collapsed" />
                                                        <Thumb x:Name="MoveHandle" Tag="Move" Cursor="SizeAll" Background="Transparent" Margin="5"
                                                               DragStarted="RedactionThumb_OnDragStarted"
                                                               DragDelta="RedactionThumb_OnDragDelta"
                                                               DragCompleted="RedactionThumb_OnDragCompleted"
                                                               AutomationProperties.Name="墨消し範囲を移動">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="Transparent" />
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                        <Thumb x:Name="NorthHandle" Tag="N" Width="18" Height="8" Cursor="SizeNS" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="NorthEastHandle" Tag="NE" Width="10" Height="10" Cursor="SizeNESW" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="EastHandle" Tag="E" Width="8" Height="18" Cursor="SizeWE" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="SouthEastHandle" Tag="SE" Width="10" Height="10" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="SouthHandle" Tag="S" Width="18" Height="8" Cursor="SizeNS" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="SouthWestHandle" Tag="SW" Width="10" Height="10" Cursor="SizeNESW" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="WestHandle" Tag="W" Width="8" Height="18" Cursor="SizeWE" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                        <Thumb x:Name="NorthWestHandle" Tag="NW" Width="10" Height="10" Cursor="SizeNWSE" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Visibility="Collapsed" DragStarted="RedactionThumb_OnDragStarted" DragDelta="RedactionThumb_OnDragDelta" DragCompleted="RedactionThumb_OnDragCompleted" />
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsPath}" Value="True">
                                                            <Setter TargetName="RedactionPreviewBorder" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="RedactionPreviewPath" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTextSelection}" Value="True">
                                                            <Setter TargetName="RedactionPreviewBorder" Property="CornerRadius" Value="3" />
                                                            <Setter TargetName="RedactionPreviewBorder" Property="BorderThickness" Value="1" />
                                                            <Setter TargetName="MoveHandle" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="RedactionPreviewBorder" Property="BorderBrush" Value="{DynamicResource InputBrush}" />
                                                            <Setter TargetName="RedactionPreviewBorder" Property="BorderThickness" Value="2.5" />
                                                            <Setter TargetName="RedactionPreviewPath" Property="Stroke" Value="{DynamicResource OnAccentBrush}" />
                                                            <Setter TargetName="RedactionPreviewPath" Property="StrokeThickness" Value="2.5" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                <Condition Binding="{Binding IsTextSelection}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="NorthHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="NorthEastHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="EastHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="SouthEastHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="SouthHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="SouthWestHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="WestHandle" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="NorthWestHandle" Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Reading-order badges live in their own foreground layer so region
                                             borders and resize handles can never cover the sequence number. -->
                                        <ItemsControl x:Name="ReadingOrderBadgeLayer"
                                                      ItemsSource="{Binding OverlayItems}"
                                                      IsHitTestVisible="False"
                                                      Panel.ZIndex="100">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOcrOverlayVisible}" Value="True" />
                                                                <Condition Binding="{Binding IsReadingOrderMode}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ReadingOrderBadge"
                                                            Background="#FF006A6A"
                                                            BorderBrush="{DynamicResource InputBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="11"
                                                            Margin="-10,-10,0,0"
                                                            MinWidth="22"
                                                            Height="22"
                                                            Padding="4,0"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding DataContext.InverseZoomFactor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            ScaleY="{Binding DataContext.InverseZoomFactor, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </Border.RenderTransform>
                                                        <TextBlock Text="{Binding ReadingOrder}"
                                                                   Foreground="{DynamicResource OnAccentBrush}"
                                                                   FontWeight="Bold"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                    <Border x:Name="NextPreviewPageHost" Background="White" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1"
                                            Margin="6" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Visibility="{Binding HasNextPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Tag="{Binding NextPreviewPageNumber}"
                                            MouseLeftButtonUp="AdjacentPreviewPage_OnMouseLeftButtonUp"
                                            ToolTip="クリックしてこのページを編集">
                                        <Grid Width="{Binding NextPreviewPixelWidth}" Height="{Binding NextPreviewPixelHeight}">
                                            <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}" /></Grid.LayoutTransform>
                                            <Image Source="{Binding NextPreviewImage}" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border Background="#CC263746" CornerRadius="3" Padding="7,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding NextPreviewPageNumber, StringFormat={}{0} ページ}" Foreground="{DynamicResource OnAccentBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                                    <!-- 連続表示では全ページ分の軽量な枠をここへ並べる。
                                         画像は表示範囲周辺だけを遅延生成し、現在ページだけ
                                         PreviewPageHost を差し込んで編集機能を維持する。 -->
                                    <ocr:ContinuousPagePanel x:Name="ContinuousDocumentLayoutHost"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top"
                                                             Visibility="Collapsed" />
                                </Grid>
                            </ScrollViewer>
                            <Border Width="620" Height="700" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/PdfCorrectorium;component/Resources/Branding/PdfCorrectorium-128.png"
                                           Width="88" Height="88" Stretch="Uniform" Margin="0,0,0,22" />
                                    <TextBlock Text="{Binding DocumentTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding DocumentDescription}" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="20,12,20,0" TextWrapping="Wrap" MaxWidth="500" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                                        <Button icons:ActionIcon.Key="OpenPdf" Content="PDFを開く" Command="{Binding OpenPdfCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="180" />
                                        <Button icons:ActionIcon.Key="OpenProject" Content="プロジェクトを開く" Command="{Binding OpenProjectCommand}" MinWidth="180" Margin="10,3,3,3" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#99000000">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="220" Height="8" />
                                    <TextBlock Text="PDFプレビューを描画しています..." Foreground="{DynamicResource OnAccentBrush}" FontSize="16" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
            <GridSplitter x:Name="PropertiesDockSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

            <Border x:Name="PropertiesDockPane" Grid.Column="4" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                <TextBlock x:Name="DocumentLoadingErrorNotice" DockPanel.Dock="Top" Text="{Binding DocumentLoadingSummary}" TextWrapping="Wrap" Margin="8"
                           Visibility="{Binding NeedsDocumentLoadingNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
