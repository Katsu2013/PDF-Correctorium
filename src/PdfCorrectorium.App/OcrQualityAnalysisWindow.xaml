<Window xmlns:icons="clr-namespace:PdfCorrectorium.App.Resources" x:Class="PdfCorrectorium.App.OcrQualityAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR品質の異常候補"
        Width="1040" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:kb="clr-namespace:PdfCorrectorium.App.Services" KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="AnalysisTabs">
            <TabItem Header="文字数の外れ値(_N)" AutomationProperties.AccessKey="Alt+N">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                        <Label Content="行の太さ許容差（%）(_T)" VerticalAlignment="Center"  Padding="0" Target="{Binding ElementName=SizeToleranceTextBox}" />
                        <TextBox x:Name="SizeToleranceTextBox" Text="15" Width="52" Margin="6,0,10,0" AutomationProperties.AccessKey="Alt+T"/>
                        <Label Content="最低比較件数(_M)" VerticalAlignment="Center"  Padding="0" Target="{Binding ElementName=MinimumPeerCountTextBox}" />
                        <TextBox x:Name="MinimumPeerCountTextBox" Text="4" Width="45" Margin="6,0,10,0" AutomationProperties.AccessKey="Alt+M"/>
                        <Label Content="密度比の閾値(_C)" VerticalAlignment="Center"  Padding="0" Target="{Binding ElementName=CountRatioTextBox}" />
                        <TextBox x:Name="CountRatioTextBox" Text="1.6" Width="52" Margin="6,0,10,0" AutomationProperties.AccessKey="Alt+C"/>
<Button icons:ActionIcon.Key="Analysis" x:Name="AnalyzeCountButton" Content="文書全体を分析(_A)" MinWidth="120" Padding="8,3"
                                Click="AnalyzeCountButton_OnClick" AutomationProperties.AccessKey="Alt+A"/>
                        <CheckBox x:Name="ShowLockedCountCheckBox" Content="固定済みの領域も表示(_F)" Margin="14,0,0,0" VerticalAlignment="Center"
                                  AutomationProperties.AccessKey="Alt+F" IsChecked="False"
                                  Checked="ShowLockedCountCheckBox_OnChanged" Unchecked="ShowLockedCountCheckBox_OnChanged" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Margin="0,0,0,8" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Text="CJK・欧文・半角カナ等の字幅を補正し、枠の縦横比に対する文字密度を比較します。目安文字数はこの行の文字種構成による推定です。" />
                    <DataGrid x:Name="CountResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              kb:ListDetails.EnableColumnMenu="True"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                              MouseDoubleClick="CountResultsGrid_OnMouseDoubleClick" kb:KeyboardAccess.Key="L" AutomationProperties.Name="分析結果">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ページ" Binding="{Binding PageNumber}" Width="62" />
                            <DataGridTextColumn Header="判定" Binding="{Binding FindingDisplay}" Width="140" />
                            <DataGridTextColumn Header="OCR文字列" Binding="{Binding Text}" Width="*" MinWidth="200" />
                            <DataGridTextColumn Header="文字数" Binding="{Binding CharacterCount}" Width="66" />
                            <DataGridTextColumn Header="目安文字数" Binding="{Binding ExpectedCharacterCount, StringFormat=0.0}" Width="82" />
                            <DataGridTextColumn Header="密度比" kb:ListDetails.IsDetail="True" Visibility="Collapsed" SortMemberPath="DensityRatio" Binding="{Binding DensityRatio, StringFormat=0.00}" Width="68" />
                            <DataGridTextColumn Header="比較件数" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding PeerCount}" Width="70" />
                            <DataGridTextColumn Header="幅" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding Width, StringFormat=0.0}" Width="68" />
                            <DataGridTextColumn Header="高さ" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding Height, StringFormat=0.0}" Width="68" />
                            <DataGridTextColumn Header="方向" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding DirectionDisplay}" Width="70" />
                            <DataGridTextColumn Header="固定" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding LockDisplay}" Width="68" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="3" Margin="0,9,0,0">
                        <Button icons:ActionIcon.Key="NextPage" Content="選択箇所へ移動(_G)" MinWidth="120" Padding="8,3" DockPanel.Dock="Right"
                                Click="NavigateCountButton_OnClick" AutomationProperties.AccessKey="Alt+G"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CountStatusTextBlock" Text="まだ分析していません。" />
                            <ProgressBar x:Name="CountProgressBar" Height="7" Width="320" Margin="0,5,0,0"
                                         Minimum="0" Maximum="100" HorizontalAlignment="Left" Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="キーワード幅の補正(_K)" AutomationProperties.AccessKey="Alt+K">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Content="キーワード(_W)" VerticalAlignment="Center"  Padding="0" Target="{Binding ElementName=KeywordTextBox}" />
                        <TextBox x:Name="KeywordTextBox" Grid.Column="1" Margin="8,0" MinHeight="27"
                                 VerticalContentAlignment="Center" AutomationProperties.AccessKey="Alt+W"/>
<Button icons:ActionIcon.Key="Analysis" x:Name="AnalyzeKeywordButton" Grid.Column="2" Content="文書全体を分析(_A)"
                                MinWidth="120" Padding="8,3" Click="AnalyzeKeywordButton_OnClick" AutomationProperties.AccessKey="Alt+A"/>
                    </Grid>
                    <WrapPanel Grid.Row="1" Margin="0,9,0,7">
                        <CheckBox x:Name="MatchCaseCheckBox" Content="大文字と小文字を区別(_M)" Margin="0,0,18,0"  AutomationProperties.AccessKey="Alt+M"/>
                        <Label Content="許容差（%）(_T)" VerticalAlignment="Center"  Padding="0" Target="{Binding ElementName=KeywordToleranceTextBox}" />
                        <TextBox x:Name="KeywordToleranceTextBox" Text="20" Width="52" Margin="6,0,10,0" AutomationProperties.AccessKey="Alt+T"/>
                        <Label Content="最低出現件数(_I)" VerticalAlignment="Center"  Padding="0" Target="{Binding ElementName=MinimumReferenceCountTextBox}" />
                        <TextBox x:Name="MinimumReferenceCountTextBox" Text="3" Width="45" Margin="7,0,0,0" AutomationProperties.AccessKey="Alt+I"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="2" Margin="0,0,0,8" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="同じ語の出現幅を行の高さ（縦書きは行の幅）で正規化し、中央値から外れた箇所を補正候補にします。固定済みの行・文字は変更しません。" />
                    <DataGrid x:Name="KeywordResultsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                              kb:ListDetails.EnableColumnMenu="True"
                              SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                              MouseDoubleClick="KeywordResultsGrid_OnMouseDoubleClick" kb:KeyboardAccess.Key="L" AutomationProperties.Name="分析結果">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ページ" Binding="{Binding PageNumber}" Width="68" />
                            <DataGridTextColumn Header="OCR文字列" Binding="{Binding Text}" Width="*" MinWidth="200" />
                            <DataGridTextColumn Header="差（%）" Binding="{Binding DeviationPercent, StringFormat=0.0}" Width="70" />
                            <DataGridTextColumn Header="固定" Binding="{Binding LockDisplay}" Width="62" />
                            <DataGridTextColumn Header="現在幅" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding CurrentSpan, StringFormat=0.0}" Width="75" />
                            <DataGridTextColumn Header="基準幅" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding ReferenceSpan, StringFormat=0.0}" Width="75" />
                            <DataGridTextColumn Header="方向" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding DirectionDisplay}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="4" Margin="0,9,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button icons:ActionIcon.Key="NextPage" Content="選択箇所へ移動(_G)" MinWidth="120" Padding="8,3" Margin="0,0,7,0"
                                    Click="NavigateKeywordButton_OnClick" AutomationProperties.AccessKey="Alt+G"/>
                            <Button icons:ActionIcon.Key="OcrEdit" x:Name="CorrectSelectedKeywordButton" Content="選択候補を補正(_S)" MinWidth="120" Padding="8,3" Margin="0,0,7,0"
                                    IsEnabled="{Binding CanEditGeometry}"
                                    Click="CorrectSelectedKeywordButton_OnClick" AutomationProperties.AccessKey="Alt+S"/>
                            <Button icons:ActionIcon.Key="OcrEdit" x:Name="CorrectAllKeywordButton" Content="全候補を補正(_F)" MinWidth="112" Padding="8,3"
                                    IsEnabled="{Binding CanEditGeometry}"
                                    Click="CorrectAllKeywordButton_OnClick" AutomationProperties.AccessKey="Alt+F"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="KeywordStatusTextBlock" Text="キーワードを入力してください。" />
                            <ProgressBar x:Name="KeywordProgressBar" Height="7" Width="320" Margin="0,5,0,0"
                                         Minimum="0" Maximum="100" HorizontalAlignment="Left" Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="類似語・誤認識候補(_R)" AutomationProperties.AccessKey="Alt+R">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <Label Content="基準語の最低件数(_M)" Target="{Binding ElementName=WordReferenceCountTextBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="WordReferenceCountTextBox" Text="3" Width="45" Margin="6,0,10,0" />
                        <Label Content="出現頻度比(_T)" Target="{Binding ElementName=WordFrequencyRatioTextBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="WordFrequencyRatioTextBox" Text="5" Width="45" Margin="6,0,10,0" />
                        <Label Content="疑わしい語の最大件数(_C)" Target="{Binding ElementName=WordSuspectCountTextBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="WordSuspectCountTextBox" Text="3" Width="45" Margin="6,0,10,0" />
                        <Button icons:ActionIcon.Key="Analysis" x:Name="AnalyzeWordsButton" Content="文書全体を分析(_A)" Padding="8,3"
                                Click="AnalyzeWordsButton_OnClick" />
                    </WrapPanel>
                    <TextBlock x:Name="WordsDescriptionTextBlock" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="文書全体の英数字の技術用語を比較し、誤認識の可能性がある語を探します。候補は誤りの断定ではありません。原画像と照合して選択した候補だけ修正してください。" />
                    <Expander Grid.Row="2" Header="資料のOCR辞書（プロジェクトに保存）" Margin="0,0,0,8">
                        <StackPanel>
                            <Label Content="1行に1語、または空白区切り(_W)" Target="{Binding ElementName=KnownWordsTextBox}" />
                            <TextBox x:Name="KnownWordsTextBox" AcceptsReturn="True" Height="65" MaxLength="65536"
                                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="正しい用語" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="資料のOCR辞書...(_D)" icons:ActionIcon.Key="Analysis" Click="Dictionary_OnClick" Margin="0,0,8,0"/>
                                <CheckBox x:Name="RegisterCorrectedWord" Content="修正時に正解語を登録" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox x:Name="RegisterCorrectionRule" Content="修正時に誤り→正解を登録" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                    <DataGrid x:Name="WordResultsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                              kb:ListDetails.EnableColumnMenu="True"
                              CanUserSortColumns="True"
                              SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                              MouseDoubleClick="WordResultsGrid_OnMouseDoubleClick" kb:KeyboardAccess.Key="L" AutomationProperties.Name="類似語の分析結果">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ページ" Binding="{Binding PageNumber}" Width="60" />
                            <DataGridTemplateColumn Header="現在の語" Width="140" SortMemberPath="Word" ClipboardContentBinding="{Binding Word}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock kb:WordDifference.Original="{Binding Word}" kb:WordDifference.Suggested="{Binding SuggestedWord}"
                                                   AutomationProperties.Name="{Binding Word}" ToolTip="{Binding Word}" FontSize="16" TextTrimming="CharacterEllipsis" Margin="2,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="修正候補" Width="140" SortMemberPath="SuggestedWord" ClipboardContentBinding="{Binding SuggestedWord}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock kb:WordDifference.Original="{Binding Word}" kb:WordDifference.Suggested="{Binding SuggestedWord}"
                                                   kb:WordDifference.ShowSuggested="True" AutomationProperties.Name="{Binding SuggestedWord}"
                                                   ToolTip="{Binding SuggestedWord}" FontSize="16" TextTrimming="CharacterEllipsis" Margin="2,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="注意" Binding="{Binding Attention}" Width="140">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="ToolTip" Value="{Binding Reason}" />
                                </Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="前後の文章" Binding="{Binding Context}" Width="*" MinWidth="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="出現数" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding WordCount}" Width="90" />
                            <DataGridTextColumn Header="基準語数" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding ReferenceCount}" Width="105" />
                            <DataGridTextColumn Header="理由・注意" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding Reason}" Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,9,0,0">
                        <Button icons:ActionIcon.Key="NextPage" x:Name="NavigateWordButton" Content="選択箇所へ移動(_G)" Padding="8,3" Margin="0,0,7,0" Click="NavigateWordButton_OnClick" />
                        <Button x:Name="IgnoreWordButton" Content="選択語を無視(_I)" Padding="8,3" Margin="0,0,7,0" Click="IgnoreWordButton_OnClick" />
                        <Button x:Name="ResetIgnoredWordsButton" Content="無視を解除(_U)" Padding="8,3" Margin="0,0,7,0" Click="ResetIgnoredWordsButton_OnClick" />
                        <Button icons:ActionIcon.Key="OcrEdit" x:Name="CorrectWordsButton" Content="選択候補だけ修正(_S)" Padding="8,3" Click="CorrectWordsButton_OnClick" />
                    </WrapPanel>
                    <StackPanel Grid.Row="5" Margin="0,9,0,0">
                        <TextBlock x:Name="WordsStatusTextBlock" Text="まだ分析していません。" TextWrapping="Wrap" />
                        <ProgressBar x:Name="WordsProgressBar" Height="7" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel x:Name="DialogFooter" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelAnalysisButton" Content="キャンセル" Width="96" Margin="0,0,8,0" Padding="8,3"
                    Visibility="Collapsed" Click="CancelAnalysisButton_OnClick" />
            <Button Content="閉じる" Width="90" Padding="8,3"
                    IsCancel="True" Click="CloseButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
