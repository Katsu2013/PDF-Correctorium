<Window x:Class="PdfCorrectorium.App.InputPdfIssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入力PDFの注意事項" Width="680" Height="470" MinWidth="540" MinHeight="360"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="入力PDFの特性" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="編集・出力時に確認したい特性を表示しています。警告があっても元PDFは変更されません。"
                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="閉じる" IsCancel="True" HorizontalAlignment="Right" MinWidth="104" Margin="0,12,0,0" />
        <ListBox ItemsSource="{Binding}" BorderThickness="1" Padding="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding SeverityText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource SecondaryTextBrush}" DockPanel.Dock="Right" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Code}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
