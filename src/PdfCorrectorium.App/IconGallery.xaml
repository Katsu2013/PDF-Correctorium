                <Border Style="{StaticResource GalleryTileStyle}"><StackPanel><Viewbox Style="{StaticResource GalleryIconViewboxStyle}"><Path Style="{StaticResource GalleryIconPathStyle}" Data="{StaticResource IconGeometry.RestoreCharacterAdvances}" /></Viewbox><TextBlock Style="{StaticResource GalleryTitleStyle}" Text="文字送りを戻す" /><TextBlock Style="{StaticResource GalleryKeyStyle}" Text="IconGeometry.RestoreCharacterAdvances" /></StackPanel></Border>
