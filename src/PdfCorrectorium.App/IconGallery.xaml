                <Border Style="{StaticResource GalleryTileStyle}"><StackPanel><icons:ActionIcon Key="EqualHeight" Width="72" Height="72" HorizontalAlignment="Center" Foreground="{DynamicResource BodyTextBrush}" /><TextBlock Style="{StaticResource GalleryTitleStyle}" Text="同じ高さ" /><TextBlock Style="{StaticResource GalleryKeyStyle}" Text="IconGeometry.EqualHeight" /></StackPanel></Border>
                <Border Style="{StaticResource GalleryTileStyle}"><StackPanel><Viewbox Style="{StaticResource GalleryIconViewboxStyle}"><Path Style="{StaticResource GalleryIconPathStyle}" Data="{StaticResource IconGeometry.EqualSize}" /></Viewbox><TextBlock Style="{StaticResource GalleryTitleStyle}" Text="同じサイズ" /><TextBlock Style="{StaticResource GalleryKeyStyle}" Text="IconGeometry.EqualSize" /></StackPanel></Border>

                <!-- 読み順 -->
                <Border Style="{StaticResource GalleryTileStyle}"><StackPanel><Viewbox Style="{StaticResource GalleryIconViewboxStyle}"><Path Style="{StaticResource GalleryIconPathStyle}" Data="{StaticResource IconGeometry.ReadingEarlier}" /></Viewbox><TextBlock Style="{StaticResource GalleryTitleStyle}" Text="読み順を前へ" /><TextBlock Style="{StaticResource GalleryKeyStyle}" Text="IconGeometry.ReadingEarlier" /></StackPanel></Border>
