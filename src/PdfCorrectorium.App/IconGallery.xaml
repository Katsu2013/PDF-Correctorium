                <Border Style="{StaticResource GalleryTileStyle}"><StackPanel><Viewbox Style="{StaticResource GalleryIconViewboxStyle}"><Path Style="{StaticResource GalleryIconPathStyle}" Data="{StaticResource IconGeometry.AlignTop}" /></Viewbox><TextBlock Style="{StaticResource GalleryTitleStyle}" Text="上揃え" /><TextBlock Style="{StaticResource GalleryKeyStyle}" Text="IconGeometry.AlignTop" /></StackPanel></Border>
                <Border Style="{StaticResource GalleryTileStyle}"><StackPanel><Viewbox Style="{StaticResource GalleryIconViewboxStyle}"><Path Style="{StaticResource GalleryIconPathStyle}" Data="{StaticResource IconGeometry.AlignBottom}" /></Viewbox><TextBlock Style="{StaticResource GalleryTitleStyle}" Text="下揃え" /><TextBlock Style="{StaticResource GalleryKeyStyle}" Text="IconGeometry.AlignBottom" /></StackPanel></Border>
