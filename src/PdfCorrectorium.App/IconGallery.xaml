                <Border Style="{StaticResource GalleryTileStyle}"><StackPanel><Viewbox Style="{StaticResource GalleryIconViewboxStyle}"><Path Style="{StaticResource GalleryIconPathStyle}" Data="{StaticResource IconGeometry.AlignVerticalCenter}" /></Viewbox><TextBlock Style="{StaticResource GalleryTitleStyle}" Text="上下中央揃え" /><TextBlock Style="{StaticResource GalleryKeyStyle}" Text="IconGeometry.AlignVerticalCenter" /></StackPanel></Border>
