<Window x:Class="PdfCorrectorium.App.PageTextDecorationsWindow"
        x:Name="WindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ページ番号・ヘッダー／フッター・文字透かし" Width="850" Height="720"
        MinWidth="720" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16" Background="White" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="設定はプロジェクトに保存され、編集画面でプレビューし、PDF出力時に文字として埋め込みます。{page} はページ番号、{total} は総ページ数です。"
                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="DecorationsList" DisplayMemberPath="DisplayName"
                         SelectionChanged="DecorationsList_OnSelectionChanged"
                         AutomationProperties.Name="ページ装飾一覧" />
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,8,0,0">
                    <Button Content="ページ番号を追加" Click="AddPageNumber_OnClick" Margin="0,0,3,3"/>
                    <Button Content="ヘッダーを追加" Click="AddHeader_OnClick" Margin="3,0,0,3"/>
                    <Button Content="フッターを追加" Click="AddFooter_OnClick" Margin="0,3,3,0"/>
                    <Button Content="文字透かしを追加" Click="AddWatermark_OnClick" Margin="3,3,0,0"/>
                </UniformGrid>
                <Button Grid.Row="2" Content="選択項目を削除" Click="Remove_OnClick" Margin="0,8,0,0" />
            </Grid>
            <Grid Grid.Column="2">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Grid DataContext="{Binding ElementName=DecorationsList, Path=SelectedItem}" Margin="0,0,4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="種類(_K)" Target="{Binding ElementName=KindBox}" />
                    <ComboBox x:Name="KindBox" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ElementName=WindowRoot, Path=KindOptions}"
                              SelectedValuePath="Value" DisplayMemberPath="Name" SelectedValue="{Binding Kind, Mode=TwoWay}" />
                    <Label Grid.Row="1" Content="表示する文字(_T)" Target="{Binding ElementName=TextBox}" />
                    <TextBox x:Name="TextBox" Grid.Row="1" Grid.Column="1" Text="{Binding TextTemplate, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="2" Content="奇数ページの位置(_P)" Target="{Binding ElementName=PositionBox}" />
                    <ComboBox x:Name="PositionBox" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ElementName=WindowRoot, Path=PositionOptions}"
                              SelectedValuePath="Value" DisplayMemberPath="Name" SelectedValue="{Binding Position, Mode=TwoWay}" />
                    <Label Grid.Row="3" Content="偶数ページの位置(_D)" Target="{Binding ElementName=EvenPositionBox}" />
                    <ComboBox x:Name="EvenPositionBox" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ElementName=WindowRoot, Path=EvenPositionOptions}"
                              SelectedValuePath="Value" DisplayMemberPath="Name" SelectedValue="{Binding EvenPagePosition, Mode=TwoWay}" />
                    <Label Grid.Row="4" Content="開始ページ(_S)" Target="{Binding ElementName=FirstPageBox}" />
                    <TextBox x:Name="FirstPageBox" Grid.Row="4" Grid.Column="1" Text="{Binding FirstPageText, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="5" Content="終了ページ(_E)" Target="{Binding ElementName=LastPageBox}" />
                    <TextBox x:Name="LastPageBox" Grid.Row="5" Grid.Column="1" Text="{Binding LastPageText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="空欄なら文書の末尾まで" />
                    <Label Grid.Row="6" Content="ページ番号の補正(_N)" Target="{Binding ElementName=OffsetBox}" />
                    <TextBox x:Name="OffsetBox" Grid.Row="6" Grid.Column="1" Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="例えば表紙を除いて2ページ目を1と表示する場合は -1" />
                    <Button Grid.Row="7" Grid.ColumnSpan="2" Content="表紙を除き、2ページ目から1で始める(_B)" Click="SkipCover_OnClick" Margin="4,6,0,6" />
                    <Label Grid.Row="8" Content="文字サイズ（pt）(_Z)" Target="{Binding ElementName=FontSizeBox}" />
                    <TextBox x:Name="FontSizeBox" Grid.Row="8" Grid.Column="1" Text="{Binding FontSizeText, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="9" Content="文字色（#RRGGBB）(_C)" Target="{Binding ElementName=ColorBox}" />
                    <TextBox x:Name="ColorBox" Grid.Row="9" Grid.Column="1" Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="0,9,0,0">
                        <DockPanel>
                            <Label Content="不透明度（%）(_O)" Width="160" Target="{Binding ElementName=OpacityTextBox}" />
                            <TextBox x:Name="OpacityTextBox" Text="{Binding OpacityText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel>
                            <Label Content="端からの余白（pt）(_M)" Width="160" Target="{Binding ElementName=MarginBox}" />
                            <TextBox x:Name="MarginBox" Text="{Binding MarginText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <CheckBox Content="この設定を表示する(_V)" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="4,10,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
              <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="配置プレビュー（奇数・偶数の例。編集画面にも適用後に表示）" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,5" />
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,5,0">
                    <TextBlock x:Name="OddPreviewLabel" Text="奇数ページ" Margin="0,0,0,3" />
                    <Border BorderBrush="#AAB5C2" BorderThickness="1" Background="#F1F3F5" Padding="5">
                      <Canvas x:Name="OddPreviewCanvas" Width="160" Height="190" Background="White" ClipToBounds="True">
                        <TextBlock x:Name="OddPreviewText" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="145" />
                      </Canvas>
                    </Border>
                  </StackPanel>
                  <StackPanel Margin="5,0,0,0">
                    <TextBlock x:Name="EvenPreviewLabel" Text="偶数ページ" Margin="0,0,0,3" />
                    <Border BorderBrush="#AAB5C2" BorderThickness="1" Background="#F1F3F5" Padding="5">
                      <Canvas x:Name="EvenPreviewCanvas" Width="160" Height="190" Background="White" ClipToBounds="True">
                        <TextBlock x:Name="EvenPreviewText" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="145" />
                      </Canvas>
                    </Border>
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" IsCancel="True" MinWidth="104" />
            <Button Content="適用" IsDefault="True" MinWidth="104" Margin="8,0,0,0" Click="Apply_OnClick" />
        </StackPanel>
    </Grid>
</Window>
