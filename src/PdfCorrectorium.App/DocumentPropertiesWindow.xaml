<Window x:Class="PdfCorrectorium.App.DocumentPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文書のプロパティ"
        Width="900" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" xmlns:kb="clr-namespace:PdfCorrectorium.App.Services" KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>
        <Style x:Key="KeyboardPropertyLabelStyle" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>
        <Style x:Key="PropertyValueStyle" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
        <Style x:Key="EditablePropertyValueStyle" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FFABADB3" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
        <Style x:Key="SectionGroupStyle" TargetType="GroupBox" BasedOn="{StaticResource ModernGroupBoxStyle}">
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="LoadingPanel" Background="#FFF4CE" BorderBrush="#D6B656"
                BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="120" Height="6" IsIndeterminate="True" Margin="0,0,12,0" />
                <TextBlock x:Name="LoadingStatusText" Text="PDF文書の情報を読み込んでいます..."
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="概要(_D)" AutomationProperties.AccessKey="Alt+D">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <GroupBox Header="概要" Style="{StaticResource SectionGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ファイル:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding PdfProperties.FileName, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <Label Grid.Row="1" Content="タイトル:(_T)" Style="{StaticResource KeyboardPropertyLabelStyle}"  Padding="0" Target="{Binding ElementName=TitleTextBox}" />
                                <TextBox x:Name="TitleTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource EditablePropertyValueStyle}" AutomationProperties.AccessKey="Alt+T"/>
                                <Label Grid.Row="2" Content="作成者:(_U)" Style="{StaticResource KeyboardPropertyLabelStyle}"  Padding="0" Target="{Binding ElementName=AuthorTextBox}" />
                                <TextBox x:Name="AuthorTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource EditablePropertyValueStyle}" AutomationProperties.AccessKey="Alt+U"/>
                                <Label Grid.Row="3" Content="件名:(_B)" Style="{StaticResource KeyboardPropertyLabelStyle}"  Padding="0" Target="{Binding ElementName=SubjectTextBox}" />
                                <TextBox x:Name="SubjectTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource EditablePropertyValueStyle}" AutomationProperties.AccessKey="Alt+B"/>
                                <Label Grid.Row="4" Content="キーワード:(_K)" Style="{StaticResource KeyboardPropertyLabelStyle}"  Padding="0" Target="{Binding ElementName=KeywordsTextBox}" />
                                <TextBox x:Name="KeywordsTextBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource EditablePropertyValueStyle}" AutomationProperties.AccessKey="Alt+K"/>
                                <TextBlock Grid.Row="5" Text="作成日:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PdfProperties.CreationDateText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="6" Text="更新日:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PdfProperties.ModifiedDateText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <Label Grid.Row="7" Content="アプリケーション:(_R)" Style="{StaticResource KeyboardPropertyLabelStyle}"  Padding="0" Target="{Binding ElementName=CreatorTextBox}" />
                                <TextBox x:Name="CreatorTextBox" Grid.Row="7" Grid.Column="1" Style="{StaticResource EditablePropertyValueStyle}" AutomationProperties.AccessKey="Alt+R"/>
                                <Label Grid.Row="8" Content="PDF変換:(_P)" Style="{StaticResource KeyboardPropertyLabelStyle}"  Padding="0" Target="{Binding ElementName=ProducerTextBox}" />
                                <TextBox x:Name="ProducerTextBox" Grid.Row="8" Grid.Column="1" Style="{StaticResource EditablePropertyValueStyle}" AutomationProperties.AccessKey="Alt+P"/>
                                <TextBlock Grid.Row="9" Text="読み込み状態:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="9" Grid.Column="1"
                                         Text="{Binding PdfProperties.ErrorMessage, Mode=OneWay}"
                                         Style="{StaticResource PropertyValueStyle}"
                                         TextWrapping="Wrap"  IsTabStop="False"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="詳細情報" Style="{StaticResource SectionGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="元PDFのバージョン:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding PdfProperties.PdfVersionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Column="2" Text="ページ数:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Column="3" Text="{Binding PdfProperties.PageCountText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="1" Text="場所:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                         Text="{Binding PdfProperties.FileLocation, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"
                                         TextWrapping="Wrap"  IsTabStop="False"/>
                                <TextBlock Grid.Row="2" Text="ファイルサイズ:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PdfProperties.FileSizeText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="ページサイズ:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding PdfProperties.PageSizeText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="3" Text="タグ付きPDF:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PdfProperties.TaggedPdfText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Web表示用に最適化:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding PdfProperties.FastWebViewText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                            </Grid>
                        </GroupBox>

                        <Expander Header="PDF Correctorium プロジェクト情報(_I)" Margin="8" IsExpanded="False" AutomationProperties.AccessKey="Alt+I">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="元PDF:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding SourcePdfPath, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}" TextWrapping="Wrap"  IsTabStop="False"/>
                                <TextBlock Grid.Row="1" Text="プロジェクトファイル:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProjectPath, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}" TextWrapping="Wrap"  IsTabStop="False"/>
                                <TextBlock Grid.Row="2" Text="元PDFのSHA-256:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SourceHash, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}" TextWrapping="Wrap"  IsTabStop="False"/>
                                <TextBlock Grid.Row="3" Text="OCRデータソース:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OcrDataSourceText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="4" Text="保存モード:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding StorageModeText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="セキュリティ(_S)" AutomationProperties.AccessKey="Alt+S">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <GroupBox Header="文書のセキュリティ" Style="{StaticResource SectionGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="セキュリティ方法:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding PdfProperties.SecurityMethodText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="1" Text="互換性のあるバージョン:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PdfProperties.CompatibleVersionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="文書に関する制限の概要" Style="{StaticResource SectionGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="印刷:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding PdfProperties.PrintPermissionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="1" Text="文書アセンブリ:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PdfProperties.AssemblyPermissionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="2" Text="内容のコピー:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PdfProperties.CopyPermissionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="3" Text="アクセシビリティのための内容の抽出:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PdfProperties.AccessibilityPermissionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="4" Text="ページの抽出:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PdfProperties.ExtractPermissionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="5" Text="注釈:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PdfProperties.AnnotatePermissionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="6" Text="フォームフィールドの入力:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PdfProperties.FormFillPermissionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="7" Text="署名:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding PdfProperties.SignPermissionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="8" Text="テンプレートページの作成:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding PdfProperties.TemplatePermissionText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="フォント(_F)" AutomationProperties.AccessKey="Alt+F">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="この文書で使用しているフォント" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding PdfProperties.Fonts}" kb:KeyboardAccess.Key="L" AutomationProperties.Name="ListBox" AutomationProperties.AccessKey="Alt+L">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding Name}" IsExpanded="True" Margin="2">
                                    <Grid Margin="20,6,6,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="種類:" Style="{StaticResource PropertyLabelStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TypeText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="エンコーディング:" Style="{StaticResource PropertyLabelStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EncodingText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="実際のフォント:" Style="{StaticResource PropertyLabelStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FamilyName}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Text="埋め込み:" Style="{StaticResource PropertyLabelStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EmbeddedText}" VerticalAlignment="Center" />
                                    </Grid>
                                </Expander>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#667085" TextWrapping="Wrap"
                               Text="PDFに公開されている情報だけを表示します。フォントの構造によっては、実際のフォント名や埋め込み状態を取得できない場合があります。" />
                </Grid>
            </TabItem>

            <TabItem Header="カスタム(_C)" AutomationProperties.AccessKey="Alt+C">
                <Grid Margin="20">
                    <Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="カスタムプロパティ" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#667085"
                                       Text="PDFの任意カスタムプロパティの表示・編集は、現在の版では対応していません。対応していない値を推測して表示せず、PDFの内容を安全に保持します。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="詳細設定(_V)" AutomationProperties.AccessKey="Alt+V">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <GroupBox Header="PDF設定" Style="{StaticResource SectionGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ベースURL:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding PdfProperties.BaseUrl, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="1" Text="検索用インデックスファイル:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PdfProperties.SearchIndexFile, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <TextBlock Grid.Row="2" Text="トラッピング:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PdfProperties.TrappingText, Mode=OneWay}" Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="PDFバージョン" Style="{StaticResource SectionGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="元PDFのバージョン:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding PdfProperties.PdfVersionText, Mode=OneWay}"
                                         Style="{StaticResource PropertyValueStyle}"  IsTabStop="False"/>
                                <Label Grid.Row="1" Content="出力PDFのバージョン:(_O)" Style="{StaticResource KeyboardPropertyLabelStyle}"  Padding="0" Target="{Binding ElementName=OutputPdfVersionComboBox}" />
                                <ComboBox x:Name="OutputPdfVersionComboBox" Grid.Row="1" Grid.Column="1" MinWidth="260" AutomationProperties.AccessKey="Alt+O">
                                    <ComboBoxItem Content="自動（推奨）" Tag="Automatic" />
                                    <ComboBoxItem Content="PDF 1.4（Acrobat 5.x）" Tag="Pdf14" />
                                    <ComboBoxItem Content="PDF 1.5（Acrobat 6.x）" Tag="Pdf15" />
                                    <ComboBoxItem Content="PDF 1.6（Acrobat 7.x）" Tag="Pdf16" />
                                    <ComboBoxItem Content="PDF 1.7（Acrobat 8.x以降）" Tag="Pdf17" />
                                    <ComboBoxItem Content="PDF 2.0" Tag="Pdf20" />
                                </ComboBox>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                           Foreground="#667085" TextWrapping="Wrap"
                                           Text="元PDFより低いバージョンは選択できません。PDF 1.4では、1.5以降専用のオブジェクトストリームを使用せずに出力します。" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="PDFを開いたときの表示" Style="{StaticResource SectionGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Content="ページレイアウト:(_P)" Style="{StaticResource KeyboardPropertyLabelStyle}"  Padding="0" Target="{Binding ElementName=PageModeComboBox}" />
                                <ComboBox x:Name="PageModeComboBox" Grid.Column="1" MinWidth="230" AutomationProperties.AccessKey="Alt+P">
                                    <ComboBoxItem Content="1ページ" Tag="SinglePage" />
                                    <ComboBoxItem Content="連続ページ" Tag="Continuous" />
                                    <ComboBoxItem Content="見開き" Tag="FacingPages" />
                                </ComboBox>
                                <Label Grid.Row="1" Content="綴じ方向:(_B)" Style="{StaticResource KeyboardPropertyLabelStyle}"  Padding="0" Target="{Binding ElementName=BindingDirectionComboBox}" />
                                <ComboBox x:Name="BindingDirectionComboBox" Grid.Row="1" Grid.Column="1" MinWidth="300" AutomationProperties.AccessKey="Alt+B">
                                    <ComboBoxItem Content="左綴じ（右開き・左から右）" Tag="LeftToRight" />
                                    <ComboBoxItem Content="右綴じ（左開き・右から左）" Tag="RightToLeft" />
                                </ComboBox>
                                <CheckBox x:Name="ShowCoverSeparatelyCheckBox" Grid.Row="2" Grid.Column="1"
 Content="見開き時に1ページ目を表紙として単独表示する(_H)" Margin="0,8,0,0" AutomationProperties.AccessKey="Alt+H"/>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                           Foreground="#667085" TextWrapping="Wrap"
                                           Text="右開きは左綴じ（/L2R）、左開きは右綴じ（/R2L）です。PDFの言語設定は綴じ方向を変更しません。この値はビューアへの初期表示指定であり、ビューア側の設定が優先される場合があります。" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="印刷ダイアログプリセット" Style="{StaticResource SectionGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ページの拡大／縮小:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="既定" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="両面印刷モード:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBlock Grid.Column="3" Text="既定" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="部数:" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="既定" VerticalAlignment="Center" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="読み上げオプション" Style="{StaticResource SectionGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Content="文書の言語:(_L)" Style="{StaticResource KeyboardPropertyLabelStyle}"  Padding="0" Target="{Binding ElementName=DocumentLanguageComboBox}" />
                                <ComboBox x:Name="DocumentLanguageComboBox" Grid.Column="1" MinWidth="260"
                                          IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.AccessKey="Alt+L">
                                    <ComboBoxItem Content="ja-JP" />
                                    <ComboBoxItem Content="en-US" />
                                    <ComboBoxItem Content="zh-CN" />
                                    <ComboBoxItem Content="zh-TW" />
                                    <ComboBoxItem Content="ko-KR" />
                                    <ComboBoxItem Content="de-DE" />
                                    <ComboBoxItem Content="fr-FR" />
                                    <ComboBoxItem Content="es-ES" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                           Foreground="#667085" TextWrapping="Wrap"
                                           Text="PDFカタログの言語タグ（/Lang）へ反映します。候補から選ぶか、BCP 47形式（例: ja-JP、en-US）で入力してください。空欄にすると既存の指定を削除します。" />
                            </Grid>
