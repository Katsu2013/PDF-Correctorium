<Window x:Class="PdfCorrectorium.App.RepeatedRegionCandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="反映候補の確認" Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="反映するページを確認してください" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0" Foreground="#52606D" TextWrapping="Wrap"
                       Text="一覧で候補を選ぶと、右側に実際のページ画像と反映対象の位置を表示します。チェックした候補だけを変更し、固定済みの領域は対象外にします。" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="すべて選択" Margin="0,3,6,3" Click="SelectAll_OnClick" />
            <Button Content="すべて解除" Margin="0,3,18,3" Click="ClearAll_OnClick" />
            <Button Content="キャンセル" IsCancel="True" Width="100" Margin="0,3,8,3" />
            <Button Content="選択した候補へ反映" IsDefault="True" MinWidth="160"
                    Click="ApplyButton_OnClick" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="430" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="CandidateGrid" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      SelectionChanged="CandidateGrid_OnSelectionChanged"
                      MouseDoubleClick="CandidateGrid_OnMouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="反映" Binding="{Binding IsSelected, Mode=TwoWay}" Width="58" />
                    <DataGridTextColumn Header="ページ" Binding="{Binding PageDisplay}" IsReadOnly="True" Width="86" />
                    <DataGridTextColumn Header="一致度" Binding="{Binding SimilarityDisplay}" IsReadOnly="True" Width="72" />
                    <DataGridTextColumn Header="現在の文字列" Binding="{Binding TargetText}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="位置" Binding="{Binding PositionDisplay}" IsReadOnly="True" Width="190" />
                    <DataGridTextColumn Header="状態" Binding="{Binding StatusDisplay}" IsReadOnly="True" Width="130" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" BorderBrush="#C9D3DC" BorderThickness="1" CornerRadius="5" Background="#F7F9FB" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="候補ページのプレビュー" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="CandidateDetailsText" Margin="0,3,0,0" Foreground="#52606D" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="前の候補" ToolTip="前の候補" Click="PreviousCandidate_OnClick" />
                            <Button Content="次の候補" ToolTip="次の候補" Click="NextCandidate_OnClick" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="BeforePreviewButton" Content="変更前" IsChecked="True"
                                          MinWidth="70" Click="BeforePreviewButton_OnClick" />
                            <ToggleButton x:Name="AfterPreviewButton" Content="変更後" Margin="4,0,0,0"
                                          MinWidth="70" Click="AfterPreviewButton_OnClick" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="−" Width="30" Height="28" Padding="0" ToolTip="縮小"
                                    Click="ZoomOutButton_OnClick" />
                            <Slider x:Name="PreviewZoomSlider" Width="100" Margin="5,0"
                                    Minimum="25" Maximum="400" Value="100" TickFrequency="25"
                                    IsSnapToTickEnabled="False" ValueChanged="PreviewZoomSlider_OnValueChanged" />
                            <Button Content="＋" Width="30" Height="28" Padding="0" ToolTip="拡大"
                                    Click="ZoomInButton_OnClick" />
                            <TextBlock x:Name="PreviewZoomText" Width="48" Margin="6,0,0,0"
                                       Text="100%" TextAlignment="Right" VerticalAlignment="Center" />
                            <Button Content="全体" Margin="5,0,0,0" Padding="8,3" ToolTip="ページ全体を表示"
                                    Click="FitPreviewButton_OnClick" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="#B8C4CE" BorderThickness="1" Background="#3E4854" ClipToBounds="True">
                        <Grid>
                            <ScrollViewer x:Name="CandidatePreviewScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="CandidatePreviewScrollViewer_OnPreviewMouseWheel"
                                          SizeChanged="CandidatePreviewScrollViewer_OnSizeChanged">
                                <Grid x:Name="CandidatePreviewZoomHost"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox x:Name="CandidatePreviewViewbox" Stretch="Uniform">
                                        <Grid x:Name="CandidatePreviewPage" Background="White">
                                            <Image x:Name="CandidatePreviewImage" Stretch="Fill" />
                                            <Canvas x:Name="CandidateOverlayCanvas" IsHitTestVisible="False" />
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </ScrollViewer>
                            <TextBlock x:Name="CandidatePreviewPlaceholder"
                                       Text="候補を選択するとページ画像を表示します。"
                                       Foreground="White" Background="#B03E4854" Padding="12,8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="このページをメイン画面で確認して閉じる"
                                HorizontalAlignment="Stretch" Click="OpenCandidateInMainWindow_OnClick" />
                        <TextBlock Margin="2,3,2,0" Foreground="#687783" FontSize="11" TextWrapping="Wrap"
                                   Text="反映元の選択を保つため、メイン画面で確認する場合はこの候補画面を閉じます。確認後、必要に応じて一括反映をもう一度開いてください。" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
