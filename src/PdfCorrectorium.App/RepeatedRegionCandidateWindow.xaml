<Window xmlns:icons="clr-namespace:PdfCorrectorium.App.Resources" x:Class="PdfCorrectorium.App.RepeatedRegionCandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="反映候補の確認" Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" xmlns:kb="clr-namespace:PdfCorrectorium.App.Services" KeyboardNavigation.TabNavigation="Cycle">
    <DockPanel Margin="16" KeyboardNavigation.TabNavigation="Local">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0">
            <TextBlock Text="反映するページを確認してください" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                       Text="一覧で候補を選ぶと、右側に実際のページ画像と反映対象の位置を表示します。チェックした候補だけを変更し、固定済みの領域は対象外にします。" />
        </StackPanel>

        <StackPanel x:Name="DialogFooter" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" KeyboardNavigation.TabIndex="9000" KeyboardNavigation.TabNavigation="Local">
            <Button Content="すべて選択(_A)" Margin="0,3,6,3" Click="SelectAll_OnClick"  AutomationProperties.AccessKey="Alt+A"/>
            <Button Content="すべて解除(_D)" Margin="0,3,18,3" Click="ClearAll_OnClick" AutomationProperties.AccessKey="Alt+D"/>
            <Button Content="キャンセル" IsCancel="True" Width="100" Margin="0,3,8,3" />
            <Button Content="選択した候補へ反映(_R)" IsDefault="True" MinWidth="160"
                    Click="ApplyButton_OnClick" AutomationProperties.AccessKey="Alt+R"/>
        </StackPanel>

<Grid KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="430" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="CandidateGrid" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False"
                      kb:ListDetails.EnableColumnMenu="True"
                      IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      SelectionChanged="CandidateGrid_OnSelectionChanged"
                      MouseDoubleClick="CandidateGrid_OnMouseDoubleClick" kb:KeyboardAccess.Key="L" AutomationProperties.Name="CandidateGrid" AutomationProperties.AccessKey="Alt+L">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="反映" Binding="{Binding IsSelected, Mode=TwoWay}" Width="58" />
                    <DataGridTextColumn Header="ページ" Binding="{Binding PageDisplay}" IsReadOnly="True" Width="86" />
                    <DataGridTextColumn Header="一致度" Binding="{Binding SimilarityDisplay}" IsReadOnly="True" Width="72" />
                    <DataGridTextColumn Header="現在の文字列" Binding="{Binding TargetText}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="状態" Binding="{Binding StatusDisplay}" IsReadOnly="True" Width="130" />
                    <DataGridTextColumn Header="位置" kb:ListDetails.IsDetail="True" Visibility="Collapsed" Binding="{Binding PositionDisplay}" IsReadOnly="True" Width="190" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource PanelBrush}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="候補ページのプレビュー" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="CandidateDetailsText" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="PreviousCandidateButton" icons:ActionIcon.Key="PreviousPage" Style="{StaticResource IconOnlyActionButtonStyle}" Content="前の候補(_P)" ToolTip="前の候補" kb:KeyboardAccess.Key="P" Click="PreviousCandidate_OnClick"/>
                            <Button x:Name="NextCandidateButton" icons:ActionIcon.Key="NextPage" Style="{StaticResource IconOnlyActionButtonStyle}" Content="次の候補(_N)" ToolTip="次の候補" kb:KeyboardAccess.Key="N" Click="NextCandidate_OnClick"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="BeforePreviewButton" Content="変更前" IsChecked="True"
                                          MinWidth="70" Click="BeforePreviewButton_OnClick" />
                            <ToggleButton x:Name="AfterPreviewButton" Content="変更後" Margin="4,0,0,0"
                                          MinWidth="70" Click="AfterPreviewButton_OnClick" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ZoomOutButton" icons:ActionIcon.Key="ZoomOut" Style="{StaticResource IconOnlyActionButtonStyle}" Content="縮小(_O)" ToolTip="縮小"
                                    Click="ZoomOutButton_OnClick" kb:KeyboardAccess.Key="O"/>
                            <Slider x:Name="PreviewZoomSlider" Width="100" Margin="5,0"
                                    Minimum="25" Maximum="400" Value="100" TickFrequency="25"
                                    IsSnapToTickEnabled="False" ValueChanged="PreviewZoomSlider_OnValueChanged" kb:KeyboardAccess.Key="Z" AutomationProperties.Name="PreviewZoomSlider" AutomationProperties.AccessKey="Alt+Z"/>
                            <Button x:Name="ZoomInButton" icons:ActionIcon.Key="ZoomIn" Style="{StaticResource IconOnlyActionButtonStyle}" Content="拡大(_I)" ToolTip="拡大"
                                    Click="ZoomInButton_OnClick" kb:KeyboardAccess.Key="I"/>
                            <TextBlock x:Name="PreviewZoomText" Width="48" Margin="6,0,0,0"
                                       Text="100%" TextAlignment="Right" VerticalAlignment="Center" />
                            <Button x:Name="FitPreviewButton" icons:ActionIcon.Key="FitPage" Style="{StaticResource IconOnlyActionButtonStyle}" Content="全体(_F)" Margin="5,0,0,0" ToolTip="ページ全体を表示"
                                    Click="FitPreviewButton_OnClick" kb:KeyboardAccess.Key="F"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" Background="#3E4854" ClipToBounds="True">
                        <Grid>
                            <ScrollViewer x:Name="CandidatePreviewScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="CandidatePreviewScrollViewer_OnPreviewMouseWheel"
                                          SizeChanged="CandidatePreviewScrollViewer_OnSizeChanged" Focusable="False">
                                <Grid x:Name="CandidatePreviewZoomHost"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox x:Name="CandidatePreviewViewbox" Stretch="Uniform">
                                        <Grid x:Name="CandidatePreviewPage" Background="{DynamicResource InputBrush}">
                                            <Image x:Name="CandidatePreviewImage" Stretch="Fill" />
                                            <Canvas x:Name="CandidateOverlayCanvas" IsHitTestVisible="False" />
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </ScrollViewer>
                            <TextBlock x:Name="CandidatePreviewPlaceholder"
                                       Text="候補を選択するとページ画像を表示します。"
                                       Foreground="{DynamicResource OnAccentBrush}" Background="#B03E4854" Padding="12,8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button icons:ActionIcon.Key="NextPage" Content="このページをメイン画面で確認して閉じる(_G)"
                                HorizontalAlignment="Stretch" Click="OpenCandidateInMainWindow_OnClick" AutomationProperties.AccessKey="Alt+G"/>
                        <TextBlock Margin="2,3,2,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"
                                   Text="反映元の選択を保つため、メイン画面で確認する場合はこの候補画面を閉じます。確認後、必要に応じて一括反映をもう一度開いてください。" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
