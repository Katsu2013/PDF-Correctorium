<Window x:Class="PdfCorrectorium.App.DocumentDataExportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="作業データ・ページ画像の出力" Width="610" Height="560" MinWidth="510" MinHeight="490"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" KeyboardNavigation.TabNavigation="Cycle">
 <DockPanel Margin="16">
  <StackPanel x:Name="DialogFooter" DockPanel.Dock="Bottom" Margin="0,12,0,0" KeyboardNavigation.TabIndex="100">
   <ProgressBar x:Name="WorkProgress" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" />
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBox x:Name="ResultPathBox" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="StopButton" Content="中止(_S)" Click="Stop_OnClick" Visibility="Collapsed" MinWidth="85"/>
    <Button x:Name="CloseButton" Content="閉じる" IsCancel="True" MinWidth="85" Margin="8,0,0,0"/>
    <Button x:Name="ExportButton" Content="書き出す(_E)" Click="Export_OnClick" MinWidth="110" Margin="8,0,0,0"/>
   </StackPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <StackPanel x:Name="ExportInputs">
    <Label Content="出力する内容(_K)" Target="{Binding ElementName=KindBox}" Padding="0" />
    <ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="Options_OnChanged" Margin="0,4,0,12">
     <ComboBoxItem Content="OCR作業文字（TXT）"/>
     <ComboBoxItem Content="コメント一覧（CSV）"/>
     <ComboBoxItem Content="完成ページ画像（PNG／JPEG）"/>
    </ComboBox>
    <Border x:Name="WorkDataWarning" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
     <TextBlock Text="TXT・CSVは校正作業データです。墨消し予定の文字やコメントを含み得ます。墨消し済み成果物ではありません。機密共有には、検証済みの出力PDFまたは完成ページ画像を使用してください。" TextWrapping="Wrap" />
    </Border>
    <TextBlock x:Name="ScopeText" TextWrapping="Wrap" Margin="0,0,0,10" />
    <StackPanel x:Name="PageRangeInputs">
     <Label Content="対象PDFページ(_P)" Target="{Binding ElementName=PagesBox}" Padding="0"/>
     <TextBox x:Name="PagesBox" Margin="0,4,0,12" ToolTip="例：1-3, 8, 10-12。ページは文書順に出力します。"/>
    </StackPanel>
    <CheckBox x:Name="PageHeadings" Content="TXTにPDFページ番号の見出しを入れる(_H)" IsChecked="True" Margin="0,0,0,10"/>
    <StackPanel x:Name="ImageInputs" Visibility="Collapsed">
     <Label Content="画像形式(_F)" Target="{Binding ElementName=ImageFormat}" Padding="0"/>
     <ComboBox x:Name="ImageFormat" SelectedIndex="0" SelectionChanged="Options_OnChanged" Margin="0,4,0,8">
      <ComboBoxItem Content="PNG（可逆圧縮）"/><ComboBoxItem Content="JPEG（写真向け）"/>
     </ComboBox>
     <Label Content="解像度（DPI）(_D)" Target="{Binding ElementName=DpiBox}" Padding="0"/>
     <ComboBox x:Name="DpiBox" SelectedIndex="1" Margin="0,4,0,8">
      <ComboBoxItem Content="72"/><ComboBoxItem Content="150"/><ComboBoxItem Content="300"/>
     </ComboBox>
     <Label Content="JPEG品質（1〜100）(_Q)" Target="{Binding ElementName=QualityBox}" Padding="0"/>
     <TextBox x:Name="QualityBox" Text="90" Margin="0,4,0,0"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
