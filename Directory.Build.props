<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- The only editable application-version inputs. Bump the revision before delivering changed code. -->
    <ApplicationVersionPrefix>1.0.0</ApplicationVersionPrefix>
    <DevelopmentRevision>132</DevelopmentRevision>
    <Version>$(ApplicationVersionPrefix)-dev.$(DevelopmentRevision)</Version>
    <AssemblyVersion>$(ApplicationVersionPrefix).$(DevelopmentRevision)</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
